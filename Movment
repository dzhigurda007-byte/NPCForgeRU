    function redoMove(id,pid){
        if(!playerIsGM(pid))throw new Error('Восстановление передвижения доступно только GM.');
        var tx=root().moves[id];if(!tx)throw new Error('Передвижение не найдено.');if(tx.status!=='undone')throw new Error('Передвижение не отменено.');
        var token=assertLatestPosition(tx,tx.from);
        withSuppressed(token.id,function(){token.set({left:tx.to.left,top:tx.to.top,lastmove:tx.to.lastmove||''});});
        try{if(typeof AD5!=='undefined'&&AD5&&AD5.movement&&typeof AD5.movement.redo==='function')AD5.movement.redo(tx.id,pid);if(typeof AD5Areas!=='undefined'&&AD5Areas&&AD5Areas.movement&&typeof AD5Areas.movement.redo==='function')AD5Areas.movement.redo(tx.id);}catch(e){withSuppressed(token.id,function(){token.set({left:tx.from.left,top:tx.from.top,lastmove:tx.from.lastmove||''});});throw e;}
        tokenState(token).spent=tx.afterSpent;tx.status='applied';
        sendChat(SCRIPT,'/w gm <b>'+esc(tx.name)+'</b>: передвижение восстановлено. [Отменить](!ad5move undo '+tx.id+')',null,{noarchive:true});
    }

    // ---------- Turn / speed ----------
    function resetGroup(page,key){if(!page||!key)return;findObjs({_type:'graphic',_subtype:'token',_pageid:page,layer:'objects'}).forEach(function(t){if(combatToken(t,page)&&groupKey(t)===key)tokenState(t).spent=0;});}
    function parseRows(raw){try{return JSON.parse(raw||'[]')||[];}catch(ignore){return [];}}
    function infoFromRow(row){var page=partyPageId();if(!row||!page)return null;if(row.id&&row.id!=='-1'){var t=getObj('graphic',row.id);if(t&&combatToken(t,page))return {page:page,key:groupKey(t)};}if(row.id==='-1'&&row.custom)return {page:page,key:'npc:'+groupName(row.custom)};return null;}
    function turnChanged(campaign,prev){var after=parseRows(Campaign().get('turnorder')),now=after.length?infoFromRow(after[0]):null;if(!now)return;var last=runtimeLastGroup[now.page]||'';if(!last){runtimeLastGroup[now.page]=now.key;resetGroup(now.page,now.key);return;}if(last===now.key)return;runtimeLastGroup[now.page]=now.key;resetGroup(now.page,now.key);}
    function initializeTurnRuntime(){var info=currentTurnInfo();if(info)runtimeLastGroup[info.page]=info.key;}
    function cleanupDestroyed(token){if(!token)return;var r=root(),s=r.tokens[token.id];if(s&&s.proxyId)removeLegacyProxyById(s.proxyId);delete r.tokens[token.id];delete r.lastByToken[token.id];}

    function command(msg){
        if(msg.type!=='api'||!/^!ad5move(?:\s|$)/i.test(msg.content))return;
        var a=msg.content.trim().split(/\s+/),sub=norm(a[1]||'help');
        try{
            if(sub==='ping'){sendChat(SCRIPT,'/w gm <b>'+SCRIPT+' '+VERSION+'</b> активен. Слушателей маршрута: '+listeners.length+'.');return;}
            if(sub==='undo'){undoMove(a[2],msg.playerid);return;}
            if(sub==='redo'){redoMove(a[2],msg.playerid);return;}
            if(sub==='refresh'){if(!playerIsGM(msg.playerid))throw new Error('Только GM.');var removed=cleanupLegacyDisplays();sendChat(SCRIPT,'/w gm Старые индикаторы скорости удалены: '+removed+'.');return;}
            if(sub==='reset'){if(!playerIsGM(msg.playerid))throw new Error('Только GM.');var info=currentTurnInfo();if(info)resetGroup(info.page,info.key);sendChat(SCRIPT,'/w gm Расход движения текущего хода сброшен.');return;}
            if(sub==='status'||sub==='path'){
                var sel=(msg.selected||[]).filter(function(x){return x._type==='graphic';}).map(function(x){return getObj('graphic',x._id);}).filter(Boolean);if(!sel.length)throw new Error('Выделите токен.');
                sel.forEach(function(t){
                    if(sub==='status'){var si=speedInfo(t),st=tokenState(t);sendChat(SCRIPT,'/w gm <b>'+esc(t.get('name')||t.id)+'</b>: база '+(si.base===null?'—':fmt(si.base))+'; текущая '+(si.effective===null?'—':fmt(si.effective))+'; потрачено '+fmt(st.spent)+'; осталось '+(remainingSpeed(t)===null?'—':fmt(remainingSpeed(t)))+'.');}
                    else {var m=lastMove(t);if(!m){sendChat(SCRIPT,'/w gm <b>'+esc(t.get('name')||t.id)+'</b>: движение ещё не зафиксировано.');return;}sendChat(SCRIPT,'/w gm <b>'+esc(t.get('name')||t.id)+'</b>: '+(m.forced?(m.forcedKind==='pull'?'ТЯГ':'ТОЛЧ'):(m.mode==='waypoints'?'маршрут с waypoint':'прямая ЛКМ'))+' · '+fmt(m.distance)+' фт · сегментов '+m.segments.length+' · '+(m.manual?'ручное':'API/принудительное')+'.');}
                });return;
            }
            sendChat(SCRIPT,'/w gm <b>'+SCRIPT+' '+VERSION+'</b><br><code>!ad5move ping</code> · <code>path</code> · <code>status</code> · <code>undo</code> · <code>redo</code>.<br>ЛКМ без waypoint = прямая; ЛКМ+ПКМ = маршрут через точки.');
        }catch(e){sendChat(SCRIPT,'/w gm <b>'+SCRIPT+'</b>: '+esc(e.message||e));}
    }

    // AD5 Areas remains the primary change:graphic owner so all area boundary
    // effects and Movement Engine share one movement transaction. If Areas is not
    // installed, Movement handles the event itself.
    on('change:graphic',function(token,prev){
        try{
            if(typeof AD5Areas!=='undefined'&&AD5Areas&&versionAtLeast(AD5Areas.version,'2.6'))return;
            var ctx=beginGraphicMove(token,prev);if(ctx)endGraphicMove(ctx);
        }catch(e){sendChat(SCRIPT,'/w gm <b>'+SCRIPT+'</b>: '+esc(e.message||e));}
    });
    on('chat:message',command);
    on('change:campaign:turnorder',turnChanged);
    on('change:campaign:playerpageid',function(){runtimeLastGroup=Object.create(null);initializeTurnRuntime();cleanupLegacyDisplays();});
    on('destroy:graphic',cleanupDestroyed);
    on('ready',function(){root();initializeTurnRuntime();var removed=cleanupLegacyDisplays();sendChat(SCRIPT,'/w gm <b>'+SCRIPT+' '+VERSION+'</b> запущен. Condition Engine учитывается в скорости; перенос схваченных целей и стоимость вставания поддерживаются. ЛКМ = прямой путь; ЛКМ+ПКМ = waypoint-маршрут; СОЛИД блокирует маршрут на первой границе и выталкивает на сетку; ТОЛЧ/ТЯГ = принудительное движение без реакций токенов с выравниванием по сетке; после финальной клетки проверяется падение с местности; переходы AD5 Floors не считаются обычным перемещением; bar3 учитывается как высота при проверке reach.'+(removed?' Удалено старых индикаторов: '+removed+'.':''));});

    return {
        version:VERSION,
        beginGraphicMove:beginGraphicMove,endGraphicMove:endGraphicMove,isSuppressed:isSuppressed,withSuppressed:withSuppressed,refreshToken:refreshToken,
        baseSpeedForToken:baseSpeedForToken,remainingSpeed:remainingSpeed,distanceForPoints:routeDistance,rangeFeet:rangeFeet,heightFeet:heightFeet,
        onMove:onMove,offMove:offMove,lastMove:lastMove,reachCrossings:reachCrossings,distanceAtPoint:distanceAtPoint,forceMove:forceMove,translateForcedMove:translateForcedMove,spendMovement:spendMovement,spendStandCost:spendStandCost,
        _test:{routeFromMove:routeFromMove,parseLastMove:parseLastMove,routeDistance:routeDistance,segmentUnits:segmentUnits,buildSegments:buildSegments,speedInfo:speedInfo,groupKey:groupKey,reachRect:reachRect,pointInRect:pointInRect,segmentRectInterval:segmentRectInterval,reachCrossings:reachCrossings,distanceAtPoint3D:distanceAtPoint3D,heightAwareReachCrossings:heightAwareReachCrossings,rangeFeet:rangeFeet,gridStep:gridStep,snapPointToGrid:snapPointToGrid,gridCandidates:gridCandidates,snapSolidStop:snapSolidStop,snapForcedDestination:snapForcedDestination}
    };
