            c.spec=spec;c.turnsLeft=spec.turns;c.max=spec.max;c.charges=Math.min(c.charges,c.max);c.color=spec.color;c.full=spec.full;c.action=actionName||c.action;linkEffect(c);
            // 1.4.0: СЧЁТПОВТОР — повторное применение той же способности добавляет заряды.
