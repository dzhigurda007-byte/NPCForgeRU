        // Эффекты способности могут записаться позже счётчика в той же транзакции.
        if(!c.link)setTimeout(function(){var live=root().counters[c.id];if(live&&!live.link)linkEffect(live);},0);
        redraw(bearer.id);
        gm('<b>'+esc(c.name)+'</b> → '+esc(tokenName(bearer))+': '+c.charges+'/'+c.max+'.');
        if(c.charges>=c.max)onFull(c);
