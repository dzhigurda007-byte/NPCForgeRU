    }
    function spendBonus(item,c){
        var n=c.charges,f=item.dice?(item.dice*n)+'d'+item.sides:'';
        if(item.bonus)f+=(f?(item.bonus>0?'+':'-'):(item.bonus<0?'-':''))+Math.abs(item.bonus*n);
        return {attack:item.attack*n,damage:f,type:item.type,label:c.name+' ×'+n};
    }
    function onAttack(e){
        var src=String(e&&e.источникТокенId||'');if(!src)return;
        var pr=root().primed,now=Date.now(),action=String(e.имяДействия||''),list=(spent[src]||[]).filter(function(x){return x.until>now;}),changed=false;
        if(pr[src]){pr[src].forEach(function(b){list.push({attack:b.attack,damage:b.damage,type:'',label:b.label,action:action,until:now+SPENT_WINDOW_MS});});delete pr[src];changed=true;}
        spendLines(e.описание).forEach(function(item){
            var c=find(src,item.name,null);if(!c||c.charges<=0)return;
            var b=spendBonus(item,c);list.push({attack:b.attack,damage:b.damage,type:b.type,label:b.label,action:action,until:now+SPENT_WINDOW_MS});changed=true;
            remove(c,'заряды ('+c.charges+') вложены в «'+(action||'атаку')+'»');
