    // ---------------------------------------------------------------- события
    function matches(c,who,e){
        var s=String(e.источникТокенId||''),t=String(e.цельТокенId||'');
        if(who==='bearerTurn')return s===c.bearer;
        if(who==='ownerTurn')return !!c.owner&&s===c.owner;
        if(who==='bearerSource')return s===c.bearer&&t!==c.bearer;
        if(who==='bearerTarget')return t===c.bearer;
        if(who==='ownerOnBearer')return !!c.owner&&s===c.owner&&t===c.bearer;
        return false;
    }
    function onEvent(ev,e){
        var all=root().counters;
        Object.keys(all).forEach(function(id){
            var c=all[id];if(!c)return;
            if(!tok(c.bearer))return;
            if(ev==='НАЧАЛО ХОДА'&&String(e.источникТокенId||'')===c.bearer&&c.turnsLeft){c.turnsLeft--;if(c.turnsLeft<=0){remove(c,'истекла длительность');return;}}
            (c.spec&&c.spec.triggers||[]).forEach(function(tr){
                if(tr.ev!==ev||!matches(c,tr.who,e)||!root().counters[c.id])return;
                setCharges(c,c.charges+tr.n,tr.key);
            });
        });
    }
    // Все заряды «накопления» уходят в следующую атаку носителя. Списание —
    // после текущего события: урон попадания считается по снимку модификаторов.
    // 1.3.0: заряды накопления тратит владелец кнопкой «★ Потратить: Имя» (действие
    // токена носителя): бонус ждёт следующей атаки носителя (root().primed, переживает
    // перезапуск), счётчик сразу исчезает. Атака забирает бонус; все цели этой атаки
    // получают его в течение SPENT_WINDOW_MS.
    function spendName(c){return '★ Потратить: '+c.name;}
    // Кнопка листа общая для всех копий NPC, поэтому команда берёт выделенный токен;
    // кнопка снимается, только когда ни у одной копии нет зарядов этого счётчика.
    function setSpendButton(c,on){
        var bearer=tok(c.bearer),cid=String(c.bearerCid||(bearer&&bearer.get('represents'))||'');if(!cid)return;
        var list=findObjs({_type:'ability',_characterid:cid,name:spendName(c)})||[];
        if(!on){
            var all=root().counters,still=Object.keys(all).some(function(k){var o=all[k];return o&&o!==c&&o.spec&&o.spec.accum&&o.charges>0&&norm(o.name)===norm(c.name)&&String(o.bearerCid||'')===cid;});
            if(!still)list.forEach(function(a){a.remove();});return;
        }
        var action='!ad5counter spend @{selected|token_id} '+c.name;
        if(!list.length)createObj('ability',{characterid:cid,name:spendName(c),action:action,istokenaction:true});
        else if(list[0].get('action')!==action)list[0].set({action:action,istokenaction:true});
    }
    function syncSpendButton(c){if(c&&c.spec&&c.spec.accum)setSpendButton(c,!!root().counters[c.id]&&c.charges>0);}
    function spendCommand(msg,args){
        var c=root().counters[String(args[2]||'')]||find(String(args[2]||''),args.slice(3).join(' '),null);
        if(!c)throw new Error('На выделенном токене нет счётчика «'+args.slice(3).join(' ')+'» — выделите носителя.');
        var bearer=tok(c.bearer),ch=bearer&&getObj('character',String(bearer.get('represents')||''));
        if(!playerIsGM(msg.playerid)&&!(ch&&String(ch.get('controlledby')||'').split(',').some(function(x){x=x.trim();return x===msg.playerid||x==='all';})))throw new Error('Это не ваш токен.');
        if(!c.spec||!c.spec.accum||c.charges<=0)throw new Error('Нет зарядов для траты.');
        var n=c.charges,bonus={attack:c.spec.accum.attack*n,damage:c.spec.accum.damage*n,label:c.name+' ×'+n};
        var pr=root().primed;(pr[c.bearer]||(pr[c.bearer]=[])).push(bonus);
        remove(c,null);
        tellOwners(ch?ch.id:'','<b>'+esc(c.name)+'</b>: потрачено зарядов '+n+' — следующая атака '+esc(tokenName(bearer))+': '+(bonus.attack?'+'+bonus.attack+' к атаке':'')+(bonus.attack&&bonus.damage?', ':'')+(bonus.damage?'+'+bonus.damage+' к урону':'')+'.');
    }
    // 1.4.0: «СЧЁТТРАТА: Печать Завета 2к8 излучение | Белый Клинок 1к6 излучение АТАКА 1»
    // в описании атаки — эта атака забирает все заряды названных счётчиков атакующего:
    // формула урона и бонус атаки умножаются на число зарядов, счётчики исчезают.
    function spendLines(description){
        var text=field(lines(description),'СЧ[ЁЕ]ТТРАТА');if(!text)return [];
        return text.split('|').map(function(part){
            part=part.trim();var atk=0,am=/\s+АТАКА\s*([+-]?\d+)\s*$/i.exec(part);if(am){atk=Number(am[1]);part=part.slice(0,am.index).trim();}
            var m=/^(.*?)\s+(\d*)[кдdk](\d+)(?:\s*([+-])\s*(\d+))?(?:\s+(.+))?$/i.exec(part),flat=m?null:/^(.*?)\s+(\d+)(?:\s+(.+))?$/.exec(part);
            if(m)return {name:m[1].trim(),dice:Number(m[2]||1),sides:Number(m[3]),bonus:m[4]?(m[4]==='-'?-1:1)*Number(m[5]):0,type:(m[6]||'').trim(),attack:atk};
            if(flat)return {name:flat[1].trim(),dice:0,sides:0,bonus:Number(flat[2]),type:(flat[3]||'').trim(),attack:atk};
            return part?{name:part,dice:0,sides:0,bonus:0,type:'',attack:atk}:null;
