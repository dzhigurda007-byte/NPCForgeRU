            else if((m=/^(repeating_npcaction(?:-l)?)_(.+)_name$/i.exec(n)))found='%{'+cid+'|'+m[1]+'_'+m[2]+'_npc_action}';
            else if((m=/^(repeating_spell-(?:cantrip|npc|\d))_(.+)_spellname$/i.exec(n)))found='%{'+cid+'|'+m[1]+'_'+m[2]+'_spell}';
