        if(!macro){tellOwners(cid,'<b>'+esc(c.name)+'</b> заполнен, но способность «'+esc(c.full.ability)+'» не найдена в листе — используйте её из листа.');return;}
        if(!list.length)createObj('ability',{characterid:cid,name:name,action:macro,istokenaction:true});
        else if(list[0].get('action')!==macro)list[0].set({action:macro,istokenaction:true});
    }

    // ---------------------------------------------------------------- логика
    function newId(){var r=root();r.seq++;return 'cnt'+r.seq.toString(36);}
    function find(bearerId,name,ownerCid){
        var want=norm(name);return countersOf(bearerId).filter(function(c){return norm(c.name)===want&&(!ownerCid||c.ownerCid===ownerCid);})[0]||null;
    }
    function attach(spec,bearer,ownerToken,ownerCid,actionName){
        var c=find(bearer.id,spec.name,ownerCid);
        if(c){c.spec=spec;c.turnsLeft=spec.turns;c.max=spec.max;c.color=spec.color;c.full=spec.full;redraw(bearer.id);return c;}
        c={id:newId(),name:spec.name,max:spec.max,charges:spec.start,bearer:bearer.id,owner:ownerToken?ownerToken.id:'',ownerCid:ownerCid||'',
            color:spec.color,full:spec.full,spec:spec,turnsLeft:spec.turns,created:Date.now(),action:actionName||spec.name,filledNotified:false};
        root().counters[c.id]=c;
        redraw(bearer.id);
        gm('<b>'+esc(c.name)+'</b> → '+esc(tokenName(bearer))+': '+c.charges+'/'+c.max+'.');
        if(c.charges>=c.max)onFull(c);
        return c;
    }
    function remove(c,reason){
        if(!c||!root().counters[c.id])return;
        delete root().counters[c.id];delete spent[c.id];
        if(c.full&&c.full.mode==='button')setButton(c,false);
        removeRing(c);redraw(c.bearer);
        if(reason)gm('<b>'+esc(c.name)+'</b> снят с '+esc(tokenName(tok(c.bearer)))+': '+esc(reason)+'.');
    }
    function setCharges(c,n,why){
        var before=c.charges;c.charges=Math.max(0,Math.min(c.max,Math.floor(Number(n)||0)));
        if(c.charges===before)return;
        if(c.charges<c.max){c.filledNotified=false;if(c.full&&c.full.mode==='button')setButton(c,false);}
        redraw(c.bearer);
        if(c.charges>=c.max&&before<c.max)onFull(c,why);
    }
    function onFull(c){
        if(c.filledNotified)return;c.filledNotified=true;
        var bearer=tok(c.bearer),cid=bearer&&String(bearer.get('represents')||''),label='<b>'+esc(c.name)+'</b> заполнен ('+c.max+'/'+c.max+') у '+esc(tokenName(bearer));
        var mode=c.full&&c.full.mode;
        if(mode==='button'){setButton(c,true);tellOwners(cid,label+': доступна кнопка «'+esc(c.full.ability)+'».');}
        else if(mode==='now'){setTimeout(function(){var live=root().counters[c.id];if(live)fire(live,'рамка заполнена');},0);}
        else if(mode==='wait'){var oc=c.ownerCid||cid;tellOwners(oc,label+': можно завершить способностью.');}
        else tellOwners(cid,label+'.');
    }
    // Эффект счётчика: урон и/или состояния; {З} = накопленные заряды.
    function fire(c,why){
        var bearer=tok(c.bearer),spec=c.spec||{},charges=c.charges,owner=tok(c.owner),label=c.action||c.name,out=[];
        if(!bearer){remove(c);return;}
        try{
            if(spec.damage){
                var dm=/^(.*?\d[^\s]*)\s*(.*)$/.exec(spec.damage.trim()),formula=dm?dm[1]:spec.damage,type=(dm&&dm[2]||'силовое поле').trim(),r=rollFormula(formula,charges);
                if(typeof AD5!=='undefined'&&AD5&&AD5.reaction&&typeof AD5.reaction.damage==='function')
                    AD5.reaction.damage(bearer.id,r.total,type,c.name+' — '+why,{sourceTokenId:owner?owner.id:'',actorId:c.ownerCid||String(bearer.get('represents')||''),fixedDamage:true});
                out.push('урон '+r.total+' ('+esc(r.text)+') '+esc(type));
            }
            if(spec.effect&&typeof AD5EffectTurns!=='undefined'&&AD5EffectTurns&&typeof AD5EffectTurns.applyCondition==='function'){
                var text=spec.effect.replace(/\{\s*З(?:АРЯДЫ)?\s*\}/gi,String(charges)).split('+').map(function(x){return x.trim();}).filter(Boolean).join('\n');
                AD5EffectTurns.applyCondition(bearer,text,{sourceToken:owner?owner.id:'',actor:c.ownerCid||'',actionName:label});
                out.push(esc(text.replace(/\n/g,', ')));
            }
        }catch(e){gm('<b>'+esc(c.name)+'</b>: ошибка эффекта — '+esc(e.message||e));}
        gm('<b>'+esc(c.name)+'</b> сработал на '+esc(tokenName(bearer))+' ('+esc(why)+', заряды '+charges+')'+(out.length?': '+out.join('; '):'')+'.');
        if(c.full&&c.full.mode==='now'&&c.full.repeat){c.filledNotified=false;setCharges(c,0);}
        else remove(c);
    }

    // ---------------------------------------------------------------- события
    function matches(c,who,e){
        var s=String(e.источникТокенId||''),t=String(e.цельТокенId||'');
        if(who==='bearerTurn')return s===c.bearer;
        if(who==='ownerTurn')return !!c.owner&&s===c.owner;
        if(who==='bearerSource')return s===c.bearer&&t!==c.bearer;
        if(who==='bearerTarget')return t===c.bearer;
        if(who==='ownerOnBearer')return !!c.owner&&s===c.owner&&t===c.bearer;
        return false;
    }
    function onEvent(ev,e){
        var all=root().counters;
        Object.keys(all).forEach(function(id){
            var c=all[id];if(!c)return;
            if(!tok(c.bearer)){remove(c);return;}
            if(ev==='НАЧАЛО ХОДА'&&String(e.источникТокенId||'')===c.bearer&&c.turnsLeft){c.turnsLeft--;if(c.turnsLeft<=0){remove(c,'истекла длительность');return;}}
            (c.spec&&c.spec.triggers||[]).forEach(function(tr){
                if(tr.ev!==ev||!matches(c,tr.who,e)||!root().counters[c.id])return;
                setCharges(c,c.charges+tr.n,tr.key);
            });
        });
    }
    // Все заряды «накопления» уходят в следующую атаку носителя. Списание —
    // после текущего события: урон попадания считается по снимку модификаторов.
    function onAttack(e){
        var src=String(e&&e.источникТокенId||'');if(!src)return;
        countersOf(src).forEach(function(c){
            if(!c.spec||!c.spec.accum||c.charges<=0)return;
            var n=c.charges;spent[c.id]={charges:n,until:Date.now()+SPENT_WINDOW_MS,bearer:src};
            setTimeout(function(){var live=root().counters[c.id];if(live&&live.charges>=n){setCharges(live,live.charges-n);gm('<b>'+esc(live.name)+'</b>: потрачено зарядов '+n+' на атаку.');}},0);
        });
    }
    function combatModifiers(tokenId){
        var out={attack:0,damage:[]},now=Date.now();
        countersOf(String(tokenId||'')).forEach(function(c){
            if(!c.spec||!c.spec.accum)return;
            var n=c.charges,sp=spent[c.id];
            if(sp&&sp.until>now)n=Math.max(n,sp.charges);
            if(n<=0)return;
            out.attack+=c.spec.accum.attack*n;
            if(c.spec.accum.damage)out.damage.push({formula:String(c.spec.accum.damage*n),sign:1,label:c.name+' ×'+n});
        });
        return out;
    }
    // Использование кнопки «полной рамки» обнуляет счётчик.
    function onChat(msg){
        if(!msg.rolltemplate||!msg.content)return;
        var name=/\{\{(?:rname|name)=([^}]*)\}\}/i.exec(msg.content),charname=/\{\{charname=([^}]*)\}\}/i.exec(msg.content);
        if(!name)return;var n=norm(name[1]);
        Object.keys(root().counters).forEach(function(id){
            var c=root().counters[id];if(!c||c.charges<c.max||!c.full||c.full.mode!=='button'||norm(c.full.ability)!==n)return;
            var bearer=tok(c.bearer),ch=bearer&&getObj('character',String(bearer.get('represents')||''));
            if(!ch||(charname&&norm(charname[1])!==norm(ch.get('name'))))return;
            setCharges(c,0);tellOwners(ch.id,'<b>'+esc(c.name)+'</b>: использовано «'+esc(c.full.ability)+'», рамка обнулена.');
        });
    }

    // ---------------------------------------------------------------- применение
    // Вызывается AutoDamage после применения способности к цели.
    function onApplied(d){
        if(!d||d.разрешено===false)return;
        var spec;try{spec=parseBlock(d.описание);}catch(e){gm('<b>'+esc(d.имя||'Способность')+'</b>: '+esc(e.message));return;}
        if(!spec)return;
        var source=tok(d.источникТокенId),target=tok(d.цельТокенId),ownerCid=String(d.источникПерсонажId||(source&&source.get('represents'))||'');
        if(spec.complete&&target){
            var c=find(target.id,spec.complete,ownerCid)||find(target.id,spec.complete,null);
            if(c)fire(c,'завершено: '+(d.имя||'способность'));
            else gm('<b>'+esc(d.имя||'Способность')+'</b>: на '+esc(tokenName(target))+' нет счётчика «'+esc(spec.complete)+'».');
        }
        if(spec.completeOnly)return;
        var bearer=spec.on==='target'?target:(source||(target&&String(target.get('represents'))===ownerCid?target:null));
        if(!bearer){gm('<b>'+esc(spec.name)+'</b>: не найден токен-носитель.');return;}
        attach(spec,bearer,source,ownerCid,d.имя);
    }
    function sheetDescription(cid,name){
        var want=norm(name),rows=Object.create(null);
        attrs(cid).forEach(function(a){
            var n=String(a.get('name')||''),m=/^(repeating_[^_]+_.+)_(atkname|name|spellname|atk_desc|description|spelldescription)$/i.exec(n);
            if(!m)return;var r=rows[m[1]]||(rows[m[1]]={});
            if(/name$/i.test(m[2]))r.name=a.get('current');else r.desc=a.get('current');
        });
        var hit=Object.keys(rows).map(function(k){return rows[k];}).filter(function(r){return norm(r.name)===want&&r.desc;})[0];
        if(hit)return hit.desc;
        var ab=(findObjs({_type:'ability',_characterid:cid})||[]).filter(function(a){return norm(a.get('name'))===want;})[0];
        return ab?(ab.get('description')||ab.get('action')):null;
    }
    function useCommand(msg,args){
        var source=tok(args[2]),target=args[3]&&args[3]!=='-'?tok(args[3]):null,name=args.slice(4).join(' ');
        if(!source||!name)throw new Error('Формат: !ad5counter use TOKEN_ID TARGET_ID|- Имя способности');
        var cid=String(source.get('represents')||''),c=getObj('character',cid);
        if(!c)throw new Error('Токен без листа.');
        if(!playerIsGM(msg.playerid)&&String(c.get('controlledby')||'').split(',').indexOf(msg.playerid)<0)throw new Error('Это не ваш персонаж.');
        var desc=sheetDescription(cid,name);if(!desc)throw new Error('Способность «'+name+'» не найдена в листе.');
        onApplied({разрешено:true,источникТокенId:source.id,цельТокенId:target?target.id:source.id,источникПерсонажId:cid,имя:name,описание:desc});
    }

    // ---------------------------------------------------------------- команды
    function selected(msg){return (msg.selected||[]).map(function(s){return getObj(s._type,s._id);}).filter(Boolean);}
    function registerImages(msg){
        var sel=selected(msg),urls=null;
        if(sel.length===1&&sel[0].get('sides')){urls=String(sel[0].get('sides')).split('|').map(function(s){try{return libraryUrl(decodeURIComponent(s));}catch(e){return null;}});}
        else if(sel.length>1){urls=sel.filter(function(o){return o.get('_type')==='graphic';}).sort(function(a,b){return Number(a.get('left'))-Number(b.get('left'));}).map(function(o){return libraryUrl(o.get('imgsrc'));});}
        if(!urls||urls.length<2)throw new Error('Выделите многосторонний токен набора или все картинки набора (слева направо: 0…N).');
        if(urls.some(function(u){return !u;}))throw new Error('Картинки должны быть загружены в вашу библиотеку Roll20 (не из маркетплейса).');
        var max=urls.length-1;root().sets[String(max)]=urls;warned[max]=false;
        Object.keys(root().counters).forEach(function(id){var c=root().counters[id];if(c&&c.max===max)redraw(c.bearer);});
        gm('Набор рамок на <b>'+max+'</b> делений сохранён ('+urls.length+' картинок). Выделенные объекты можно удалить.');
    }
    function listText(tokens){
        var rows=[];tokens.forEach(function(t){countersOf(t.id).forEach(function(c){rows.push(esc(tokenName(t))+': <b>'+esc(c.name)+'</b> '+c.charges+'/'+c.max+(c.turnsLeft?' · ходов '+c.turnsLeft:'')+(c.spec&&c.spec.accum?' · +'+(c.spec.accum.attack*c.charges)+' атака, +'+(c.spec.accum.damage*c.charges)+' урон':''));});});
        var sets=Object.keys(root().sets).sort(function(a,b){return a-b;}).join(', ')||'нет';
        return '<b>'+SCRIPT+' '+VERSION+'</b> · наборы рамок: '+esc(sets)+'<br>'+(rows.join('<br>')||'Счётчиков нет.');
    }
    function command(msg){
        var args=String(msg.content||'').trim().split(/\s+/),sub=String(args[1]||'list').toLowerCase();
        if(sub==='use'){useCommand(msg,args);return;}
        if(!playerIsGM(msg.playerid))throw new Error('Команда доступна мастеру.');
        var sel=selected(msg).filter(function(o){return o.get('_type')==='graphic';}),name=args.slice(2).join(' ');
        if(sub==='images'){registerImages(msg);return;}
        if(sub==='list'){var page=Campaign().get('playerpageid');gm(listText(sel.length?sel:(findObjs({_type:'graphic',_pageid:page})||[]).filter(function(t){return countersOf(t.id).length;})));return;}
        if(!sel.length)throw new Error('Выделите токен-носитель.');
        sel.forEach(function(t){
            if(sub==='set'){
                var m=/^(.*?)\s+([+-]?\d+)$/.exec(name);if(!m)throw new Error('Формат: !ad5counter set ИМЯ N | +N | -N');
                var c=find(t.id,m[1]);if(!c)throw new Error('Нет счётчика «'+m[1]+'».');
                setCharges(c,/^[+-]/.test(m[2])?c.charges+Number(m[2]):Number(m[2]),'мастер');
            }else if(sub==='remove'){
                countersOf(t.id).forEach(function(c){if(name.toLowerCase()==='all'||norm(c.name)===norm(name))remove(c,'снят мастером');});
            }else if(sub==='complete'){
                var cc=find(t.id,name);if(!cc)throw new Error('Нет счётчика «'+name+'».');fire(cc,'завершено мастером');
            }else throw new Error('Команды: images, list, set, remove, complete, use.');
        });
    }

    // ---------------------------------------------------------------- рамки и токены
    function graphicChanged(g,prev){
        var idx=ringIndex();
        if(idx[g.id]){
            // Изменения через API событий не порождают: это действие мастера.
            var c=root().counters[idx[g.id]];if(!c)return;
            // Мастер выбрал сторону рамки — заряды = номер стороны.
            var side=Number(g.get('currentSide'));
            if(prev&&Number(prev.currentSide)!==side&&Number.isFinite(side)){setCharges(c,side,'мастер');gm('<b>'+esc(c.name)+'</b>: заряды '+c.charges+'/'+c.max+' (вручную).');}
            redraw(c.bearer);
            return;
        }
        if(!countersOf(g.id).length)return;
        var keys=['left','top','width','height','layer','_pageid'];
        if(!prev||keys.some(function(k){return String(prev[k])!==String(g.get(k));}))redraw(g.id);
    }

    on('ready',function(){
        root();
        Object.keys(root().counters).forEach(function(id){var c=root().counters[id];if(!c||!tok(c.bearer)){if(c)removeRing(c);delete root().counters[id];}});
        var bearers={};Object.keys(root().counters).forEach(function(id){bearers[root().counters[id].bearer]=true;});Object.keys(bearers).forEach(redraw);
        var ev=typeof AD5События!=='undefined'&&AD5События&&typeof AD5События.подписаться==='function';
        if(ev){
            ['НАЧАЛО ХОДА','КОНЕЦ ХОДА','ПОПАДАНИЕ','ПОЛУЧЕН УРОН'].forEach(function(name){AD5События.подписаться(name,function(e){onEvent(name,e||{});});});
            AD5События.подписаться('АТАКА ПО ЦЕЛИ',function(e){onAttack(e||{});});
        }
        on('change:graphic',function(g,prev){try{graphicChanged(g,prev);}catch(e){log(SCRIPT+': '+e.message);}});
        on('destroy:graphic',function(g){
            var idx=ringIndex();
            if(idx[g.id]){var c=root().counters[idx[g.id]];if(c){c.ring=null;remove(c,'рамка удалена');}return;}
            countersOf(g.id).forEach(function(c){remove(c);});
        });
        on('chat:message',function(msg){
            try{
                if(msg.type==='api'){if(/^!ad5counter(?:\s|$)/i.test(msg.content||''))command(msg);return;}
                onChat(msg);
            }catch(e){
                var p=msg.playerid&&!playerIsGM(msg.playerid)&&getObj('player',msg.playerid);
                if(p)sendChat(SCRIPT,'/w "'+String(p.get('_displayname')||'').replace(/["\r\n]/g,'')+'" '+esc(e.message||e),null,{noarchive:true});
                else gm(esc(e.message||e));
            }
        });
        gm('<b>'+SCRIPT+' '+VERSION+'</b> запущен.'+(ev?'':' <b>Нет AD5 События</b> — заряды по событиям не начисляются.')+' Наборы рамок: '+esc(Object.keys(root().sets).join(', ')||'не загружены (!ad5counter images)')+'.');
    });
    return {version:VERSION,onApplied:onApplied,combatModifiers:combatModifiers,tooltipLines:tooltipLines,parse:parseBlock,list:countersOf,
        _test:{rollFormula:rollFormula,onEvent:onEvent,onAttack:onAttack,setCharges:setCharges,fire:fire,libraryUrl:libraryUrl}};
}());

}
