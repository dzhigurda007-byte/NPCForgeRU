    }

    // ---------------------------------------------------------------- рамки
    function libraryUrl(u){
        u=String(u||'').trim();if(!/files\.d20\.io\/images\//.test(u))return null;
        return u.replace(/\/(?:thumb|med|max|original)\.(png|jpe?g|gif|webp)(\?[^|]*)?$/i,'/thumb.$1$2');
    }
    function setFor(max){var s=root().sets[String(max)];return Array.isArray(s)&&s.length===max+1?s:null;}
    function countersOf(bearerId){
        var all=root().counters;return Object.keys(all).map(function(k){return all[k];}).filter(function(c){return c&&c.bearer===bearerId;}).sort(function(a,b){return a.created-b.created;});
    }
    function ringIndex(){var idx=Object.create(null),all=root().counters;Object.keys(all).forEach(function(k){if(all[k]&&all[k].ring)idx[all[k].ring]=k;});return idx;}
    function ringGeometry(bearer,i){
        var base=Math.max(Number(bearer.get('width'))||70,Number(bearer.get('height'))||70),size=Math.round(base*(1.3+0.28*i));
        return {left:Number(bearer.get('left')),top:Number(bearer.get('top')),width:size,height:size,rotation:0,layer:bearer.get('layer')==='objects'?'objects':bearer.get('layer')};
    }
    function removeRing(c){var g=c&&c.ring&&tok(c.ring);if(c)c.ring=null;if(g)g.remove();}
    function drawRing(c,i){
        var bearer=tok(c.bearer);if(!bearer)return;
        var urls=setFor(c.max);
        if(!urls){removeRing(c);if(!warned[c.max]){warned[c.max]=true;gm('Нет набора рамок на '+c.max+' делений: загрузите ring-'+(c.max<10?'0':'')+c.max+' и выполните <code>!ad5counter images</code>. Пока счётчик виден только в подсказке токена.');}return;}
        var geo=ringGeometry(bearer,i),side=Math.max(0,Math.min(c.max,c.charges)),g=c.ring&&tok(c.ring);
        if(g&&g.get('_pageid')!==bearer.get('_pageid')){removeRing(c);g=null;}
        if(!g){
            g=createObj('graphic',{_pageid:bearer.get('_pageid'),layer:geo.layer,imgsrc:urls[side],left:geo.left,top:geo.top,width:geo.width,height:geo.height,
                isdrawing:true,name:'AD5 счётчик: '+c.name,controlledby:'',tint_color:c.color,sides:urls.map(encodeURIComponent).join('|'),currentSide:side});
            if(!g){gm('Не удалось создать рамку «'+esc(c.name)+'»: картинки набора должны быть из вашей библиотеки Roll20.');return;}
            c.ring=g.id;toBack(g);return;
        }
        var patch={},want=Object.assign({imgsrc:urls[side],currentSide:side,tint_color:c.color},geo);
        Object.keys(want).forEach(function(k){if(String(g.get(k))!==String(want[k]))patch[k]=want[k];});
        if(Object.keys(patch).length){g.set(patch);if(patch.layer)toBack(g);}
    }
    function redraw(bearerId){countersOf(bearerId).forEach(function(c,i){drawRing(c,i);});refreshTooltip(bearerId);}
    function refreshTooltip(bearerId){
        var t=tok(bearerId);if(!t)return;
        try{if(typeof AD5Wounds!=='undefined'&&AD5Wounds&&typeof AD5Wounds.sync==='function')AD5Wounds.sync(t);}catch(ignore){}
    }
    function tooltipLines(tokenId){return countersOf(String(tokenId||'')).map(function(c){return c.name+' '+c.charges+'/'+c.max;});}

    // ---------------------------------------------------------------- кнопка
    function attrs(cid){return findObjs({_type:'attribute',_characterid:cid})||[];}
    function abilityMacro(cid,name){
        var want=norm(name),hit=(findObjs({_type:'ability',_characterid:cid})||[]).filter(function(a){return norm(a.get('name'))===want;})[0];
        if(hit)return '%{'+cid+'|'+hit.get('name')+'}';
        var found=null;
        attrs(cid).some(function(a){
            var n=String(a.get('name')||''),m;
            if(norm(a.get('current'))!==want)return false;
            if((m=/^repeating_attack_(.+)_atkname$/i.exec(n)))found='%{'+cid+'|repeating_attack_'+m[1]+'_attack}';
            else if((m=/^(repeating_npcaction(?:-l)?)_(.+)_name$/i.exec(n)))found='%{'+cid+'|'+m[1]+'_'+m[2]+'_npc_action}';
            else if((m=/^(repeating_spell-(?:cantrip|npc|\d))_(.+)_spellname$/i.exec(n)))found='%{'+cid+'|'+m[1]+'_'+m[2]+'_spell}';
            return !!found;
        });
        return found;
    }
    function buttonName(c){return '★ '+c.full.ability;}
    function setButton(c,on){
        var bearer=tok(c.bearer),cid=bearer&&String(bearer.get('represents')||'');if(!cid)return;
        var name=buttonName(c),list=(findObjs({_type:'ability',_characterid:cid,name:name})||[]);
