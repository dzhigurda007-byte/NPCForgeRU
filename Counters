    }
    // ctx {description, name} — текущая атака (AutoDamage 4.3.177+): бонус СЧЁТТРАТА по
    // ещё не потраченным зарядам и бонусы, уже списанные именно этой атакой.
    function combatModifiers(tokenId,ctx){
        var out={attack:0,damage:[]},now=Date.now(),id=String(tokenId||'');
        var list=(spent[id]||[]).filter(function(x){return x.until>now;});
        if(list.length)spent[id]=list;else delete spent[id];
        if(ctx&&ctx.name)list=list.filter(function(x){return !x.action||x.action===ctx.name;});
        // Бонус, ещё не забранный атакой (модификаторы считаются до события атаки).
        if(!list.length)list=(root().primed[id]||[]).slice();
        if(ctx&&ctx.description&&!list.some(function(x){return x.action&&x.action===ctx.name;}))spendLines(ctx.description).forEach(function(item){
            var c=find(id,item.name,null);if(c&&c.charges>0)list.push(spendBonus(item,c));
        });
        list.forEach(function(x){out.attack+=Number(x.attack)||0;if(x.damage)out.damage.push({formula:String(x.damage),sign:1,label:x.label,type:x.type||''});});
        return out;
    }
    // Использование кнопки «полной рамки» обнуляет счётчик.
    function onChat(msg){
        if(!msg.rolltemplate||!msg.content)return;
        // Название способности — rname (в карточках NPC name — имя персонажа), иначе name.
        var name=/\{\{rname=([^}]*)\}\}/i.exec(msg.content)||/\{\{name=([^}]*)\}\}/i.exec(msg.content),charname=/\{\{charname=([^}]*)\}\}/i.exec(msg.content);
        if(!name)return;var n=norm(name[1]);
        Object.keys(root().counters).forEach(function(id){
            var c=root().counters[id];if(!c||c.charges<c.max||!c.full||c.full.mode!=='button'||norm(c.full.ability)!==n)return;
            var bearer=tok(c.bearer),ch=bearer&&getObj('character',String(bearer.get('represents')||''));
            if(!ch||(charname&&norm(charname[1])!==norm(ch.get('name'))))return;
            tellOwners(ch.id,'<b>'+esc(c.name)+'</b>: использовано «'+esc(c.full.ability)+'».');remove(c,'использовано «'+c.full.ability+'»');
        });
    }

    // ---------------------------------------------------------------- применение
    // Вызывается AutoDamage после применения способности к цели.
    function onApplied(d){
        if(!d||d.разрешено===false)return;
        var spec;try{spec=parseBlock(d.описание);}catch(e){gm('<b>'+esc(d.имя||'Способность')+'</b>: '+esc(e.message));return;}
        if(!spec)return;
        var source=tok(d.источникТокенId),target=tok(d.цельТокенId),ownerCid=String(d.источникПерсонажId||(source&&source.get('represents'))||'');
        if(spec.complete&&target){
            var c=find(target.id,spec.complete,ownerCid)||find(target.id,spec.complete,null);
            if(c)fire(c,'завершено: '+(d.имя||'способность'));
            else gm('<b>'+esc(d.имя||'Способность')+'</b>: на '+esc(tokenName(target))+' нет счётчика «'+esc(spec.complete)+'».');
        }
        if(spec.completeOnly)return;
        var bearer=spec.on==='target'?target:(source||(target&&String(target.get('represents'))===ownerCid?target:null));
        if(!bearer){gm('<b>'+esc(spec.name)+'</b>: не найден токен-носитель.');return;}
        attach(spec,bearer,source,ownerCid,d.имя);
    }
    function sheetDescription(cid,name){
        var want=norm(name),rows=Object.create(null);
        attrs(cid).forEach(function(a){
            var n=String(a.get('name')||''),m=/^(repeating_[^_]+_.+)_(atkname|name|spellname|atk_desc|description|spelldescription)$/i.exec(n);
            if(!m)return;var r=rows[m[1]]||(rows[m[1]]={});
            if(/name$/i.test(m[2]))r.name=a.get('current');else r.desc=a.get('current');
        });
        var hit=Object.keys(rows).map(function(k){return rows[k];}).filter(function(r){return norm(r.name)===want&&r.desc;})[0];
        if(hit)return hit.desc;
        var ab=(findObjs({_type:'ability',_characterid:cid})||[]).filter(function(a){return norm(a.get('name'))===want;})[0];
        return ab?(ab.get('description')||ab.get('action')):null;
    }
    function useCommand(msg,args){
        var source=tok(args[2]),target=args[3]&&args[3]!=='-'?tok(args[3]):null,name=args.slice(4).join(' ');
        if(!source||!name)throw new Error('Формат: !ad5counter use TOKEN_ID TARGET_ID|- Имя способности');
        var cid=String(source.get('represents')||''),c=getObj('character',cid);
        if(!c)throw new Error('Токен без листа.');
        if(!playerIsGM(msg.playerid)&&String(c.get('controlledby')||'').split(',').indexOf(msg.playerid)<0)throw new Error('Это не ваш персонаж.');
        var desc=sheetDescription(cid,name);if(!desc)throw new Error('Способность «'+name+'» не найдена в листе.');
        onApplied({разрешено:true,источникТокенId:source.id,цельТокенId:target?target.id:source.id,источникПерсонажId:cid,имя:name,описание:desc});
    }

    // ---------------------------------------------------------------- карточки без атаки
    // 1.1.0: способность только со строками счётчика (без атаки, урона и спасброска,
    // например «Взрыв тьмы» с СЧЁТЗАВЕРШИТЬ) AutoDamage не обрабатывает — у неё нет
    // броска. Такую карточку применяет сам модуль:
    //   СЧЁТЗАВЕРШИТЬ — единственный подходящий счётчик владельца срабатывает сразу,
    //     при нескольких — кнопки выбора носителя;
    //   СЧЁТЧИК на себя — сразу на токен владельца; на цель — кнопка выбора цели.
    function cardFields(content){
        var out=Object.create(null),re=/\{\{([^=}]+)=([\s\S]*?)\}\}(?=\s*(?:\{\{|$))/g,m;
        while((m=re.exec(content)))out[m[1].trim().toLowerCase()]=m[2];
        return out;
    }
    function filled(v){return v!==undefined&&String(v).replace(/\$\[\[\d+\]\]/g,'x').trim()!==''&&!/^0$/.test(String(v).trim());}
    function handledByAutoDamage(f,desc){
        if(f.ad5source!==undefined||f.ad5target!==undefined||f.ad5reactionexec!==undefined)return true;
        // 1.3.0: только поля карточки. Проверка recognizesDirect по тексту описания
        // ошибочно считала «к6 силового поля за заряд» механикой AutoDamage, и карточка
        // детонатора не обрабатывалась никем. Механические строки AD5 (атака, урон,
        // спасбросок, эффекты) NPCForge и AutoDamage помечают полем ad5source.
        if(filled(f.dmg1)||filled(f.dmg2)||filled(f.savedc)||(filled(f.r1)&&(f.attack===undefined||filled(f.attack))))return true;
        return false;
    }
    function playerTell(pid,text){
        var p=pid&&!playerIsGM(pid)&&getObj('player',pid);
        if(p)sendChat(SCRIPT,'/w "'+String(p.get('_displayname')||'').replace(/["\r\n]/g,'')+'" '+text,null,{noarchive:true});
        gm(text);
    }
    function ownerToken(cid,hint){
        var t=tok(hint);if(t&&String(t.get('represents'))===cid)return t;
        var list=(findObjs({_type:'graphic',_subtype:'token',represents:cid})||[]);
        if(list.length<=1)return list[0]||null;
        var top=null;try{var o=JSON.parse(Campaign().get('turnorder')||'[]')||[];top=o[0]&&String(o[0].id||'');}catch(ignore){}
        var page=Campaign().get('playerpageid');
        return list.filter(function(x){return x.id===top;})[0]||list.filter(function(x){return x.get('_pageid')===page;})[0]||list[0];
    }
    // Кнопка в формате [текст](команда): так Roll20 подставляет &#64;{target|…} при нажатии.
    function button(label,cmd){return '['+esc(label).replace(/[\[\]]/g,'')+']('+cmd+')';}
    function detonate(pid,cid,target,name,label){
        var c=find(target.id,name,cid)||find(target.id,name,null);
        if(!c){playerTell(pid,'<b>'+esc(label||name)+'</b>: на '+esc(tokenName(target))+' нет счётчика «'+esc(name)+'».');return false;}
        fire(c,'завершено: '+(label||name));return true;
    }
    function autoCard(msg){
        if(!msg.rolltemplate||!/СЧ[ЁЕ]Т(?:ЧИК|ЗАВЕРШИТЬ)\s*[:：]/i.test(msg.content||''))return;
        var f=cardFields(String(msg.content)),desc=String(f.description||f.desc||f.atk_desc||'');
        if(!/СЧ[ЁЕ]Т(?:ЧИК|ЗАВЕРШИТЬ)\s*[:：]/i.test(desc)||handledByAutoDamage(f,desc))return;
        var name=String(f.rname!==undefined?f.rname:(f.name||'')).trim(),cid=String(f.characterid||f.charid||'').trim();
        if(!getObj('character',cid)){
            // Карточка листа без id персонажа: имя в charname (игрок) или name (NPC, rname — способность).
            var who=String(f.charname||(f.rname!==undefined?f.name:'')||'').trim(),byName=who?(findObjs({_type:'character',name:who})||[])[0]:null;cid=byName?byName.id:'';
        }
        if(!cid)return;
        var spec;try{spec=parseBlock(desc);}catch(e){playerTell(msg.playerid,'<b>'+esc(name)+'</b>: '+esc(e.message));return;}
        if(!spec)return;
        var source=ownerToken(cid,f.ad5sourcetoken),label=name||spec.name||spec.complete;
        if(spec.complete){
            // 1.3.0: цель детонации выбирается курсором Roll20. NPCForge 2.8.1 кладёт его
            // в саму кнопку способности (поле ad5countertarget); у старых листов — кнопка в чате.
            var picked=tok(String(f.ad5countertarget||'').trim());
            if(picked)detonate(msg.playerid,cid,picked,spec.complete,label);
            else playerTell(msg.playerid,'<b>'+esc(label)+'</b>: '+button('Выбрать цель','!ad5counter fire '+cid+' &#64;{target|Цель|token_id} '+spec.complete));
        }
        if(spec.completeOnly)return;
        if(!source){playerTell(msg.playerid,'<b>'+esc(label)+'</b>: токен владельца не найден — выделите его и повторите.');return;}
        if(spec.on==='target')playerTell(msg.playerid,'<b>'+esc(label)+'</b>: '+button('Выбрать цель','!ad5counter use '+source.id+' &#64;{target|Цель|token_id} '+name));
        else attach(spec,source,source,cid,label);
    }

    // ---------------------------------------------------------------- команды
    function selected(msg){return (msg.selected||[]).map(function(s){return getObj(s._type,s._id);}).filter(Boolean);}
    function registerImages(msg){
        var sel=selected(msg),urls=null;
        if(sel.length===1&&sel[0].get('sides')){urls=String(sel[0].get('sides')).split('|').map(function(s){try{return libraryUrl(decodeURIComponent(s));}catch(e){return null;}});}
        else if(sel.length>1){urls=sel.filter(function(o){return o.get('_type')==='graphic';}).sort(function(a,b){return Number(a.get('left'))-Number(b.get('left'));}).map(function(o){return libraryUrl(o.get('imgsrc'));});}
        if(!urls||urls.length<2)throw new Error('Выделите многосторонний токен набора или все картинки набора (слева направо: 0…N).');
        if(urls.some(function(u){return !u;}))throw new Error('Картинки должны быть загружены в вашу библиотеку Roll20 (не из маркетплейса).');
        var max=urls.length-1;root().sets[String(max)]=urls;warned[max]=false;
        Object.keys(root().counters).forEach(function(id){var c=root().counters[id];if(c&&c.max===max)redraw(c.bearer);});
        gm('Набор рамок на <b>'+max+'</b> делений сохранён ('+urls.length+' картинок). Выделенные объекты можно удалить.');
    }
    function listText(tokens){
        var rows=[];tokens.forEach(function(t){countersOf(t.id).forEach(function(c){rows.push(esc(tokenName(t))+': <b>'+esc(c.name)+'</b> '+c.charges+'/'+c.max+(c.turnsLeft?' · ходов '+c.turnsLeft:'')+(c.spec&&c.spec.accum?' · +'+(c.spec.accum.attack*c.charges)+' атака, +'+(c.spec.accum.damage*c.charges)+' урон':''));});});
        var sets=Object.keys(root().sets).sort(function(a,b){return a-b;}).join(', ')||'нет';
        return '<b>'+SCRIPT+' '+VERSION+'</b> · наборы рамок: '+esc(sets)+'<br>'+(rows.join('<br>')||'Счётчиков нет.');
    }
    function command(msg){
        var args=String(msg.content||'').trim().split(/\s+/),sub=String(args[1]||'list').toLowerCase();
        if(sub==='use'){useCommand(msg,args);return;}
        if(sub==='fire'){
            // !ad5counter fire CID TARGET Имя счётчика — детонация по выбранной цели.
            var fc=getObj('character',String(args[2]||'')),ft=tok(args[3]),fname=args.slice(4).join(' ');
            if(!fc||!ft||!fname)throw new Error('Формат: !ad5counter fire CHARACTER_ID TARGET_ID Имя счётчика');
            if(!playerIsGM(msg.playerid)&&String(fc.get('controlledby')||'').split(',').indexOf(msg.playerid)<0)throw new Error('Это не ваш персонаж.');
            detonate(msg.playerid,fc.id,ft,fname,fname);return;
        }
        if(sub==='spend'){spendCommand(msg,args);return;}
        if(!playerIsGM(msg.playerid))throw new Error('Команда доступна мастеру.');
        var sel=selected(msg).filter(function(o){return o.get('_type')==='graphic';}),name=args.slice(2).join(' ');
        if(sub==='images'){registerImages(msg);return;}
        if(sub==='list'){var page=Campaign().get('playerpageid');gm(listText(sel.length?sel:(findObjs({_type:'graphic',_pageid:page})||[]).filter(function(t){return countersOf(t.id).length;})));return;}
        if(!sel.length)throw new Error('Выделите токен-носитель.');
        sel.forEach(function(t){
            if(sub==='set'){
                var m=/^(.*?)\s+([+-]?\d+)$/.exec(name);if(!m)throw new Error('Формат: !ad5counter set ИМЯ N | +N | -N');
                var c=find(t.id,m[1]);if(!c)throw new Error('Нет счётчика «'+m[1]+'».');
                setCharges(c,/^[+-]/.test(m[2])?c.charges+Number(m[2]):Number(m[2]),'мастер');
            }else if(sub==='remove'){
                countersOf(t.id).forEach(function(c){if(name.toLowerCase()==='all'||norm(c.name)===norm(name))remove(c,'снят мастером');});
            }else if(sub==='complete'){
                var cc=find(t.id,name);if(!cc)throw new Error('Нет счётчика «'+name+'».');fire(cc,'завершено мастером');
            }else throw new Error('Команды: images, list, set, remove, complete, use.');
        });
    }

    // ---------------------------------------------------------------- рамки и токены
    function graphicChanged(g,prev){
        var idx=index();
        if(!idx.rings[g.id]&&!idx.byBearer[g.id])return;
        idx=idx.rings;
        if(idx[g.id]){
            // Изменения через API событий не порождают: это действие мастера.
            var c=root().counters[idx[g.id]];if(!c)return;
            // Мастер выбрал сторону рамки — заряды = номер стороны.
            var side=Number(g.get('currentSide'));
            if(prev&&Number(prev.currentSide)!==side&&Number.isFinite(side)){setCharges(c,side,'мастер');gm('<b>'+esc(c.name)+'</b>: заряды '+c.charges+'/'+c.max+' (вручную).');}
            redraw(c.bearer);
            return;
        }
        var list=countersOf(g.id);if(!list.length)return;
        // 1.3.1: чистое перемещение — рамки переставляются одной записью позиции,
        // без пересчёта геометрии, смены картинки и перерисовки подсказки.
        if(prev&&['width','height','layer','_pageid'].every(function(k){return String(prev[k])===String(g.get(k));})){
            if(String(prev.left)===String(g.get('left'))&&String(prev.top)===String(g.get('top')))return;
            var pos={left:Number(g.get('left')),top:Number(g.get('top'))};
            list.forEach(function(c){var r=c.ring&&tok(c.ring);if(r)r.set(pos);});
            return;
        }
        redraw(g.id);
    }

    // 1.4.1: перемещения через API (толчок/притягивание, телепорт этажей, откат движения,
    // обрезка о стену) событий не порождают. После любого события, которое могло их вызвать
    // (сообщение чата, перемещение токена, смена хода), через 60 мс рамки сверяются с
    // носителями — только позиция и страница, по числу носителей счётчиков (обычно единицы).
    var followTimer=null;
    function scheduleFollow(){
        if(followTimer||!Object.keys(root().counters).length)return;
        followTimer=setTimeout(function(){followTimer=null;try{followAll();}catch(e){log(SCRIPT+': рамки — '+(e.message||e));}},60);
    }
    function followAll(){
        Object.keys(index().byBearer).forEach(function(bid){
            var b=tok(bid);if(!b)return;
            countersOf(bid).forEach(function(c,i){
                var r=c.ring&&tok(c.ring);if(!r)return;
                if(r.get('_pageid')!==b.get('_pageid')){drawRing(c,i);return;}
                var geo=ringGeometry(b,i);
                if(Math.abs(Number(r.get('left'))-geo.left)>0.5||Math.abs(Number(r.get('top'))-geo.top)>0.5)r.set({left:geo.left,top:geo.top});
            });
        });
    }
    // 1.3.1: обработчик движения регистрируется при загрузке скрипта, а не в ready —
    // Roll20 вызывает обработчики по порядку регистрации, и рамка переставляется раньше,
    // чем отработают обработчики других модулей, зарегистрированные в их ready.
    var started=false;
    on('change:graphic',function(g,prev){if(!started)return;try{graphicChanged(g,prev);}catch(e){log(SCRIPT+': '+e.message);}scheduleFollow();});
    on('chat:message',function(){if(started)scheduleFollow();});
    // AD5 Turns: смена хода — через единый детектор (без него — обработчик Roll20, как раньше).
    function ad5OnTurn(name,order,fn){var hooked=false;function hook(){if(hooked)return true;if(typeof AD5Turns!=='undefined'&&AD5Turns&&typeof AD5Turns.subscribe==='function'){AD5Turns.subscribe(name,function(i){fn(Campaign(),{turnorder:i.beforeRaw},i);},order);hooked=true;}return hooked;}if(!hook())setTimeout(function(){if(!hook())on('change:campaign:turnorder',function(c,p){fn(c,p,null);});},0);}
    ad5OnTurn('Counters',90,function(){if(started)scheduleFollow();});
    on('ready',function(){
        started=true;
        root();
        Object.keys(root().counters).forEach(function(id){if(!root().counters[id])delete root().counters[id];});dirty();
        var bearers={};Object.keys(root().counters).forEach(function(id){var b=root().counters[id].bearer;if(tok(b))bearers[b]=true;});Object.keys(bearers).forEach(redraw);
        (function reconcile(attempt){
            var missing=Object.keys(root().counters).filter(function(id){return !tok(root().counters[id].bearer);});
            if(!missing.length)return;
            if(attempt+1<READY_RETRY_DELAYS.length){setTimeout(function(){
                // Носители, появившиеся за это время, получают рамки.
                var back={};Object.keys(root().counters).forEach(function(id){var c=root().counters[id];if(c&&missing.indexOf(id)>=0&&tok(c.bearer))back[c.bearer]=true;});Object.keys(back).forEach(redraw);
                reconcile(attempt+1);
            },READY_RETRY_DELAYS[attempt+1]-(attempt>=0?READY_RETRY_DELAYS[attempt]:0));return;}
            missing.forEach(function(id){var c=root().counters[id];if(c){removeRing(c);delete root().counters[id];}});dirty();
            log(SCRIPT+': удалены счётчики без токена-носителя: '+missing.length+'.');
        })(-1);
        var ev=typeof AD5События!=='undefined'&&AD5События&&typeof AD5События.подписаться==='function';
        if(ev){
            ['НАЧАЛО ХОДА','КОНЕЦ ХОДА','ПОПАДАНИЕ','ПОЛУЧЕН УРОН'].forEach(function(name){AD5События.подписаться(name,function(e){onEvent(name,e||{});});});
            AD5События.подписаться('АТАКА ПО ЦЕЛИ',function(e){onAttack(e||{});});
        }

        on('destroy:graphic',function(g){
            var idx=ringIndex();
            if(idx[g.id]){var c=root().counters[idx[g.id]];if(c){c.ring=null;dirty();remove(c,'рамка удалена');}return;}
            countersOf(g.id).forEach(function(c){remove(c);});
            delete root().primed[g.id];
        });
        on('chat:message',function(msg){
            try{
                if(msg.type==='api'){if(/^!ad5counter(?:\s|$)/i.test(msg.content||''))command(msg);return;}
                onChat(msg);
                autoCard(msg);
            }catch(e){
                var p=msg.playerid&&!playerIsGM(msg.playerid)&&getObj('player',msg.playerid);
                if(p)sendChat(SCRIPT,'/w "'+String(p.get('_displayname')||'').replace(/["\r\n]/g,'')+'" '+esc(e.message||e),null,{noarchive:true});
                else gm(esc(e.message||e));
            }
        });
        gm('<b>'+SCRIPT+' '+VERSION+'</b> запущен.'+(ev?'':' <b>Нет AD5 События</b> — заряды по событиям не начисляются.')+' Наборы рамок: '+esc(Object.keys(root().sets).join(', ')||'не загружены (!ad5counter images)')+'.');
    });
    return {version:VERSION,effectsChanged:effectsChanged,onApplied:onApplied,combatModifiers:combatModifiers,tooltipLines:tooltipLines,parse:parseBlock,list:countersOf,
        _test:{rollFormula:rollFormula,onEvent:onEvent,onAttack:onAttack,setCharges:setCharges,fire:fire,libraryUrl:libraryUrl}};
}());

