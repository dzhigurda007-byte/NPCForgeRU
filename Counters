        var color=field(list,'СЧ[ЁЕ]ТЦВЕТ');if(color){var c=COLORS[color.trim().toLowerCase()]||color.trim();if(/^#[0-9a-f]{6}$/i.test(c)||c==='transparent')spec.color=c;}
        return spec;
    }

    // ---------------------------------------------------------------- кубы
    function rollFormula(text,charges){
        var src=String(text||'').replace(/\{\s*З(?:АРЯДЫ)?\s*\}/gi,String(charges)).replace(/[кдk]/gi,'d').replace(/\s+/g,'');
        if(!/^[0-9d+\-]+$/i.test(src))throw new Error('Формула урона: '+text);
        var total=0,parts=[],re=/([+-]?)(\d*)d(\d+)|([+-]?)(\d+)/gi,m;
        while((m=re.exec(src))){
            if(m[3]!==undefined){var cnt=Number(m[2]||1),sides=Number(m[3]),sum=0;if(cnt>100)throw new Error('Слишком много кубов.');for(var i=0;i<cnt;i++)sum+=randomInteger(sides);total+=(m[1]==='-'?-1:1)*sum;parts.push((m[1]||'')+cnt+'к'+sides+'='+sum);}
            else{total+=(m[4]==='-'?-1:1)*Number(m[5]);parts.push((m[4]||'+')+m[5]);}
        }
