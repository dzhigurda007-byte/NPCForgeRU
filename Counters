        else if(mode==='now'){setTimeout(function(){var live=root().counters[c.id];if(live)fire(live,'рамка заполнена');},0);}
        else if(mode==='wait'){var oc=c.ownerCid||cid;tellOwners(oc,label+': можно завершить способностью.');}
        else tellOwners(cid,label+'.');
    }
    // Эффект счётчика: урон и/или состояния; {З} = накопленные заряды.
    function fire(c,why){
