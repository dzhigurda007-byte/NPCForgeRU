    }
    function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
    function norm(s){return String(s==null?'':s).replace(/\s+/g,' ').trim().toLocaleUpperCase('ru-RU').replace(/Ё/g,'Е');}
    function gm(text){sendChat(SCRIPT,'/w gm '+text,null,{noarchive:true});}
    function tellOwners(cid,text){
        var c=getObj('character',cid),sent=false;
        String(c&&c.get('controlledby')||'').split(',').forEach(function(id){
            id=id.trim();if(!id||id==='all'||playerIsGM(id))return;var p=getObj('player',id);if(!p)return;
            sendChat(SCRIPT,'/w "'+String(p.get('_displayname')||'').replace(/["\r\n]/g,'')+'" '+text,null,{noarchive:true});sent=true;
        });
        gm(text);return sent;
    }
    function tokenName(t){return String(t&&(t.get('name')||'')||'токен');}
    function tok(id){return getObj('graphic',String(id||''));}

    // ---------------------------------------------------------------- разбор
    function lines(description){
        return String(description==null?'':description)
            .replace(/<br\s*\/?\s*>|<\/p>|<\/div>/gi,'\n').replace(/<[^>]*>/g,' ').replace(/&nbsp;|&#160;/gi,' ')
            .replace(/\r/g,'\n').split(/\n+/).map(function(x){return x.trim();}).filter(Boolean);
    }
    function field(list,key){
        var re=new RegExp('^'+key+'\\s*[:：]\\s*(.*)$','i'),out=null;
        list.forEach(function(x){var m=re.exec(x);if(m&&out===null)out=m[1].trim();});
        return out;
    }
    function parseBlock(description){
        var list=lines(description),head=field(list,'СЧ[ЁЕ]ТЧИК');
        var finish=field(list,'СЧ[ЁЕ]ТЗАВЕРШИТЬ');
        if(!head)return finish?{completeOnly:true,complete:finish}:null;
        var m=/^(.*?)\s+(\d{1,2})\s*$/.exec(head);
        if(!m||!m[1].trim())throw new Error('СЧЁТЧИК: нужно «имя число_делений», например «Сила тьмы 4».');
        var max=Number(m[2]);if(max<1||max>20)throw new Error('СЧЁТЧИК: от 1 до 20 делений.');
        var spec={name:m[1].trim(),max:max,on:'self',start:0,triggers:[],accum:null,full:null,damage:null,effect:null,turns:null,color:'#8a2be2',complete:finish||null};
        var on=norm(field(list,'СЧ[ЁЕ]ТНА')||'СЕБЯ');if(/^ЦЕЛ/.test(on))spec.on='target';
        var start=Number(field(list,'СЧ[ЁЕ]ТСТАРТ'));if(Number.isFinite(start))spec.start=Math.max(0,Math.min(max,Math.floor(start)));
        var trig=field(list,'СЧ[ЁЕ]ТЗАРЯД');
        if(trig)trig.split('|').forEach(function(part){
            var t=norm(part).replace(/Ё/g,'Е'),mm=/^(.*?)(?:\s+([+-]?\d+))?$/.exec(t),key=mm[1].trim(),n=mm[2]===undefined?1:Number(mm[2]);
            if(!EVENTS[key])throw new Error('СЧЁТЗАРЯД: неизвестное событие «'+part.trim()+'».');
            spec.triggers.push({key:key,ev:EVENTS[key].ev,who:EVENTS[key].who,n:n});
        });
