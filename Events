        событие = событие || {};
        var ист = String(событие.источникТокенId || событие.источник || '');
        var цель = String(событие.цельТокенId || событие.цель || '');
        if (ожидание.страницаId && событие.страницаId && String(ожидание.страницаId) !== String(событие.страницаId)) return false;
        if (типИсточникЦель(тип)) return ист === String(ожидание.источникТокенId || '') && цель === String(ожидание.цельТокенId || '');
        if (типЦелевой(тип)) return цель === String(ожидание.цельТокенId || '');
        if (типИсточниковый(тип)) return ист === String(ожидание.источникТокенId || '');
        return true;
    }

    function вариантыСобытия(тип, данные) {
        var список = [тип];
        данные = данные || {};
        if (тип === 'АТАКА ПО ЦЕЛИ') return список;
        if (тип === 'ПОПАДАНИЕ') {
            список.push('ПОПАДАНИЕ ПО ЦЕЛИ', 'ПОПАДАНИЕ ИСТОЧНИКА ПО ЦЕЛИ');
            if (данные.оружие === true) список.push('ПОПАДАНИЕ ОРУЖИЕМ');
            if (данные.заклинание === true) список.push('ПОПАДАНИЕ ЗАКЛИНАНИЕМ');
            if (норма(данные.классАтаки) === 'рукопашная') {
                список.push('ПОПАДАНИЕ РУКОПАШНОЕ');
                if (данные.оружие === true) список.push('ПОПАДАНИЕ РУКОПАШНЫМ ОРУЖИЕМ');
            }
            if (норма(данные.классАтаки) === 'дальнобойная') {
                список.push('ПОПАДАНИЕ ДАЛЬНОБОЙНОЕ');
                if (данные.оружие === true) список.push('ПОПАДАНИЕ ДАЛЬНОБОЙНЫМ ОРУЖИЕМ');
            }
        } else if (тип === 'ПОЛУЧЕН УРОН') {
            // Сам тип уже является целевым событием.
        } else if (тип === 'ЦЕЛЬ УМЕРЛА') {
            // Сам тип уже является целевым событием.
        } else if (тип === 'НАЧАЛО ХОДА') {
            список.push('НАЧАЛО ХОДА ЦЕЛИ');
        } else if (тип === 'КОНЕЦ ХОДА') {
            список.push('КОНЕЦ ХОДА ЦЕЛИ');
        }
        var уникальные = [];
        список.forEach(function (x) { if (уникальные.indexOf(x) < 0) уникальные.push(x); });
        return уникальные;
    }

    function обработатьОжидания(тип, событие) {
        var база = корень().ожидания;
        var сработали = [];
        Object.keys(база).slice().forEach(function (id) {
            var ожидание = база[id];
            if (!ожиданиеЖиво(ожидание)) { delete база[id]; return; }
            if (!совпадаетОжидание(ожидание, тип, событие)) return;
            ожидание.срабатываний = (Number(ожидание.срабатываний) || 0) + 1;
            var снимок = копия(ожидание);
            сработали.push(снимок);
            вызватьПодписчиков('ОЖИДАНИЕ СРАБОТАЛО', {
                id:следующийId('срабатывание'),
                тип:'ОЖИДАНИЕ СРАБОТАЛО',
                триггер:тип,
                ожидание:снимок,
                событие:событие,
                время:Date.now()
            });
            отладка('Сработало ожидание ' + id + ': ' + тип + ' · ' + ожидание.имя);
            if (ожидание.одноразово) delete база[id];
        });
        return сработали;
    }

    function сообщить(тип, данные) {
        var канон = имяСобытия(тип);
        if (!канон || канон === 'ОЖИДАНИЕ СРАБОТАЛО') return данные || {};
        var событие = данные && typeof данные === 'object' ? данные : {};
        if (!событие.id) событие.id = следующийId('событие');
        событие.базовыйТип = канон;
        событие.время = Number(событие.время) || Date.now();
        if (!событие.страницаId) {
            var токен = getObj('graphic', String(событие.источникТокенId || событие.цельТокенId || ''));
            if (токен) событие.страницаId = String(токен.get('_pageid') || '');
        }
        событие.сработавшиеОжидания = Array.isArray(событие.сработавшиеОжидания) ? событие.сработавшиеОжидания : [];
        вариантыСобытия(канон, событие).forEach(function (вариант) {
            событие.тип = вариант;
            вызватьПодписчиков(вариант, событие);
            var сработали = обработатьОжидания(вариант, событие);
            сработали.forEach(function (x) { событие.сработавшиеОжидания.push(x); });
        });
        событие.тип = канон;
        отладка('СОБ: ' + канон + ' · источник=' + String(событие.источникТокенId || '—') + ' · цель=' + String(событие.цельТокенId || '—'));
        return событие;
    }

    function строкиОписания(описание) {
        return текст(описание).replace(/\r/g, '').split(/\n+/).map(function (строка) { return строка.replace(/^\s+|\s+$/g, ''); });
    }

    function разобратьБлоки(описание) {
        var строки = строкиОписания(описание), блоки = [], текущий = null;
        function завершить() { if (текущий) { текущий.тело = текущий.строки.join('\n').trim(); delete текущий.строки; блоки.push(текущий); текущий = null; } }
        строки.forEach(function (строка) {
            var м = /^\s*(ТРИГ|ТРИГГЕР|СОБ|СОБЫТИЕ)\s*:\s*(.+?)\s*$/i.exec(строка);
            if (м) {
                завершить();
                текущий = {сыройТриггер:м[2], триггер:имяСобытия(м[2]), одноразово:true, строки:[]};
                return;
            }
            if (!текущий) return;
            var ключ = верх(строка);
            if (ключ === 'ПОВТ' || ключ === 'ПОВТОР' || ключ === 'ПОВТОРЯТЬ' || ключ === 'МНОГОРАЗОВО') { текущий.одноразово = false; return; }
            if (ключ === 'ОДИН' || ключ === 'ОДИНРАЗОВО' || ключ === 'РАЗОВО') { текущий.одноразово = true; return; }
            текущий.строки.push(строка);
        });
        завершить();
        return блоки;
    }

    function зарегистрироватьИзОписания(контекст) {
        контекст = контекст && typeof контекст === 'object' ? контекст : {};
        if (контекст.разрешено === false || контекст.периодический || контекст.область || контекст.фаза) return [];
        var описание = String(контекст.описание || '');
        if (!/(?:^|[\n>])\s*(?:ТРИГ|ТРИГГЕР|СОБ|СОБЫТИЕ)\s*:/i.test(текст(описание))) return [];
        var блоки = разобратьБлоки(описание), создано = [], ошибки = [];
        блоки.forEach(function (блок, индекс) {
            if (!блок.триггер) { ошибки.push('неизвестный ТРИГ «' + блок.сыройТриггер + '»'); return; }
            try {
                var id = поставитьОжидание({
                    триггер:блок.триггер,
                    имя:String(контекст.имя || 'Способность'),
                    источникПерсонажId:String(контекст.источникПерсонажId || ''),
                    источникТокенId:String(контекст.источникТокенId || ''),
                    цельТокенId:String(контекст.цельТокенId || ''),
                    страницаId:String(контекст.страницаId || ''),
                    концентрацияId:String(контекст.концентрацияId || ''),
                    одноразово:блок.одноразово,
                    ключРегистрации:контекст.ключРегистрации?String(контекст.ключРегистрации)+':триг:'+индекс:'',
                    тело:блок.тело,
                    описание:описание,
                    данные:{номерБлока:индекс, исходныйТриггер:блок.сыройТриггер, история:String(контекст.история || '')}
                });
                создано.push(id);
            } catch (ошибка) { ошибки.push(String(ошибка.message || ошибка)); }
        });
        if (ошибки.length) мастер('<b>ТРИГ не зарегистрирован полностью:</b> ' + экр(ошибки.join('; ')));
        return создано;
    }

    function разборПорядка(сырой) {
        try { var x = JSON.parse(сырой || '[]'); return Array.isArray(x) ? x : []; }
        catch (ошибка) { return []; }
    }

    function ключГруппы(токен) {
        if (!токен) return '';
        try {
            if (typeof AD5EffectTurns !== 'undefined' && AD5EffectTurns && typeof AD5EffectTurns.groupKey === 'function') return String(AD5EffectTurns.groupKey(токен) || токен.id);
        } catch (ошибка) {}
        return String(токен.id || '');
    }

    function токеныГруппы(токен) {
        if (!токен) return [];
        var страница = String(токен.get('_pageid') || ''), ключ = ключГруппы(токен);
        var найдено = findObjs({_type:'graphic', _subtype:'token', _pageid:страница}).filter(function (т) {
            if (!т || т.get('isdrawing') || т.get('layer') !== 'objects' || !т.get('represents')) return false;
            return ключГруппы(т) === ключ;
        });
        return найдено.length ? найдено : [токен];
    }

    function активнаяСтрока(порядок) {
        if (!порядок || !порядок.length) return null;
        var строка = порядок[0];
        if (!строка || String(строка.id || '') === '-1') return null;
        var токен = getObj('graphic', String(строка.id || ''));
        return токен || null;
    }

    function сообщитьХод(тип, токен) {
        токеныГруппы(токен).forEach(function (т) {
            сообщить(тип, {
                источникТокенId:т.id,
                цельТокенId:т.id,
                источникПерсонажId:String(т.get('represents') || ''),
                страницаId:String(т.get('_pageid') || ''),
                имяТокена:String(т.get('name') || '')
            });
        });
    }

    function сменаХода(кампания, предыдущее) {
        var до = активнаяСтрока(разборПорядка(предыдущее && предыдущее.turnorder));
        var после = активнаяСтрока(разборПорядка(кампания && кампания.get ? кампания.get('turnorder') : Campaign().get('turnorder')));
        var ключДо = до ? ключГруппы(до) : '';
        var ключПосле = после ? ключГруппы(после) : '';
        if (ключДо === ключПосле) return;
        if (до) сообщитьХод('КОНЕЦ ХОДА', до);
        if (после) сообщитьХод('НАЧАЛО ХОДА', после);
        ПОСЛЕДНЯЯ_ГРУППА = ключПосле;
    }

    function имяИгрока(msg) {
        var игрок = getObj('player', msg.playerid);
        return игрок ? String(игрок.get('_displayname') || игрок.get('displayname') || 'Игрок').replace(/["\r\n]/g, '') : 'Игрок';
    }

    function ответ(msg, html) {
        if (playerIsGM(msg.playerid)) мастер(html);
        else sendChat(СКРИПТ, '/w "' + имяИгрока(msg) + '" ' + html, null, {noarchive:true});
    }

    function команда(msg) {
        if (!msg || msg.type !== 'api' || !/^!ad5(?:соб|event)(?:\s|$)/i.test(String(msg.content || ''))) return;
        try {
            var строка = String(msg.content || '').trim().replace(/^!ad5(?:соб|event)\s*/i, '');
            var части = строка.split(/\s+/), под = норма(части.shift() || 'статус');
            if (под === 'ping') { ответ(msg, '<b>' + СКРИПТ + ' ' + ВЕРСИЯ + '</b> работает. Ожиданий: ' + ожидания().length + '.'); return; }
            if (под === 'события' || под === 'список') { ответ(msg, '<b>События:</b><br>' + СОБЫТИЯ.filter(function (x) { return x !== 'ОЖИДАНИЕ СРАБОТАЛО'; }).map(экр).join('<br>')); return; }
            if (под === 'статус') {
                var список = ожидания();
                if (!список.length) { ответ(msg, 'Активных ТРИГ-ожиданий нет.'); return; }
                ответ(msg, '<b>Активные ТРИГ-ожидания: ' + список.length + '</b><br>' + список.map(function (о) {
                    return '<code>' + экр(о.id) + '</code> · <b>' + экр(о.триггер) + '</b> · ' + экр(о.имя) + ' · ист=' + экр(о.источникТокенId || '—') + ' · цель=' + экр(о.цельТокенId || '—') + (о.одноразово ? ' · разово' : ' · повтор');
                }).join('<br>')); return;
            }
            if (под === 'очистить') {
                if (!playerIsGM(msg.playerid)) throw new Error('Только GM.');
                var количество = Object.keys(корень().ожидания).length; корень().ожидания = {};
                мастер('Очищено ТРИГ-ожиданий: <b>' + количество + '</b>.'); return;
            }
            if (под === 'отладка') {
                if (!playerIsGM(msg.playerid)) throw new Error('Только GM.');
                var режим = норма(части[0] || '');
                корень().отладка = /^(вкл|on|1|да)$/.test(режим);
                мастер('Отладка AD5 События: <b>' + (корень().отладка ? 'ВКЛ' : 'ВЫКЛ') + '</b>.'); return;
            }
            if (под === 'тест') {
                if (!playerIsGM(msg.playerid)) throw new Error('Только GM.');
                var название = части.join(' '), канон = имяСобытия(название);
                if (!канон || канон === 'ОЖИДАНИЕ СРАБОТАЛО') throw new Error('Неизвестное событие: ' + название);
                var выбранные = (msg.selected || []).map(function (x) { return getObj('graphic', x._id); }).filter(Boolean);
                if (!выбранные.length) throw new Error('Выделите хотя бы один токен.');
                var источник = выбранные[0], цель = выбранные[1] || выбранные[0];
                сообщить(канон, {
                    источникТокенId:источник.id, цельТокенId:цель.id,
                    источникПерсонажId:String(источник.get('represents') || ''),
                    страницаId:String(источник.get('_pageid') || ''),
                    оружие:/ОРУЖИЕМ/.test(канон),
                    заклинание:/ЗАКЛИНАНИЕМ/.test(канон),
                    классАтаки:/РУКОПАШ/.test(канон) ? 'рукопашная' : (/ДАЛЬНОБОЙ/.test(канон) ? 'дальнобойная' : '')
                });
                мастер('Тестовое событие отправлено: <b>' + экр(канон) + '</b>.'); return;
            }
            ответ(msg, '<b>' + СКРИПТ + ' ' + ВЕРСИЯ + '</b><br><code>!ad5соб статус</code><br><code>!ad5соб события</code><br><code>!ad5соб ping</code>');
        } catch (ошибка) { ответ(msg, '<b>Ошибка:</b> ' + экр(ошибка.message || ошибка)); }
    }

    on('change:campaign:turnorder', function (кампания, предыдущее) {
        try { сменаХода(кампания, предыдущее); }
        catch (ошибка) { мастер('<b>Ошибка Turn Tracker:</b> ' + экр(ошибка.message || ошибка)); }
    });

    on('destroy:graphic', function (токен) {
        try {
            var база = корень().ожидания;
            Object.keys(база).forEach(function (id) {
                var о = база[id];
                if (о && (о.источникТокенId === токен.id || о.цельТокенId === токен.id)) delete база[id];
            });
        } catch (ошибка) {}
    });

    on('change:campaign:playerpageid', function () { очиститьМертвыеОжидания(); });
    on('chat:message', команда);
    on('ready', function () {
        корень(); очиститьМертвыеОжидания();
        var удаленоДублей = удалитьДублиОжиданий();
        var порядок = разборПорядка(Campaign().get('turnorder'));
        var активный = активнаяСтрока(порядок);
        ПОСЛЕДНЯЯ_ГРУППА = активный ? ключГруппы(активный) : '';
        log(СКРИПТ + ' ' + ВЕРСИЯ + ' ready; removed duplicate waits=' + удаленоДублей + '.');
        мастер('<b>' + СКРИПТ + ' ' + ВЕРСИЯ + '</b> запущен. ТРИГ:/СОБ: активны; движок только фиксирует и маршрутизирует события, без самостоятельного урона/модификаторов. Проверка: <code>!ad5соб ping</code>.');
    });

    return {
        версия:ВЕРСИЯ,
        version:ВЕРСИЯ,
        имяСобытия:имяСобытия,
        подписаться:подписаться,
        отписаться:отписаться,
        сообщить:сообщить,
        поставитьОжидание:поставитьОжидание,
        снятьОжидание:снятьОжидание,
        зарегистрироватьИзОписания:зарегистрироватьИзОписания,
        ожидания:ожидания,
        очиститьМертвыеОжидания:очиститьМертвыеОжидания,
        удалитьДублиОжиданий:удалитьДублиОжиданий,
        _тест:{разобратьБлоки:разобратьБлоки, вариантыСобытия:вариантыСобытия, совпадаетОжидание:совпадаетОжидание, ключСовпаденияОжидания:ключСовпаденияОжидания, сменаХода:сменаХода, ключГруппы:ключГруппы}
    };
}());
}
