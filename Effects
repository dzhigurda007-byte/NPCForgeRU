/* Installation guard: disable old unguarded versions before installing. */
if(typeof AD5FX!=='undefined'&&AD5FX) {
    log('AD5FX: duplicate module skipped; keep one installed copy.');
} else {
/*
 * AD5 FX 1.3.2 — визуальные эффекты боя и пинг активного хода.
 * 1.3.2: смена хода — через AD5 Turns (единая граница хода, записи трекера скриптами видны).
 *
 * Эффекты (по событиям AD5 События) — встроенные эффекты Roll20 (размер 100%).
 * !ad5vfx size 10–99 — уменьшенные копии: скрипт создаёт «свои эффекты» (custfx) с
 * меньшими частицами. 1.3.1: прямое описание эффекта (spawnFxWithDefinition) в
 * Jumpgate теряет цвет — частицы белые, поэтому оно больше не используется.
 * Что показывается:
 *   - урон: цвет по типу урона (огонь, холод, кислота, яд, некротическая энергия,
 *     излучение, психический, силовое поле, электричество, звук; оружие — кровь);
 *   - критическое попадание — дополнительный взрыв;
 *   - попадание заклинанием-атакой — вспышка на цели (при 100% — луч от заклинателя);
 *   - лечение — свечение (вызывает AutoDamage 4.3.174+);
 *   - смерть цели — вспышка смерти.
 *   Не больше 12 эффектов в секунду, чтобы массовая область не перегружала клиентов.
 * Ход: в начале хода — пинг на токене с фокусом камеры на нём. Отдельного маркера хода
 * нет: картинка вне токена не группируется с ним через API и отстаёт при перемещении.
 * Маркер из версий 1.0–1.1 удаляется при запуске.
 * Скрытый токен (слой GM) — пинг и фокус только у мастера.
 *
 * Команды (GM): !ad5vfx — меню; !ad5vfx fx|ping|focus on|off (focus — пинг
 * переносит камеру к токену); !ad5vfx size N — размер эффектов в % (100 по умолчанию);
 * !ad5vfx test — эффекты на выделенном токене.
 * С 1.2.0 команда — !ad5vfx: «!ad5fx» принадлежит Turn Effect.
 */
var AD5FX=AD5FX||(function(){
    'use strict';
    var VERSION='1.3.2',SCRIPT='AD5 FX';
    var FX_PER_SECOND=12,fxWindow=0,fxCount=0;
    var TYPE_COLORS=[
        [/огон|fire/,'fire'],[/холод|cold|frost/,'frost'],[/кислот|acid/,'acid'],[/яд|poison/,'slime'],
        [/некрот|necrot/,'death'],[/излуч|radiant|свет/,'holy'],[/психи|psychic/,'charm'],
        [/силов|force/,'magic'],[/электр|молни|lightning/,'magic'],[/звук|thunder/,'smoke']
    ];

    function root(){
        if(!state.AD5FX||typeof state.AD5FX!=='object')state.AD5FX={};
        var r=state.AD5FX;r.version=VERSION;
        ['fx','ping','focus'].forEach(function(k){if(typeof r[k]!=='boolean')r[k]=true;});
        // 1.3.1: по умолчанию снова встроенные эффекты (100%): в Jumpgate цвета из
        // spawnFxWithDefinition не применяются, и уменьшенные эффекты были белыми шарами.
        if(r.sizeV!==2){r.sizeV=2;r.size=100;}
        var sz=Number(r.size);r.size=Number.isFinite(sz)&&sz>=10&&sz<=100?Math.round(sz):100;
        r.custfx=r.custfx&&typeof r.custfx==='object'?r.custfx:{};
        return r;
    }
    function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
    function gm(t){sendChat(SCRIPT,'/w gm '+t,null,{noarchive:true});}
    function tok(id){return getObj('graphic',String(id||''));}
    function gmIds(){return (findObjs({_type:'player'})||[]).filter(function(p){return playerIsGM(p.id);}).map(function(p){return p.id;});}
    function hidden(t){return String(t.get('layer'))==='gmlayer';}

    // ---------------------------------------------------------------- эффекты
    function allow(){
        var now=Date.now();if(now-fxWindow>1000){fxWindow=now;fxCount=0;}
        if(fxCount>=FX_PER_SECOND)return false;fxCount++;return true;
    }
    // 1.3.0: эффекты в уменьшенном масштабе (по умолчанию 33% — втрое меньше встроенных),
    // чтобы не загромождать карту. Встроенные эффекты Roll20 размер не меняют, поэтому
    // эффект описывается своими параметрами частиц и запускается spawnFxWithDefinition.
    // Значения SHAPES подобраны близко к встроенным эффектам при 100%; при масштабе
    // уменьшаются размер частиц, скорость (радиус разлёта) и число частиц.
    var RGB={fire:[230,80,10],frost:[130,200,255],acid:[110,220,40],slime:[90,170,30],death:[100,20,120],holy:[255,235,140],
        charm:[230,90,200],magic:[120,120,255],smoke:[180,180,180],blood:[170,0,0],water:[60,120,230]};
    var SHAPES={
        splatter:{maxParticles:60,size:18,sizeRandom:8,lifeSpan:14,lifeSpanRandom:4,speed:9,speedRandom:4,emissionRate:60,duration:3,gravity:{x:0,y:0.3}},
        burn:{maxParticles:100,size:35,sizeRandom:15,lifeSpan:25,lifeSpanRandom:7,speed:3,speedRandom:1.5,emissionRate:6,duration:25,gravity:{x:0,y:-0.05}},
        glow:{maxParticles:60,size:30,sizeRandom:10,lifeSpan:20,lifeSpanRandom:5,speed:1,speedRandom:0.5,emissionRate:4,duration:20},
        burst:{maxParticles:120,size:30,sizeRandom:10,lifeSpan:12,lifeSpanRandom:4,speed:14,speedRandom:6,emissionRate:120,duration:2},
        nova:{maxParticles:200,size:30,sizeRandom:10,lifeSpan:18,lifeSpanRandom:4,speed:12,speedRandom:1,emissionRate:200,duration:2}
    };
    function definition(type,scale){
        var m=/^([a-z]+)-([a-z]+)$/.exec(String(type||'')),shape=m&&SHAPES[m[1]],rgb=m&&RGB[m[2]];
        if(!shape||!rgb)return null;
        var d={angle:0,angleRandom:360,startColour:rgb.concat([1]),startColourRandom:[20,20,20,0],endColour:rgb.concat([0]),endColourRandom:[10,10,10,0]};
        Object.keys(shape).forEach(function(k){d[k]=shape[k];});
        ['size','sizeRandom','speed','speedRandom'].forEach(function(k){d[k]=Math.round(shape[k]*scale*100)/100;});
        d.maxParticles=Math.max(8,Math.round(shape.maxParticles*scale));
        d.emissionRate=Math.max(1,Math.round(shape.emissionRate*Math.max(scale,0.34)*100)/100);
        if(shape.gravity)d.gravity={x:0,y:Math.round(shape.gravity.y*scale*1000)/1000};
        return d;
    }
    // Уменьшенный эффект — объект «своего эффекта» Roll20 (custfx, как из панели FX),
    // создаётся один раз на тип и размер и запускается spawnFx по id.
    function customFx(type,pct){
        var r=root(),key=type+'@'+pct,id=r.custfx[key],o=id&&getObj('custfx',id);if(o)return o.id;
        var d=definition(type,pct/100);if(!d)return null;
        o=createObj('custfx',{name:'AD5 '+key,definition:d});if(!o)return null;
        r.custfx[key]=o.id;return o.id;
    }
    function dropCustomFx(){
        var r=root();Object.keys(r.custfx).forEach(function(k){var o=getObj('custfx',r.custfx[k]);if(o)o.remove();});r.custfx={};
    }
    function fxAt(t,type){
        if(!root().fx||!t||hidden(t)||typeof spawnFx!=='function'||!allow())return;
        var x=Number(t.get('left')),y=Number(t.get('top')),page=t.get('_pageid'),pct=root().size;
        try{
            var id=pct<100?customFx(type,pct):null;
            spawnFx(x,y,id||type,page);
        }catch(e){log(SCRIPT+': fx '+type+': '+e.message);}
    }
    function fxBetween(a,b,type){
        if(!root().fx||!a||!b||hidden(a)||hidden(b)||a.get('_pageid')!==b.get('_pageid')||typeof spawnFxBetweenPoints!=='function'||!allow())return;
        try{spawnFxBetweenPoints({x:Number(a.get('left')),y:Number(a.get('top'))},{x:Number(b.get('left')),y:Number(b.get('top'))},type,a.get('_pageid'));}catch(e){log(SCRIPT+': spawnFxBetweenPoints '+type+': '+e.message);}
    }
    function colorOf(types){
        var list=(types||[]).map(function(x){return String(x||'').toLowerCase().replace(/ё/g,'е');});
        for(var i=0;i<list.length;i++){for(var j=0;j<TYPE_COLORS.length;j++)if(TYPE_COLORS[j][0].test(list[i]))return TYPE_COLORS[j][1];}
        return 'blood';
    }
    function onDamage(e){
        var t=tok(e.цельТокенId);if(!t||!(Number(e.уронПослеЗащит)>0))return;
        var color=colorOf(e.типыУрона),kind=color==='fire'?'burn-':color==='blood'?'splatter-':'glow-';
        fxAt(t,kind+color);
        if(e.атака&&e.атака.крит)fxAt(t,'burst-'+color);
    }
    function onHit(e){
        if(!e||!e.заклинание)return;
        // Луч заклинания (встроенный, его размер не меняется) — только в полном масштабе;
        // в уменьшенном — небольшая вспышка на цели.
        if(root().size>=100)fxBetween(tok(e.источникТокенId),tok(e.цельТокенId),'beam-magic');
        else fxAt(tok(e.цельТокенId),'glow-magic');
    }
    function healed(token,amount){if(Number(amount)>0)fxAt(token,'glow-holy');}
    function onDeath(e){fxAt(tok(e.цельТокенId),'nova-death');}

    // ---------------------------------------------------------------- ход
    var activeId='';
    // Маркер хода из 1.0–1.1 (отдельная картинка, которая «ползла» за токеном) больше не используется — удаляем.
    function removeLegacyMarker(){
        var r=root(),ids={};if(r.markerId)ids[r.markerId]=1;
        (findObjs({_type:'graphic',name:'AD5 активный ход'})||[]).forEach(function(g){ids[g.id]=1;});
        Object.keys(ids).forEach(function(id){var g=getObj('graphic',id);if(g)g.remove();});
        ['marker','markerImg','markerId','markerStyle','markerWarned','color','move'].forEach(function(k){delete r[k];});
    }
    function ping(t){
        var r=root();if(!r.ping||!t||typeof sendPing!=='function')return;
        try{
            if(hidden(t))sendPing(Number(t.get('left')),Number(t.get('top')),t.get('_pageid'),null,!!r.focus,gmIds());
            else sendPing(Number(t.get('left')),Number(t.get('top')),t.get('_pageid'),null,!!r.focus);
        }catch(e){log(SCRIPT+': sendPing '+e.message);}
    }
    var lastTop='';
    function turnChanged(){
        var order;try{order=JSON.parse(Campaign().get('turnorder')||'[]')||[];}catch(e){return;}
        var row=order.length?order[0]:null,key=row?String(row.id||'')+'|'+String(row.custom||''):'';
        if(key===lastTop)return;lastTop=key;
        var t=row&&String(row.id||'')!=='-1'?tok(row.id):null;activeId=t?t.id:'';
        if(t)ping(t);
    }

    // ---------------------------------------------------------------- команды
    function menu(){
        var r=root(),b=function(label,cmd){return '<a style="display:inline-block;background:#3a3a5a;color:#fff;padding:3px 6px;margin:2px;border-radius:3px;text-decoration:none" href="'+cmd+'">'+esc(label)+'</a>';},sw=function(k,label){return b((r[k]?'✓ ':'✗ ')+label,'!ad5vfx '+k+' '+(r[k]?'off':'on'));};
        gm('<b>'+SCRIPT+' '+VERSION+'</b><br>'+sw('fx','Эффекты')+sw('ping','Пинг хода')+sw('focus','Фокус камеры на токене')+'<br>Размер эффектов: '+r.size+'% '+b('Изменить','!ad5vfx size ?{Размер, % от встроенных (10–100; 100 — встроенные)|100}')+b('Тест на выделенном','!ad5vfx test'));
    }
    function command(msg){
        if(!playerIsGM(msg.playerid))return;
        var a=String(msg.content).trim().split(/\s+/),sub=String(a[1]||'').toLowerCase(),val=String(a[2]||'').toLowerCase(),r=root();
        var sel=(msg.selected||[]).map(function(s){return getObj('graphic',s._id);}).filter(Boolean);
        if(sub==='move')sub='focus';
        if(['fx','ping','focus'].indexOf(sub)>=0&&(val==='on'||val==='off')){r[sub]=val==='on';menu();return;}
        if(sub==='size'){var n=Number(String(a[2]||'').replace('%',''));if(!(n>=10&&n<=100)){gm('Размер: от 10 до 100 (% от встроенных эффектов Roll20).');return;}if(Math.round(n)!==r.size)dropCustomFx();r.size=Math.round(n);menu();return;}
        if(sub==='test'){
            if(!sel.length){gm('Выделите токен.');return;}
            fxWindow=0;fxCount=0;var t=sel[0];
            ['splatter-blood','burn-fire','glow-frost','burst-blood','glow-holy'].forEach(function(type,i){setTimeout(function(){fxAt(t,type);},i*700);});
            ping(t);return;
        }
        menu();
    }

    on('ready',function(){
        root();
        try{var o=JSON.parse(Campaign().get('turnorder')||'[]')||[];var row=o[0];lastTop=row?String(row.id||'')+'|'+String(row.custom||''):'';activeId=row&&tok(row.id)?row.id:'';}catch(ignore){}
        removeLegacyMarker();
        var ev=typeof AD5События!=='undefined'&&AD5События&&typeof AD5События.подписаться==='function';
        if(ev){
            AD5События.подписаться('ПОЛУЧЕН УРОН',function(e){try{onDamage(e||{});}catch(err){log(SCRIPT+': '+err.message);}});
            AD5События.подписаться('ПОПАДАНИЕ',function(e){try{onHit(e||{});}catch(err){log(SCRIPT+': '+err.message);}});
            AD5События.подписаться('ЦЕЛЬ УМЕРЛА',function(e){try{onDeath(e||{});}catch(err){log(SCRIPT+': '+err.message);}});
        }
        // AD5 Turns: смена хода — через единый детектор (без него — обработчик Roll20, как раньше).
        function ad5OnTurn(name,order,fn){var hooked=false;function hook(){if(hooked)return true;if(typeof AD5Turns!=='undefined'&&AD5Turns&&typeof AD5Turns.subscribe==='function'){AD5Turns.subscribe(name,function(i){fn(Campaign(),{turnorder:i.beforeRaw},i);},order);hooked=true;}return hooked;}if(!hook())setTimeout(function(){if(!hook())on('change:campaign:turnorder',function(c,p){fn(c,p,null);});},0);}
        ad5OnTurn('Effects',80,function(c,p,i){if(i&&!i.newTurn)return;try{turnChanged();}catch(e){log(SCRIPT+': '+e.message);}});
        on('destroy:graphic',function(g){if(g.id===activeId)activeId='';});
        on('chat:message',function(msg){if(msg.type==='api'&&/^!ad5vfx(?:\s|$)/i.test(msg.content||''))command(msg);});
        log(SCRIPT+' '+VERSION+' ready.'+(ev?'':' Нет AD5 События — эффекты урона отключены.'));
    });
    return {version:VERSION,healed:healed,fxAt:fxAt,fxBetween:fxBetween,_test:{definition:definition,colorOf:colorOf,onDamage:onDamage,onHit:onHit,turnChanged:turnChanged}};
}());

}
