    function command(msg){
        if(msg.type!=='api'||!/^!ad5height(?:\s|$)/i.test(msg.content))return;
        var a=msg.content.trim().split(/\s+/),sub=norm(a[1]||'status');
        try{
            var selected=(msg.selected||[]).filter(function(x){return x._type==='graphic';}).map(function(x){return getObj('graphic',x._id);}).filter(isToken);
            if(sub==='ping'){sendChat(SCRIPT,'/w gm <b>'+SCRIPT+' '+VERSION+'</b> активен. Маркер полёта: <b>'+esc(MARKER_NAME)+'</b>.',null,{noarchive:true});return;}
            if(sub==='doctor'||sub==='diag'||sub==='диагностика'){doctor(msg);return;}
            if(sub==='sync'){if(!playerIsGM(msg.playerid))throw new Error('Только GM.');var n=syncPage(Campaign().get('playerpageid'));sendChat(SCRIPT,'/w gm Маркеры высоты синхронизированы. Изменено токенов: '+n+'.',null,{noarchive:true});return;}
            if(!selected.length)throw new Error('Выделите токен.');
            if(sub==='set'){
                var h=number(a[2]);selected.forEach(function(t){writeTokenBarNumber(t,3,h);syncMarker(t);});return;
            }
            if(sub==='clear'||sub==='ground'){selected.forEach(function(t){writeTokenBarNumber(t,3,0);syncMarker(t);});return;}
            if(sub==='testfall'){
                if(!playerIsGM(msg.playerid))throw new Error('TESTFALL доступен только GM.');
                if(typeof AD5==='undefined'||!AD5||!AD5.environment||typeof AD5.environment.damage!=='function')throw new Error('Нет AD5.environment.damage — установите актуальный основной AD5.');
                var distance=number(a[2]);if(!Number.isFinite(distance)||distance<=0)throw new Error('Укажите дистанцию падения в футах: !ad5height testfall 260');
                var startedTest=0,busyTest=[];
                selected.forEach(function(t){
                    if(falling[t.id]){busyTest.push(t.get('name')||t.id);return;}
                    falling[t.id]=true;startedTest++;
                    var landing=terrainHeightFeet(t),start=landing+distance;
                    setTimeout(function(){var live=getObj('graphic',t.id);if(!isToken(live)){delete falling[t.id];return;}resolveFallDamage(live,distance,start,landing,'TESTFALL '+distance+' фт');},0);
                });
                sendChat(SCRIPT,'/w gm <b>TESTFALL</b>: запущено '+startedTest+' падение(й) по '+distance+' фт.'+(busyTest.length?' Уже обрабатываются: '+esc(busyTest.join(', '))+'.':''),null,{noarchive:true});
                return;
            }
            if(sub==='fall'){
                if(!playerIsGM(msg.playerid))throw new Error('FALL доступен только GM.');
                var started=0,noFlight=[],busy=[];
                selected.forEach(function(t){
                    var f=flightHeightFeet(t);
                    if(f<=0){noFlight.push((t.get('name')||t.id)+' [bar3 raw='+String(t.get('bar3_value')==null?'':t.get('bar3_value'))+']');return;}
                    if(falling[t.id]){busy.push((t.get('name')||t.id)+' ('+f+' фт)');return;}
                    if(forceFallNow(t,'FALL'))started++;
                });
                if(!started){
                    if(busy.length)sendChat(SCRIPT,'/w gm FALL: падение уже обрабатывается для: '+esc(busy.join(', '))+'.',null,{noarchive:true});
                    else sendChat(SCRIPT,'/w gm FALL: высота полёта не определена. '+esc(noFlight.join('; '))+'. Проверьте именно bar3_value; bar4 — высота местности.',null,{noarchive:true});
                }
                return;
            }
            selected.forEach(function(t){var f=flightHeightFeet(t),tr=terrainHeightFeet(t),tot=f+tr,sp=sizeProfile(t),fs=fallSpec(f,t),r3=String(t.get('bar3_value')==null?'':t.get('bar3_value')),r4='';try{r4=String(t.get('bar4_value')==null?'':t.get('bar4_value'));}catch(ignoreR4){}sendChat(SCRIPT,'/w gm <b>'+esc(t.get('name')||t.id)+'</b>: полёт <b>'+f+' фт</b> · местность <b>'+tr+' фт</b> · итоговая высота <b>'+tot+' фт</b> · raw bar3=<b>'+esc(r3||'∅')+'</b> · raw bar4=<b>'+esc(r4||'∅')+'</b> · '+(f>0?'<b>ЛЕТИТ</b>':(tr<0?'<b>В ПРОПАСТИ</b>':(tr>0?'<b>НА ПОВЕРХНОСТИ</b>':'на земле')))+' · безопасное падение ≤ <b>'+fs.safeHeight+' фт</b> · размер '+esc(sp.label)+' · FALL сейчас '+esc(fs.formula)+' (лимит '+sp.capDice+'d6, ×'+sp.multiplier+').',null,{noarchive:true});});
        }catch(e){sendChat(SCRIPT,'/w gm <b>'+SCRIPT+'</b>: '+esc(e.message||e),null,{noarchive:true});}
    }

    function graphicChanged(token,prev){
