        // trigger falling damage. Merely editing bar3 while such a condition is
        // already present must never cause damage.
        if(cause)return scheduleFall(token,cause,'состояние',h);
        // Prone does not drop the creature all the way to the ground. It halves
        // current altitude once, only when the condition is newly applied.
        if(!recordHasCondition(before,PRONE_KEY)&&recordHasCondition(after,PRONE_KEY)){
            var next=Math.floor(h/2);
            writeTokenBarNumber(token,3,next);syncMarker(token);
            gmFall('<b>'+esc(token.get('name')||token.id)+'</b>: Сбит с ног — высота '+h+' → <b>'+next+' фт</b>.');
            return true;
        }
        return false;
    }
    function enforceActiveCondition(token){
