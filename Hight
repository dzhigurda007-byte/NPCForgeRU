    function ensureGMMacros(){
        try{
            var defs=[
                {name:Array(41).join('\u200b')+'FALL',plain:'FALL',action:'!ad5height fall',token:true},
                {name:'AREA',action:'!ad5env create ?{Форма|Круг,circle|Квадрат,square} ?{Размер / радиус (фт)|20} ?{Тип|ФИЗ,phys|ЗАСЛОУ,zaslow|ЗАСХАЙ,zashigh|СОЛИД,solid} ?{Высота (фт)|5}',token:false},
                {name:'AREA HEIGHT',action:'!ad5env set-height ?{Новая высота области (фт)|5}',token:false}
            ];
            findObjs({_type:'player'}).forEach(function(pl){
                if(!playerIsGM(pl.id))return;
                defs.forEach(function(def){
                    var owned=findObjs({_type:'macro'}).filter(function(m){return String(m.get('_playerid')||m.get('playerid')||'')===String(pl.id)&&(String(m.get('action')||'').trim()===def.action||String(m.get('name')||'').replace(/^\u200b+/,'')===String(def.plain||def.name).replace(/^\u200b+/,''));});
                    var macro=owned[0],props={name:def.name,action:def.action,istokenaction:!!def.token,visibleto:''};
                    if(macro){var patch={},changed=false;Object.keys(props).forEach(function(k){if(String(macro.get(k)==null?'':macro.get(k))!==String(props[k]==null?'':props[k])){patch[k]=props[k];changed=true;}});if(changed)macro.set(patch);}
                    else createObj('macro',{name:def.name,playerid:pl.id,action:def.action,istokenaction:!!def.token,visibleto:''});
                    owned.slice(1).forEach(function(m){try{m.remove();}catch(ignoreDup){}});
                });
            });
        }catch(e){gmFall('<b>GM macros:</b> '+esc(e.message||e));}
    }
    function ensureFallMacro(){ensureGMMacros();}

