        return hasPlayer(c?c.get('controlledby'):token.get('controlledby'))||!!(original&&hasPlayer(original.get('controlledby')));
    }
    function side(token){return green(token)||controlled(token)?'players':'npcs';}
    function sourceToken(source){
        source=source||{};
        return getObj('graphic',String(source.sourceToken||source.source||''));
    }
    function sourceSide(source){
        source=source||{};
        var t=sourceToken(source);
        if(t)return side(t);
        var c=getObj('character',source.actor||'');return c&&hasPlayer(c.get('controlledby'))?'players':'npcs';
    }
    function targetModeText(value){
        var text=String(value==null?'':value)
            .replace(/<br\s*\/?>/gi,' ')
            .replace(/<[^>]*>/g,' ')
            .replace(/&nbsp;|&#160;/gi,' ')
            .replace(/[‐‑‒–—―]/g,'-')
            .replace(/\s+/g,' ')
            .trim().toLowerCase().replace(/ё/g,'е');
        if(!text)return 'default';

        // Explicit creature allegiance wording has priority.
        if(/(?:союзн[а-я]*|дружественн[а-я]*)\s+существ[а-я]*|союзник[а-я]*|(?:allied|friendly)\s+creatures?/.test(text))return 'allies';
        if(/враждебн[а-я]*\s+существ[а-я]*|противник[а-я]*|(?:hostile|enemy)\s+creatures?|enemies/.test(text))return 'enemies';
        if(/кажд[а-я]*\s+существ[а-я]*|все\s+существ[а-я]*|всех\s+существ[а-я]*|(?:each|every|all)\s+creatures?/.test(text))return 'all';
        return 'default';
    }
    function targetModeFor(value){
        if(typeof value==='string')return targetModeText(value);
        value=value&&typeof value==='object'?value:{};
        var explicit=String(value.targetMode||'').toLowerCase();
        if(['all','allies','enemies'].indexOf(explicit)>=0)return explicit;

        var targetCandidates=[
            value.target,value.spellTarget,value.targetText,
            value.f&&value.f.target,
            value.spellMeta&&value.spellMeta.target
