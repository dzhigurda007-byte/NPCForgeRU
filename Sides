    function copy(x){return JSON.parse(JSON.stringify(x));}
    function markers(token){return String(token&&token.get('statusmarkers')||'').split(',').map(function(s){return s.replace(/@\d+$/,'').trim();}).filter(Boolean);}
    function isKarmaMarker(tag){
        var raw=String(Campaign().get('token_markers')||''),aliases={'001-karma-on':true,'carma':true,'karma':true};
