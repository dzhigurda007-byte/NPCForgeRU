var AD5Sides=(function(){
    'use strict';
    var VERSION='1.1.0',markerRaw=null,karmaTags={},refreshPending={},refreshTimer=null;
    function root(){state.AD5Sides=state.AD5Sides||{};state.AD5Sides.karma=state.AD5Sides.karma||{};return state.AD5Sides;}
    function esc(s){return String(s).replace(/[&<>"'\r\n]/g,function(c){return '&#'+c.charCodeAt(0)+';';});}
