    }
    function green(token){return markers(token).indexOf('green')>=0;}
    function karma(token){return !!(token&&(root().karma[token.id]||markers(token).some(isKarmaMarker)));}
    function hasPlayer(ids){return String(ids||'').split(',').some(function(id){id=id.trim();return id==='all'||(!!getObj('player',id)&&!playerIsGM(id));});}
    function originalCharacter(token){
        if(!token)return null;
        try{if(typeof AD5Transform!=='undefined'&&AD5Transform.originalActorId)return getObj('character',AD5Transform.originalActorId(token));}catch(ignore){}
