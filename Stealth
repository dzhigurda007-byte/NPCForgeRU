    }
    function tokenForCharacter(msg,c){
        var selected=(msg.selected||[]).map(function(s){return getObj('graphic',s._id);}).filter(function(t){return t&&t.get('represents')===c.id;});
        if(selected.length===1)return selected[0];
        var page=partyPageId(),list=(findObjs({_type:'graphic',_subtype:'token',_pageid:page,layer:'objects',represents:c.id})||[]).filter(function(t){return combatToken(t,page);});
        return list.length===1?list[0]:null;
    }
    function sheetStealth(msg){
        if(['simple','npc'].indexOf(String(msg.rolltemplate||''))<0)return false;
        var f=fields(msg.content);if(!/(?:^|\s)(?:stealth|скрытност[а-яё]*)(?:\s|$)/.test(norm(f.rname||f.name||'').replace(/\bu$/,'')))return false;
        var c=sheetCharacter(msg,f);if(!c)return false;
        if(!controls(msg.playerid,c.id))return false;
        var t=tokenForCharacter(msg,c);
        if(!t){whisper(msg.playerid,'Скрытность: не найден единственный токен «'+esc(c.get('name'))+'» на активной карте. Выделите токен и бросьте снова или нажмите кнопку токена «'+ABILITY_NAME+'».');return true;}
        if(side(t)!=='players')return false;
        var r1=inlineTotal(msg,f.r1);if(r1===null)return false;
        var total=r1,detail='';
        if(active(f,'advantage')||active(f,'disadvantage')){
            var r2=inlineTotal(msg,f.r2);
            if(r2!==null){total=active(f,'advantage')?Math.max(r1,r2):Math.min(r1,r2);detail=r1+' / '+r2+(active(f,'advantage')?' (преим.)':' (помеха)');}
        }
        hide(t,total,msg.playerid,detail);
        return true;
    }
    // Атака или заклинание скрытого персонажа снимает скрытность.
    function attackReveal(msg){
        if(ATTACK_TEMPLATES.indexOf(String(msg.rolltemplate||''))<0)return;
        var hidden=root().hidden,ids=Object.keys(hidden);if(!ids.length)return;
        var f=fields(msg.content),c=sheetCharacter(msg,f),sourceId=String(f.ad5sourcetoken||'').trim();
        ids.forEach(function(id){
            var t=getObj('graphic',id);if(!t)return;
            if(id===sourceId||(c&&t.get('represents')===c.id))reveal(t,msg.rolltemplate==='spell'?'заклинание':'атака');
        });
    }

    // ---- Проверяет только NPC, чей сейчас ход (группа общей инициативы — вся).
    var lastTop='';
    function currentObservers(){
        var order;try{order=JSON.parse(Campaign().get('turnorder')||'[]')||[];}catch(e){return [];}
        var row=order.length?order[0]:null,t=row&&String(row.id||'')!=='-1'&&getObj('graphic',String(row.id||''));
        if(!t||!isObserver(t))return [];
        var observers=[t];
        try{
            if(typeof NPCGroupInitiative!=='undefined'&&NPCGroupInitiative&&typeof NPCGroupInitiative.groupKey==='function'){
                var key=NPCGroupInitiative.groupKey(t);
                observers=npcObservers(t.get('_pageid')).filter(function(o){return NPCGroupInitiative.groupKey(o)===key;});
                if(!observers.length)observers=[t];
            }
        }catch(ignore){}
        return observers;
    }
    function turnChanged(){
        var order;try{order=JSON.parse(Campaign().get('turnorder')||'[]')||[];}catch(e){return;}
        var row=order.length?order[0]:null,top=row?String(row.id||'')+'|'+String(row.custom||''):'';if(top===lastTop)return;lastTop=top;
        if(!row||!Object.keys(root().hidden).length)return;
        var observers=currentObservers();if(!observers.length)return;
        turnCheck(observers,'ход '+tokenName(observers[0]));
    }

    // ---- Кнопка токена «Скрытность» для листов игроков
    // Лист игрока: не NPC и либо под управлением игрока, либо с классом/уровнем.
    function isPcSheet(cid){
        if(attrValue(cid,'npc')==='1')return false;
        return playerControlled(cid)||!!(attrValue(cid,'class')||attrValue(cid,'base_level')||attrValue(cid,'cust_classname'));
    }
    function ensureButton(cid){
        if(!getObj('character',cid)||!isPcSheet(cid))return false;
        var list=(findObjs({_type:'ability',_characterid:cid,name:ABILITY_NAME})||[]);
        if(!list.length){createObj('ability',{characterid:cid,name:ABILITY_NAME,action:ABILITY_ACTION,istokenaction:true});return true;}
        var a=list[0];if(a.get('action')!==ABILITY_ACTION||!a.get('istokenaction'))a.set({action:ABILITY_ACTION,istokenaction:true});
        return false;
    }
    function ensureButtonsBatched(done){
        var ids=(findObjs({_type:'character'})||[]).map(function(c){return c.id;}),n=0;
        (function step(){
            var batch=ids.splice(0,10);
            batch.forEach(function(cid){try{if(ensureButton(cid))n++;}catch(e){log(SCRIPT+': '+e.message);}});
            if(ids.length)setTimeout(step,50);else if(done)done(n);
        })();
    }

    function selectedTokens(msg){return (msg.selected||[]).map(function(s){return getObj('graphic',s._id);}).filter(Boolean);}
    function revealCommand(msg,all){
        if(!playerIsGM(msg.playerid))throw new Error('Только мастер снимает скрытность вручную.');
        var tokens=all||!selectedTokens(msg).length?Object.keys(root().hidden).map(function(id){return getObj('graphic',id);}).filter(Boolean):selectedTokens(msg);
        var n=0;tokens.forEach(function(t){if(reveal(t,'снято мастером',null))n++;});
        if(!n)gm('Скрытых токенов '+(all||!selectedTokens(msg).length?'нет':'среди выделенных нет')+'.');
    }
    function status(){
        var ids=Object.keys(root().hidden),lines=['<b>'+SCRIPT+' '+VERSION+'</b> · маркер: '+esc(markerTag())];
        if(!ids.length)lines.push('Скрытых персонажей нет.');
        ids.forEach(function(id){
            var t=getObj('graphic',id),rec=root().hidden[id];if(!t)return;
            var watch=npcObservers(t.get('_pageid')).map(function(o){var pct=visionPercent(o,t),light=pct?lightFor(o,t):'';return esc(tokenName(o))+' '+(pct?pct+'%, '+LIGHT_LABEL[light]+' (пассивная '+passivePerception(o)+')':(wallsHide(o,t)?'за стеной':'—'));});
            lines.push(esc(tokenName(t))+': Сл '+rec.dc+(watch.length?' · '+watch.join(', '):''));
        });
        gm(lines.join('<br>'));
    }
    // ---- 1.4.0: показ поля зрения (проверка скрытности). Зоны рисуются на слое
    // мастера (видит только мастер) от центра токена: зелёная — 100% (до 20 фт),
    // жёлтая — 50% (до 60 фт), красная — 25% (показана до 120 фт), синяя — 5 фт со
    // спины. Границы даны для центра цели среднего размера (дистанция в скрипте —
    // от края до края). Лучи обрезаются стенами динамического освещения (AD5 Sight).
    // Рисунок обновляется при перемещении и повороте токена.
    var FOV_RAYS=48,FOV_FAR=120,FOV_TARGET_RADIUS=35,FOV_ZONES=[{feet:FOV_FAR,color:'#d0312d'},{feet:FRONT_HALF,color:'#e8c02f'},{feet:FRONT_FULL,color:'#2fa84f'}],FOV_BACK_COLOR='#2f6fdf';
    function fovStore(){var r=root();r.fov=r.fov&&typeof r.fov==='object'?r.fov:{};return r.fov;}
    function isJumpgate(){var c=Campaign(),v='';try{v=String(c.get('release')||c.get('_release')||'').toLowerCase();}catch(ignore){}return v==='jumpgate';}
    function clearFov(id){
        var st=fovStore();(st[id]||[]).forEach(function(ref){var o=getObj(ref.type,ref.id);if(o)o.remove();});delete st[id];
    }
    function rayLength(page,ox,oy,ux,uy,len){
        try{if(typeof AD5Sight!=='undefined'&&AD5Sight&&typeof AD5Sight.firstHit==='function'){var hit=AD5Sight.firstHit(page,ox,oy,ox+ux*len,oy+uy*len,false);if(hit&&hit.t>=0)return len*hit.t;}}catch(ignore){}
        return len;
    }
    function fovPolygon(page,cx,cy,dirAngle,spread,radius){
        var pts=[{x:cx,y:cy}],n=Math.max(8,Math.round(FOV_RAYS*spread/Math.PI));
        for(var i=0;i<=n;i++){var a=dirAngle-spread/2+spread*i/n,ux=Math.cos(a),uy=Math.sin(a),l=rayLength(page,cx,cy,ux,uy,radius);pts.push({x:cx+ux*l,y:cy+uy*l});}
        return pts;
    }
    function drawPolygon(page,pts,color){
        var minX=Infinity,minY=Infinity,maxX=-Infinity,maxY=-Infinity;
        pts.forEach(function(p){minX=Math.min(minX,p.x);minY=Math.min(minY,p.y);maxX=Math.max(maxX,p.x);maxY=Math.max(maxY,p.y);});
        var w=Math.max(1,maxX-minX),h=Math.max(1,maxY-minY),cx=(minX+maxX)/2,cy=(minY+maxY)/2,rel=pts.map(function(p){return [p.x-minX,p.y-minY];}),o;
        if(isJumpgate())o=createObj('pathv2',{pageid:page,layer:'gmlayer',shape:'pol',points:JSON.stringify(rel),x:cx,y:cy,rotation:0,stroke:color,stroke_width:2,fill:color,controlledby:'',fadeOnOverlap:false,renderAsScenery:false,baseOpacity:1});
        else{var cmd=rel.map(function(p,i){return [i?'L':'M',p[0],p[1]];});cmd.push(['L',rel[0][0],rel[0][1]]);
            o=createObj('path',{_pageid:page,layer:'gmlayer',_path:JSON.stringify(cmd),width:w,height:h,left:cx,top:cy,rotation:0,scaleX:1,scaleY:1,stroke:color,stroke_width:2,fill:color,controlledby:''});}
        return o?{type:o.get('_type')||(isJumpgate()?'pathv2':'path'),id:o.id}:null;
    }
    function drawFov(t){
        clearFov(t.id);if(!isToken(t))return;
        var page=t.get('_pageid'),ppf=pxPerFoot(page),cx=Number(t.get('left')),cy=Number(t.get('top')),ro=radius(t),f=facing(t),dir=Math.atan2(f.y,f.x),refs=[];
        FOV_ZONES.forEach(function(z){var r=drawPolygon(page,fovPolygon(page,cx,cy,dir,Math.PI,ro+z.feet*ppf+FOV_TARGET_RADIUS),z.color);if(r)refs.push(r);});
        var back=drawPolygon(page,fovPolygon(page,cx,cy,dir+Math.PI,Math.PI,ro+BACK_FEET*ppf+FOV_TARGET_RADIUS),FOV_BACK_COLOR);if(back)refs.push(back);
        fovStore()[t.id]=refs;
    }
    function fovCommand(msg,mode){
        var sel=(msg.selected||[]).map(function(x){return getObj('graphic',x._id);}).filter(isToken),st=fovStore();
        if(mode==='clear'||(mode==='off'&&!sel.length)){Object.keys(st).forEach(clearFov);gm('Поле зрения скрыто у всех токенов.');return;}
        if(mode==='off'){sel.forEach(function(t){clearFov(t.id);});gm('Поле зрения скрыто: '+sel.length+'.');return;}
        var list=sel;
        if(mode==='all'||!list.length){var page=Campaign().get('playerpageid');list=(findObjs({_type:'graphic',_subtype:'token',_pageid:page,layer:'objects'})||[]).filter(function(t){return isToken(t)&&side(t)==='npcs';});}
        list.forEach(drawFov);
        gm('Поле зрения на слое мастера: '+list.length+' ('+list.map(function(t){return esc(tokenName(t));}).join(', ')+'). Зелёная зона — 100% (20 фт), жёлтая — 50% (60 фт), красная — 25%, синяя — со спины 5 фт. Обновляется при перемещении и повороте; убрать: <code>!ad5stealth fov off</code>.');
    }
    function fovChanged(t,prev){
        if(!fovStore()[t.id]||!prev)return;
        if(['left','top','rotation','fliph','flipv','width','height','_pageid'].some(function(k){return String(prev[k])!==String(t.get(k));}))drawFov(t);
    }
    var FOV_MACRO='Поле-зрения';
    function ensureFovMacro(){
        (findObjs({_type:'player'})||[]).filter(function(p){return playerIsGM(p.id);}).forEach(function(p){
            var action='!ad5stealth fov ?{Поле зрения|Выделенные (или все NPC),on|Все NPC на карте,all|Убрать у выделенных,off|Убрать все,clear}';
            var m=(findObjs({_type:'macro',playerid:p.id,name:FOV_MACRO})||[])[0];
            if(!m)createObj('macro',{playerid:p.id,name:FOV_MACRO,action:action,visibleto:'',istokenaction:true});
            else if(m.get('action')!==action)m.set('action',action);
        });
    }

    function command(msg){
        var content=String(msg.content||'').trim();
        if(/^!снять-скрытность(?:\s|$)/i.test(content)){revealCommand(msg,/\sall\b|\sвсе\b/i.test(content));return;}
        var args=content.split(/\s+/),sub=String(args[1]||'status').toLowerCase();
        if(sub==='roll'){rollCommand(msg,args);return;}
        if(!playerIsGM(msg.playerid))throw new Error('Команда доступна мастеру.');
        if(sub==='reveal'||sub==='off')revealCommand(msg,String(args[2]||'').toLowerCase()==='all');
        else if(sub==='check'){var obs=currentObservers();if(!obs.length)gm('Сейчас не ход NPC.');else if(!turnCheck(obs,'проверка мастера, ход '+tokenName(obs[0])))gm('В поле зрения NPC текущего хода скрытых нет.');}
        else if(sub==='marker'){var name=args.slice(2).join(' ').trim();root().marker=resolveMarker(name);gm('Маркер скрытности: <b>'+esc(markerTag())+'</b>.');}
        else if(sub==='markers')gm(markerList(args.slice(2).join(' ')));
        else if(sub==='fov')fovCommand(msg,String(args[2]||'on').toLowerCase());
        else if(sub==='buttons')ensureButtonsBatched(function(n){gm('Кнопка «'+ABILITY_NAME+'» добавлена листам игроков: '+n+'.');});
        else status();
    }

    on('ready',function(){
        root();
        try{var o=JSON.parse(Campaign().get('turnorder')||'[]')||[];lastTop=o.length?String(o[0].id||'')+'|'+String(o[0].custom||''):'';}catch(ignore){}
        (function reconcile(attempt){
            var missing=Object.keys(root().hidden).filter(function(id){return !getObj('graphic',id);});
            if(!missing.length)return;
            if(attempt+1<READY_RETRY_DELAYS.length){setTimeout(function(){reconcile(attempt+1);},READY_RETRY_DELAYS[attempt+1]-(attempt>=0?READY_RETRY_DELAYS[attempt]:0));return;}
            missing.forEach(function(id){delete root().hidden[id];});
            log(SCRIPT+': сняты записи скрытности без токена: '+missing.length+'.');
        })(-1);
        on('chat:message',function(msg){
            try{
                if(msg.type==='api'){if(/^!(?:ad5stealth|снять-скрытность)(?:\s|$)/i.test(msg.content||''))command(msg);return;}
                if(!msg.playerid||msg.playerid==='API'||!msg.rolltemplate)return;
                if(sheetStealth(msg))return;
                attackReveal(msg);
            }catch(e){whisper(msg.playerid,esc(e.message||e));}
        });
        on('change:campaign:turnorder',function(){try{turnChanged();}catch(e){log(SCRIPT+': '+e.message);}});
        on('destroy:graphic',function(t){delete root().hidden[t.id];if(fovStore()[t.id])clearFov(t.id);});
        on('change:graphic',function(t,prev){try{fovChanged(t,prev);}catch(e){log(SCRIPT+': поле зрения — '+e.message);}});
        try{ensureFovMacro();}catch(e){log(SCRIPT+': макрос поля зрения — '+e.message);}
        on('add:character',function(c){var cid=c.id;setTimeout(function(){try{ensureButton(cid);}catch(ignore){}},3000);});
        ensureButtonsBatched(function(n){log(SCRIPT+' '+VERSION+' ready. Новых кнопок «'+ABILITY_NAME+'»: '+n+'.');});
        gm('<b>'+SCRIPT+' '+VERSION+'</b> запущен. Маркер скрытности: <b>'+esc(markerTag())+'</b> (список: <code>!ad5stealth markers</code>). Снять скрытность: <code>!снять-скрытность</code>.');
    });
    return {version:VERSION,canSee:canSee,visionPercent:visionPercent,passivePerception:passivePerception,isHidden:function(t){return !!hiddenRec(typeof t==='string'?getObj('graphic',t):t);},reveal:function(t,reason){return reveal(typeof t==='string'?getObj('graphic',t):t,reason||'снято модулем');},check:function(){var o=currentObservers();return o.length?turnCheck(o,'проверка модуля'):0;}};
}());

}
