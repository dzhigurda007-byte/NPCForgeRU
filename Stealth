        (function step(){
            ids.splice(0,10).forEach(function(cid){try{if(ensureAlertButton(cid))n++;}catch(e){log(SCRIPT+': '+e.message);}});
            if(ids.length)setTimeout(step,50);else if(done)done(n);
        })();
