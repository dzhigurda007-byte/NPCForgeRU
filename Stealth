    function ensureButtonsBatched(done){
        var ids=(findObjs({_type:'character'})||[]).map(function(c){return c.id;}),n=0;
        (function step(){
            var batch=ids.splice(0,10);
            batch.forEach(function(cid){try{if(ensureButton(cid))n++;}catch(e){log(SCRIPT+': '+e.message);}});
            if(ids.length)setTimeout(step,50);else if(done)done(n);
        })();
    }

    function selectedTokens(msg){return (msg.selected||[]).map(function(s){return getObj('graphic',s._id);}).filter(Boolean);}
    function revealCommand(msg,all){
        if(!playerIsGM(msg.playerid))throw new Error('Только мастер снимает скрытность вручную.');
        var tokens=all||!selectedTokens(msg).length?Object.keys(root().hidden).map(function(id){return getObj('graphic',id);}).filter(Boolean):selectedTokens(msg);
        var n=0;tokens.forEach(function(t){if(reveal(t,'снято мастером',null))n++;});
        if(!n)gm('Скрытых токенов '+(all||!selectedTokens(msg).length?'нет':'среди выделенных нет')+'.');
    }
    function status(){
        var r=root(),ids=Object.keys(r.hidden),balanced=r.mode==='balanced',lines=['<b>'+SCRIPT+' '+VERSION+'</b> · режим: '+(balanced?'сбалансированный':'строгий')+' · маркер: '+esc(markerTag())+' · настороже: '+esc(alertMarker())];
        var alertNames=Object.keys(r.alert).map(function(id){return getObj('graphic',id);}).filter(Boolean).map(tokenName);
        lines.push('Настороже: '+(alertNames.length?esc(alertNames.join(', ')):'никто'));
        if(!ids.length)lines.push('Скрытых персонажей нет.');
        ids.forEach(function(id){
            var t=getObj('graphic',id),rec=r.hidden[id];if(!t)return;
            var watch=npcObservers(t.get('_pageid')).map(function(o){
                if(balanced){var sp=sightProfile(o,t);if(!sp)return esc(tokenName(o))+' — '+(wallsHide(o,t)?'за стеной':'не видит');
                    return esc(tokenName(o))+' '+(sp.inPlain?'<b>на виду</b>':profileText(sp)+', '+(isAlert(o)?'настороже, бросок':'пассивная '+(passivePerception(o)-sp.penalty)));}
                var pct=visionPercent(o,t),light=pct?lightFor(o,t):'';return esc(tokenName(o))+' '+(pct?pct+'%, '+LIGHT_LABEL[light]+' (пассивная '+passivePerception(o)+')':(wallsHide(o,t)?'за стеной':'—'));});
            lines.push(esc(tokenName(t))+': Сл '+rec.dc+(watch.length?' · '+watch.join(', '):''));
        });
