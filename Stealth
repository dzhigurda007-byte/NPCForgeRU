    // Свет, который несёт сам персонаж (факел, «Свет» на токене), освещает его.
    var DIM_PLAIN=20,DIM_FAR=60;
    function brightRules(){var b=root().bright||{};return {plain:Number(b.plain)>=0?Number(b.plain):60,far:Number(b.far)>0?Number(b.far):120};}
    function zoneRule(light,gap){
        var e=1e-6;
        if(light==='bright'){var b=brightRules();if(gap<=b.plain+e)return {auto:true,pen:0,dis:false,rollPen:0};return {auto:false,pen:0,dis:gap>b.far+e,rollPen:0};}
        if(gap<=DIM_PLAIN+e)return {auto:true,pen:0,dis:false,rollPen:0};
        if(gap<=DIM_FAR+e)return {auto:false,pen:5,dis:true,rollPen:0};
        return {auto:false,pen:10,dis:true,rollPen:5};
    }
    function sightProfile(observer,target){
        var info=visionInfo(observer,target),pct=info.pct;if(!pct)return null;
        var light=lightFor(observer,target);if(light==='dark')return null;
        var cover=coverFor(observer,target);if(cover.full)return null;
        var z=zoneRule(light,info.gap);
        return {pct:pct,gap:info.gap,light:light,cover:cover,penalty:z.pen+cover.bonus,rollDis:z.dis,rollPenalty:z.rollPen+cover.bonus,inPlain:z.auto&&cover.tier==='none'};
    }
    function profileText(sp){return Math.round(sp.gap)+' фт, '+(sp.light==='dim'?'полутень':'яркий свет')+(sp.cover.tier!=='none'?', '+sp.cover.label:'');}
    function balancedCheck(observer,target,dc){
        var sp=sightProfile(observer,target);if(!sp)return null;
        var passive=passivePerception(observer),eff=passive-sp.penalty;
        if(sp.inPlain)return {seen:true,total:null,text:profileText(sp)+' — <b>замечает без броска</b>'};
        if(!isAlert(observer))return {seen:eff>=dc,total:eff,text:profileText(sp)+', пассивная '+passive+(sp.penalty?' − '+sp.penalty:'')+' = <b>'+eff+'</b>'};
        var bonus=perceptionBonus(observer),a=randomInteger(20),b2=sp.rollDis?randomInteger(20):null,die=sp.rollDis?Math.min(a,b2):a,raw=die+bonus-sp.rollPenalty,total=Math.max(eff,raw);
        return {seen:total>=dc,total:total,text:profileText(sp)+', <b>настороже</b>: к20 '+(sp.rollDis?a+'/'+b2+' (помеха)':a)+(bonus>=0?' + ':' − ')+Math.abs(bonus)+(sp.rollPenalty?' − '+sp.rollPenalty:'')+' = '+(raw<eff?raw+' → не ниже пассивной: <b>'+total+'</b>':'<b>'+total+'</b>')};
    }
    // Кто видит персонажа «на виду» прямо сейчас (спрятаться нельзя).
    function plainWatchers(token){
        return npcObservers(token.get('_pageid')).filter(function(o){var sp=sightProfile(o,token);return sp&&sp.inPlain;});
    }

    // ---- Настороже / Тревога
    var ALERT_ABILITY='Настороже',ALERT_ACTION='!ad5stealth alert @{selected|token_id}';
    var ALERT_PRIORITY=[/alert/i,/aware/i,/vigil/i,/watch(?!ful)/i,/guard/i,/sentry/i];
    function alertMarker(){
        var r=root();if(r.alertMarker)return r.alertMarker;
        var list=campaignMarkers().filter(function(m){return !MARKERS_IN_USE.test(String(m.name||''))&&!/eye|stealth|hid/i.test(String(m.name||''));});
        for(var i=0;i<ALERT_PRIORITY.length;i++){var hit=list.filter(function(m){return ALERT_PRIORITY[i].test(String(m.name||''));})[0];if(hit)return String(hit.tag);}
        return 'sentry-gun';
    }
    function setAlert(t,on,why){
        if(!isToken(t))return false;var r=root(),was=!!r.alert[t.id];
        if(on===was)return false;
        if(on)r.alert[t.id]={time:Date.now(),why:String(why||'')};else delete r.alert[t.id];
        setMarker(t,alertMarker(),on);scheduleFovRefresh();return true;
    }
    // NPC, которые видят token (или его самого видит раскрытый персонаж), настораживаются.
    function alertWitnesses(token,why){
        var page=token.get('_pageid'),n=[];
        npcObservers(page).forEach(function(o){
            if(o.id===token.id||isAlert(o))return;
            var sees=false;try{sees=typeof AD5Sight!=='undefined'&&AD5Sight&&typeof AD5Sight.canSee==='function'?AD5Sight.canSee(o,token):visionPercent(o,token)>0;}catch(ignore){}
            if(sees&&lightFor(o,token)!=='dark'&&setAlert(o,true,why))n.push(tokenName(o));
        });
        return n;
    }
    function alertCommand(msg,args){
        if(!playerIsGM(msg.playerid))throw new Error('Команда доступна мастеру.');
        var ids=String(args[2]||'').trim(),mode=String(args[3]||'toggle').toLowerCase(),list=[];
        var t=ids&&getObj('graphic',ids);if(t)list=[t];else list=selectedTokens(msg).filter(isToken);
        if(!list.length)throw new Error('Выделите NPC.');
        var out=list.map(function(x){var on=mode==='on'?true:mode==='off'?false:!isAlert(x);setAlert(x,on,'мастер');return esc(tokenName(x))+': '+(on?'<b>настороже</b>':'спокоен');});
        gm('Настороженность — '+out.join(', ')+'.');
    }
    function alarmCommand(msg,mode){
        if(!playerIsGM(msg.playerid))throw new Error('Команда доступна мастеру.');
        var page=partyPageId(),list=npcObservers(page),on=mode!=='off',n=0;
        list.forEach(function(o){if(setAlert(o,on,'тревога'))n++;});
        gm(on?'<b>Тревога!</b> Настороже NPC на карте: '+list.length+(n<list.length?' (новых '+n+')':'')+'. Каждый свой ход они бросают Внимательность против скрытых персонажей.':'Отбой тревоги: NPC успокоены — '+n+'.');
    }
    function isNpcSheet(cid){return attrValue(cid,'npc')==='1'&&!playerControlled(cid);}
    function ensureAlertButton(cid){
        if(!getObj('character',cid)||!isNpcSheet(cid))return false;
        var list=findObjs({_type:'ability',_characterid:cid,name:ALERT_ABILITY})||[];
        if(!list.length){createObj('ability',{characterid:cid,name:ALERT_ABILITY,action:ALERT_ACTION,istokenaction:true});return true;}
        if(list[0].get('action')!==ALERT_ACTION||!list[0].get('istokenaction'))list[0].set({action:ALERT_ACTION,istokenaction:true});
        return false;
    }
    var ALARM_MACRO='Тревога',ALARM_ACTION='!ad5stealth alarm ?{Тревога|Поднять тревогу,on|Отбой,off}';
    function ensureGmMacro(name,action){
        (findObjs({_type:'player'})||[]).filter(function(p){return playerIsGM(p.id);}).forEach(function(p){
            var m=(findObjs({_type:'macro',playerid:p.id,name:name})||[])[0];
            if(!m)createObj('macro',{playerid:p.id,name:name,action:action,visibleto:'',istokenaction:true});
            else if(m.get('action')!==action)m.set('action',action);
        });
    }

    // ---- Последнее известное место (слой мастера)
    // 1.8.3: метка — серое кольцо-фигура на слое мастера (текст, созданный скриптом,
    // ронял отрисовку стола в Jumpgate: «Что-то пошло не так»).
    function dropGhost(token){
        clearGhost(token.id);
        var cx=Number(token.get('left')),cy=Number(token.get('top')),rr=radius(token)*0.8,pts=[];
        for(var i=0;i<=24;i++){var a=Math.PI*2*i/24;pts.push({x:cx+Math.cos(a)*rr,y:cy+Math.sin(a)*rr});}
        var ref=drawPolygon(token.get('_pageid'),pts,'#9aa6b2',{fill:'transparent',width:3});
        if(ref){var r=root();r.ghosts=r.ghosts||{};r.ghosts[token.id]=ref;}
    }
    function clearGhost(id){
        var r=root(),g=r.ghosts&&r.ghosts[id];if(!g)return;
        var refs=typeof g==='string'?[{type:'text',id:g}]:[g];
        refs.forEach(function(ref){var o=getObj(ref.type,ref.id);if(o)o.remove();});
        delete r.ghosts[id];
    }

    // ---- Скрытность
    function hiddenRec(t){return t?root().hidden[t.id]||null:null;}
    function hide(token,total,pid,detail){
        if(root().mode==='balanced'){
            var watchers=plainWatchers(token);
            if(watchers.length){whisper(pid,'<b>'+esc(tokenName(token))+'</b> не может спрятаться: на виду у '+esc(watchers.map(tokenName).join(', '))+' (яркий свет, без укрытия, ближе '+brightRules().plain+' фт). Нужны укрытие, тень или выход из поля зрения.');return false;}
        }
        var r=root(),tag=markerTag(),prev=r.hidden[token.id];
        r.hidden[token.id]={dc:total,pid:pid||'',time:Date.now(),marker:tag,markerWasPresent:prev?!!prev.markerWasPresent:hasMarker(token,tag)};
        setMarker(token,tag,true);
        try{dropGhost(token);}catch(ignoreGhost){}
        scheduleFovRefresh();
        whisper(pid,'<b>'+esc(tokenName(token))+'</b> скрывается: Скрытность <b>'+total+'</b>'+(detail?' ('+esc(detail)+')':'')+'. NPC проверяют Внимательность в свой ход, если персонаж у них в поле зрения.');
    }
    // Имя персонажа: лист, который представляет токен, иначе имя токена.
    function characterNameFor(token){
        var c=getObj('character',String(token.get('represents')||'')),n=c&&String(c.get('name')||'').trim();
        return n||tokenName(token);
    }
    function reveal(token,reason,pid,gmDetail){
        var r=root(),rec=r.hidden[token.id];if(!rec)return false;
        delete r.hidden[token.id];clearGhost(token.id);scheduleFovRefresh();
        if(!rec.markerWasPresent)setMarker(token,rec.marker||markerTag(),false);
        var text='<b>'+esc(tokenName(token))+'</b> больше не скрыт — '+esc(reason)+'.';
        // 1.8.2: обнаружение — сообщение всем в чат с именем персонажа: «Зувара, тебя заметили!»
        if(/^замечен/.test(String(reason||'')))sendChat(SCRIPT,'<b>'+esc(characterNameFor(token))+', тебя заметили!</b>');
        pid=pid||rec.pid;
        if(pid&&pid!=='API'&&!playerIsGM(pid)){var p=getObj('player',pid),name=p?String(p.get('_displayname')||'').replace(/["\r\n]/g,''):'';if(name)sendChat(SCRIPT,'/w "'+name+'" '+text,null,{noarchive:true});}
        gm(text+(gmDetail?' '+esc(gmDetail):''));
        return true;
    }
    // Ход NPC: каждый наблюдатель бросает Внимательность против каждого
    // скрытого персонажа в своём поле зрения. Нет никого в поле зрения — нет броска.
    function turnCheck(observers,why){
        var lines=[];
        Object.keys(root().hidden).forEach(function(id){
            var token=getObj('graphic',id);if(!token)return;
            var rec=hiddenRec(token),page=token.get('_pageid');
            observers.forEach(function(o){
                if(!hiddenRec(token)||o.id===token.id||o.get('_pageid')!==page)return;
                if(root().mode==='balanced'){
                    var b=balancedCheck(o,token,rec.dc);if(!b)return;
                    lines.push(esc(tokenName(o))+' → '+esc(tokenName(token))+': '+b.text+' против Сл '+rec.dc+' — '+(b.seen?'<b>заметил</b>':'не заметил'));
                    if(b.seen){
                        reveal(token,'замечен: '+tokenName(o),rec.pid,b.total===null?'(на виду)':'(Внимательность '+b.total+' ≥ Сл '+rec.dc+')');
                        var al=alertWitnesses(o,'союзник заметил '+tokenName(token)).concat(alertWitnesses(token,'видит '+tokenName(token)));
                        setAlert(o,true,'заметил '+tokenName(token));
                        if(al.length)lines.push('Настороже: '+esc(al.filter(function(x,i){return al.indexOf(x)===i;}).join(', ')));
                    }
                    return;
                }
                var r=perceptionRoll(o,token);if(!r)return;
                var seen=r.total>=rec.dc;
                lines.push(esc(tokenName(o))+' → '+esc(tokenName(token))+': '+r.text+' против Сл '+rec.dc+' — '+(seen?'<b>заметил</b>':'не заметил'));
                if(seen)reveal(token,'замечен: '+tokenName(o),rec.pid,'(Внимательность '+r.total+' ≥ Сл '+rec.dc+', зрение '+r.pct+'%)');
            });
        });
        if(lines.length)gm('<b>Скрытность</b> · '+esc(why)+'<br>'+lines.join('<br>'));
        return lines.length;
    }
    // NPC «видит» цель, если она не скрыта. Механика зрения действует только при скрытности.
    function canSee(observer,target){
        if(!target)return true;
        var t=typeof target==='string'?getObj('graphic',target):target;
        if(!t||!hiddenRec(t))return true;
        var o=typeof observer==='string'?getObj('graphic',observer):observer;
        return !(o&&isObserver(o));
    }

    // ---- Бросок кнопкой токена
    function controls(pid,cid){
        if(playerIsGM(pid))return true;var c=getObj('character',cid);if(!c)return false;
        return String(c.get('controlledby')||'').split(',').some(function(id){id=id.trim();return id==='all'||id===pid;});
    }
    function stealthBonus(cid){
        var b=numberOr(attrValue(cid,'stealth_bonus'),NaN);if(Number.isFinite(b))return b;
        b=numberOr(attrValue(cid,'npc_stealth'),NaN);if(Number.isFinite(b))return b;
        return numberOr(attrValue(cid,'dexterity_mod'),0);
    }
    function rollCommand(msg,args){
        var t=getObj('graphic',String(args[2]||'')||(msg.selected&&msg.selected[0]&&msg.selected[0]._id)||'');
        if(!combatToken(t))throw new Error('Выделите токен персонажа.');
        var cid=String(t.get('represents')||'');if(!controls(msg.playerid,cid))throw new Error('Это не ваш персонаж.');
        if(side(t)!=='players')throw new Error('Скрытность этой механики — для персонажей игроков.');
        var mode=String(args[3]||'normal').toLowerCase(),bonus=stealthBonus(cid),a=randomInteger(20),b=mode==='normal'?null:randomInteger(20),die=a;
        if(mode==='adv')die=Math.max(a,b);else if(mode==='dis')die=Math.min(a,b);
        var total=die+bonus,detail='к20 '+(mode==='normal'?a:a+' / '+b+(mode==='adv'?' (преим.)':' (помеха)'))+(bonus>=0?' + ':' − ')+Math.abs(bonus);
        hide(t,total,msg.playerid,detail);
    }

    // ---- Бросок из листа: шаблон simple/npc с названием «Скрытность / Stealth».
    function fields(content){
        var f={},re=/\{\{\s*([\w-]+)\s*=([\s\S]*?)\}\}(?=\s*(?:\{\{|$))/g,m;
        while((m=re.exec(String(content||''))))f[m[1].toLowerCase()]=m[2].trim();
        return f;
    }
    function active(f,k){var v=f[k];return v!==undefined&&String(v).trim()!==''&&!/^(?:0|false|off|no|нет)$/i.test(String(v).trim());}
    function inlineTotal(msg,ref){
        var m=/^\$\[\[(\d+)\]\]$/.exec(String(ref||'').trim());if(!m)return null;
        var r=(msg.inlinerolls||[])[Number(m[1])],n=r&&r.results&&Number(r.results.total);
        return Number.isFinite(n)?n:null;
    }
    function sheetCharacter(msg,f){
        var name=String(f.charname||'').trim(),list=name?findObjs({_type:'character',name:name}):[];
        if(list.length===1)return list[0];
        var who=String(msg.who||'').replace(/\s+\(GM\)$/,'').trim();
        list=who?findObjs({_type:'character',name:who}):[];
        return list.length===1?list[0]:null;
    }
    function tokenForCharacter(msg,c){
        var selected=(msg.selected||[]).map(function(s){return getObj('graphic',s._id);}).filter(function(t){return t&&t.get('represents')===c.id;});
        if(selected.length===1)return selected[0];
        var page=partyPageId(),list=(findObjs({_type:'graphic',_subtype:'token',_pageid:page,layer:'objects',represents:c.id})||[]).filter(function(t){return combatToken(t,page);});
        return list.length===1?list[0]:null;
    }
    function sheetStealth(msg){
        if(['simple','npc'].indexOf(String(msg.rolltemplate||''))<0)return false;
        var f=fields(msg.content);if(!/(?:^|\s)(?:stealth|скрытност[а-яё]*)(?:\s|$)/.test(norm(f.rname||f.name||'').replace(/\bu$/,'')))return false;
        var c=sheetCharacter(msg,f);if(!c)return false;
        if(!controls(msg.playerid,c.id))return false;
        var t=tokenForCharacter(msg,c);
        if(!t){whisper(msg.playerid,'Скрытность: не найден единственный токен «'+esc(c.get('name'))+'» на активной карте. Выделите токен и бросьте снова или нажмите кнопку токена «'+ABILITY_NAME+'».');return true;}
        if(side(t)!=='players')return false;
        var r1=inlineTotal(msg,f.r1);if(r1===null)return false;
        var total=r1,detail='';
        if(active(f,'advantage')||active(f,'disadvantage')){
            var r2=inlineTotal(msg,f.r2);
            if(r2!==null){total=active(f,'advantage')?Math.max(r1,r2):Math.min(r1,r2);detail=r1+' / '+r2+(active(f,'advantage')?' (преим.)':' (помеха)');}
        }
        hide(t,total,msg.playerid,detail);
        return true;
    }
    // Атака или заклинание скрытого персонажа снимает скрытность.
    function attackReveal(msg){
        if(ATTACK_TEMPLATES.indexOf(String(msg.rolltemplate||''))<0)return;
        var hidden=root().hidden,ids=Object.keys(hidden);if(!ids.length)return;
        var f=fields(msg.content),c=sheetCharacter(msg,f),sourceId=String(f.ad5sourcetoken||'').trim();
        ids.forEach(function(id){
            var t=getObj('graphic',id);if(!t)return;
            if(id===sourceId||(c&&t.get('represents')===c.id)){
                if(reveal(t,msg.rolltemplate==='spell'?'заклинание':'атака')&&root().mode==='balanced'){var al=alertWitnesses(t,'атака из скрытности');if(al.length)gm('Настороже после атаки: '+esc(al.join(', '))+'.');}
            }
        });
    }

    // ---- Проверяет только NPC, чей сейчас ход (группа общей инициативы — вся).
    var lastTop='';
    function currentObservers(){
        var order;try{order=JSON.parse(Campaign().get('turnorder')||'[]')||[];}catch(e){return [];}
        var row=order.length?order[0]:null,t=row&&String(row.id||'')!=='-1'&&getObj('graphic',String(row.id||''));
        if(!t||!isObserver(t))return [];
        var observers=[t];
        try{
            if(typeof NPCGroupInitiative!=='undefined'&&NPCGroupInitiative&&typeof NPCGroupInitiative.groupKey==='function'){
                var key=NPCGroupInitiative.groupKey(t);
                observers=npcObservers(t.get('_pageid')).filter(function(o){return NPCGroupInitiative.groupKey(o)===key;});
                if(!observers.length)observers=[t];
            }
        }catch(ignore){}
        return observers;
    }
    function turnChanged(){
        var order;try{order=JSON.parse(Campaign().get('turnorder')||'[]')||[];}catch(e){return;}
        var row=order.length?order[0]:null,top=row?String(row.id||'')+'|'+String(row.custom||''):'';if(top===lastTop)return;lastTop=top;
        if(!row||!Object.keys(root().hidden).length)return;
        var observers=currentObservers();if(!observers.length)return;
        turnCheck(observers,'ход '+tokenName(observers[0]));
    }

    // ---- Кнопка токена «Скрытность» для листов игроков
    // Лист игрока: не NPC и либо под управлением игрока, либо с классом/уровнем.
    function isPcSheet(cid){
        if(attrValue(cid,'npc')==='1')return false;
        return playerControlled(cid)||!!(attrValue(cid,'class')||attrValue(cid,'base_level')||attrValue(cid,'cust_classname'));
    }
    function ensureButton(cid){
