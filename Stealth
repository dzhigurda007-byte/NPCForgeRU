    }
    // ---- 1.4.0: показ поля зрения (проверка скрытности). Зоны рисуются на слое
    // мастера (видит только мастер) от центра токена: зелёная — 100% (до 20 фт),
    // жёлтая — 50% (до 60 фт), красная — 25% (показана до 120 фт), синяя — 5 фт со
    // спины. Границы даны для центра цели среднего размера (дистанция в скрипте —
    // от края до края). Лучи обрезаются стенами динамического освещения (AD5 Sight).
    // Рисунок обновляется при перемещении и повороте токена.
    var FOV_RAYS=48,FOV_TARGET_RADIUS=35,FOV_BACK_COLOR='#2f6fdf';
    function fovStore(){var r=root();r.fov=r.fov&&typeof r.fov==='object'?r.fov:{};return r.fov;}
    function isJumpgate(){var c=Campaign(),v='';try{v=String(c.get('release')||c.get('_release')||'').toLowerCase();}catch(ignore){}return v==='jumpgate';}
    function clearFov(id){
        var st=fovStore();(st[id]||[]).forEach(function(ref){var o=getObj(ref.type,ref.id);if(o)o.remove();});delete st[id];
    }
    function rayLength(page,ox,oy,ux,uy,len){
        try{if(typeof AD5Sight!=='undefined'&&AD5Sight&&typeof AD5Sight.firstHit==='function'){var hit=AD5Sight.firstHit(page,ox,oy,ox+ux*len,oy+uy*len,false);if(hit&&hit.t>=0)return len*hit.t;}}catch(ignore){}
        return len;
    }
    function fovPolygon(page,cx,cy,dirAngle,spread,radius){
        var pts=[{x:cx,y:cy}],n=Math.max(8,Math.round(FOV_RAYS*spread/Math.PI));
        for(var i=0;i<=n;i++){var a=dirAngle-spread/2+spread*i/n,ux=Math.cos(a),uy=Math.sin(a),l=rayLength(page,cx,cy,ux,uy,radius);pts.push({x:cx+ux*l,y:cy+uy*l});}
        return pts;
    }
    function drawPolygon(page,pts,color,opts){
        opts=opts||{};
        var minX=Infinity,minY=Infinity,maxX=-Infinity,maxY=-Infinity;
        pts.forEach(function(p){minX=Math.min(minX,p.x);minY=Math.min(minY,p.y);maxX=Math.max(maxX,p.x);maxY=Math.max(maxY,p.y);});
        var w=Math.max(1,maxX-minX),h=Math.max(1,maxY-minY),cx=(minX+maxX)/2,cy=(minY+maxY)/2,rel=pts.map(function(p){return [p.x-minX,p.y-minY];}),o;
        var fill=opts.fill===undefined?color:opts.fill,sw=opts.width||2,shape=opts.open?'free':'pol';
        if(isJumpgate())o=createObj('pathv2',{pageid:page,layer:'gmlayer',shape:shape,points:JSON.stringify(rel),x:cx,y:cy,rotation:0,stroke:color,stroke_width:sw,fill:fill,controlledby:'',fadeOnOverlap:false,renderAsScenery:false,baseOpacity:1});
        else{var cmd=rel.map(function(p,i){return [i?'L':'M',p[0],p[1]];});if(!opts.open)cmd.push(['L',rel[0][0],rel[0][1]]);
            o=createObj('path',{_pageid:page,layer:'gmlayer',_path:JSON.stringify(cmd),width:w,height:h,left:cx,top:cy,rotation:0,scaleX:1,scaleY:1,stroke:color,stroke_width:sw,fill:fill,controlledby:''});}
        return o?{type:o.get('_type')||(isJumpgate()?'pathv2':'path'),id:o.id}:null;
    }
    // 1.5.1: кроме зон — подпись NPC (пассивная, настороже, тёмное зрение), круг тёмного
    // зрения и линии к каждому персонажу на карте с решением по текущим правилам:
    // красная — заметит / на виду; жёлтая — решит бросок настороженного NPC; зелёная —
    // не заметит; синяя — видит открытого персонажа (подпись: какая Скрытность нужна);
    // серая — не видит (вне поля, стена, темнота, полное укрытие).
    var FOV_LINE={seen:'#ff2b2b',chance:'#ffb000',safe:'#22c55e',open:'#3b82f6',none:'#8a8a8a'};
    function drawText(page,x,y,text,color,size){
        // 1.8.3: в Jumpgate текст, созданный скриптом, может уронить отрисовку стола — подписи
        // поля зрения там не создаются (решения видны по цвету линий и в !ad5stealth status).
        if(isJumpgate())return null;
        var o=createObj('text',{pageid:page,layer:'gmlayer',left:x,top:y,text:String(text),font_size:size||14,color:color||'#ffffff',font_family:'Arial',controlledby:''});
        return o?{type:'text',id:o.id}:null;
    }
    function partyTokens(page){return (findObjs({_type:'graphic',_subtype:'token',_pageid:page,layer:'objects'})||[]).filter(function(t){return combatToken(t,page)&&side(t)==='players';});}
    function darkvisionFor(t){try{if(typeof AD5Sight!=='undefined'&&AD5Sight&&typeof AD5Sight.darkvisionFeet==='function')return Number(AD5Sight.darkvisionFeet(t))||0;}catch(ignore){}return 0;}
    function fovVerdict(o,pc){
        var rec=hiddenRec(pc),balanced=root().mode==='balanced';
        if(!visionPercent(o,pc))return {kind:'none',text:wallsHide(o,pc)?'стена':'вне поля зрения'};
        var light=lightFor(o,pc);if(light==='dark')return {kind:'none',text:'темнота'};
        var passive=passivePerception(o),bonus=perceptionBonus(o),alert=isAlert(o);
        if(balanced){
            var sp=sightProfile(o,pc);if(!sp)return {kind:'none',text:'полное укрытие'};
            var eff=passive-sp.penalty,info=profileText(sp)+', пасс '+eff;
            if(!rec)return sp.inPlain?{kind:'seen',text:'на виду — спрятаться нельзя'}:{kind:'open',text:info+' · спрятаться: Скрытность ≥ '+(eff+1)+(alert?' (настороже — бросок)':'')};
            if(sp.inPlain)return {kind:'seen',text:'на виду — заметит'};
            if(eff>=rec.dc)return {kind:'seen',text:info+' ≥ Сл '+rec.dc+' — заметит'};
            if(!alert)return {kind:'safe',text:info+' < Сл '+rec.dc+' — не заметит'};
            var need=Math.max(1,rec.dc-bonus+sp.rollPenalty),p1=Math.max(0,(21-need)/20),pr=Math.round((sp.rollDis?p1*p1:p1)*100);
            return need>20?{kind:'safe',text:info+', настороже: нужно '+need+' на к20 — не заметит'}:{kind:'chance',text:info+', настороже: к20'+(sp.rollDis?' с помехой':'')+' ≥ '+need+' ('+pr+'%)'};
        }
        var pct=visionPercent(o,pc),dis=pct<100||light==='dim',pen=pct<50?5:0;
        if(!rec)return {kind:'open',text:'зрение '+pct+'%'+(light==='dim'?', тусклый':'')+', пасс '+passive};
        if(passive>=rec.dc)return {kind:'seen',text:'пасс '+passive+' ≥ Сл '+rec.dc+' — заметит'};
        var n2=rec.dc-bonus+pen;
        return n2>20?{kind:'safe',text:'нужно '+n2+' на к20 — не заметит'}:{kind:'chance',text:'бросок'+(dis?' с помехой':'')+': к20 ≥ '+n2};
    }
    // 1.7.0: зоны по реальному свету. Поле перед NPC разбито на клетки по 10 фт: для
    // каждой — свет в ней для этого NPC (общий свет, источники света, тёмное зрение,
    // стены) и итог проверки цели среднего размера; одинаковые клетки ряда слиты.
    var FOV_CELL_FT=10,FOV_KIND_COLOR={plain:'#2fa84f',p0:'#e8c02f',p5:'#ef7d1a',p10:'#d0312d',p15:'#7a1f1f'};
    function cellKind(t,page,ppf,cx,cy,ro,f,px,py){
        var dx=px-cx,dy=py-cy,dist=Math.sqrt(dx*dx+dy*dy),gap=Math.max(0,dist-ro-FOV_TARGET_RADIUS)/ppf;
        if((dx*f.x+dy*f.y)<-FOV_TARGET_RADIUS)return null;
        try{if(typeof AD5Sight!=='undefined'&&AD5Sight&&AD5Sight.blocked&&AD5Sight.blocked(page,cx,cy,px,py))return null;}catch(ignore){}
        var light='bright';try{if(typeof AD5Sight!=='undefined'&&AD5Sight&&AD5Sight.illuminationAt)light=AD5Sight.illuminationAt(page,px,py,FOV_TARGET_RADIUS,t);}catch(ignore2){}
        if(light==='dark')return null;
        var z=zoneRule(light,gap);return z.auto?'plain':'p'+z.pen;
    }
    function drawLightZones(t,page,ppf,cx,cy,ro,f){
        var b=brightRules(),range=Math.max(b.far+30,FRONT_HALF+30),cell=FOV_CELL_FT*ppf,n=Math.ceil((ro+range*ppf)/cell),refs=[];
        for(var gy=-n;gy<=n;gy++){
            var run=null;
            var flush=function(){if(run){refs.push(drawPolygon(page,[{x:run.x0,y:run.y0},{x:run.x1,y:run.y0},{x:run.x1,y:run.y1},{x:run.x0,y:run.y1}],FOV_KIND_COLOR[run.kind],{width:1}));run=null;}};
            for(var gx=-n;gx<=n;gx++){
                var px=cx+gx*cell,py=cy+gy*cell,d=Math.sqrt(Math.pow(px-cx,2)+Math.pow(py-cy,2)),kind=d>ro+range*ppf?null:cellKind(t,page,ppf,cx,cy,ro,f,px,py);
                if(run&&run.kind===kind){run.x1=px+cell/2;continue;}
                flush();if(kind)run={kind:kind,x0:px-cell/2,x1:px+cell/2,y0:py-cell/2,y1:py+cell/2};
            }
            flush();
        }
        return refs;
    }
    function drawFov(t){
        clearFov(t.id);if(!isToken(t))return;
        var page=t.get('_pageid'),ppf=pxPerFoot(page),cx=Number(t.get('left')),cy=Number(t.get('top')),ro=radius(t),f=facing(t),dir=Math.atan2(f.y,f.x),refs=[];
        function keep(r){if(r)refs.push(r);}
        drawLightZones(t,page,ppf,cx,cy,ro,f).forEach(keep);
        [FRONT_FULL,FRONT_HALF].forEach(function(ft){keep(drawPolygon(page,fovPolygon(page,cx,cy,dir,Math.PI,ro+ft*ppf+FOV_TARGET_RADIUS),'#ffffff',{fill:'transparent',width:1}));});
        keep(drawPolygon(page,fovPolygon(page,cx,cy,dir+Math.PI,Math.PI,ro+BACK_FEET*ppf+FOV_TARGET_RADIUS),FOV_BACK_COLOR));
        var dv=darkvisionFor(t);
        if(dv>0){var ring=[],rr=ro+dv*ppf;for(var i=0;i<=48;i++){var a=Math.PI*2*i/48;ring.push({x:cx+Math.cos(a)*rr,y:cy+Math.sin(a)*rr});}keep(drawPolygon(page,ring,'#a855f7',{fill:'transparent',width:2}));}
        keep(drawText(page,cx,cy-ro-14,tokenName(t)+' · пасс '+passivePerception(t)+(isAlert(t)?' · НАСТОРОЖЕ':'')+(dv>0?' · тёмн. '+Math.round(dv)+' фт':''),isAlert(t)?'#ff6b6b':'#ffffff',14));
        partyTokens(page).forEach(function(pc){
            var v=fovVerdict(t,pc),color=FOV_LINE[v.kind]||'#ffffff',px=Number(pc.get('left')),py=Number(pc.get('top'));
            keep(drawPolygon(page,[{x:cx,y:cy},{x:px,y:py}],color,{fill:'transparent',width:v.kind==='none'?1:3,open:true}));
            keep(drawText(page,(cx+px)/2,(cy+py)/2-10,tokenName(pc)+(hiddenRec(pc)?' (Сл '+hiddenRec(pc).dc+')':'')+': '+v.text,color,12));
        });
