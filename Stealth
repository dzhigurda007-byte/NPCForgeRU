        var senses=attrValue(cid,'npc_senses'),m=/(?:passive\s+perception|пассивн[а-яё]*\s+(?:восприяти[а-яё]*|внимательност[а-яё]*))\s*:?\s*(\d+)/i.exec(senses);
        if(m)return Number(m[1]);
