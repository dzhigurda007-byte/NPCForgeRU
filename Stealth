    }
    // Перерисовка всех показанных полей зрения страницы (персонаж сдвинулся, скрылся,
    // раскрыт, NPC насторожился) — один раз на пачку изменений.
    var fovRefreshTimer=null;
    function scheduleFovRefresh(){
        if(fovRefreshTimer||!Object.keys(fovStore()).length)return;
        fovRefreshTimer=setTimeout(function(){fovRefreshTimer=null;Object.keys(fovStore()).forEach(function(id){var t=getObj('graphic',id);if(t)drawFov(t);else clearFov(id);});},100);
    }
    function fovCommand(msg,mode){
        var sel=(msg.selected||[]).map(function(x){return getObj('graphic',x._id);}).filter(isToken),st=fovStore();
        if(mode==='clear'||(mode==='off'&&!sel.length)){Object.keys(st).forEach(clearFov);gm('Поле зрения скрыто у всех токенов.');return;}
        if(mode==='off'){sel.forEach(function(t){clearFov(t.id);});gm('Поле зрения скрыто: '+sel.length+'.');return;}
        if(mode==='refresh'){Object.keys(st).forEach(function(id){var x=getObj('graphic',id);if(x)drawFov(x);else clearFov(id);});gm('Поле зрения обновлено: '+Object.keys(st).length+'.');return;}
        var list=sel;
        if(mode==='all'||!list.length){var page=Campaign().get('playerpageid');list=(findObjs({_type:'graphic',_subtype:'token',_pageid:page,layer:'objects'})||[]).filter(function(t){return isToken(t)&&side(t)==='npcs';});}
        list.forEach(drawFov);
        gm('Поле зрения на слое мастера: '+list.length+' ('+list.map(function(t){return esc(tokenName(t));}).join(', ')+'). Клетки по реальному свету (общий свет, факелы, тёмное зрение NPC, стены): зелёная — на виду, замечен сразу; жёлтая — пассивная; оранжевая — −5; красная — −10; пусто — не видит (темнота, стена). Белые контуры — 20 и 60 фт, синяя — со спины 5 фт, фиолетовый круг — тёмное зрение. Линии к персонажам: красная — заметит / на виду, жёлтая — решит бросок, зелёная — не заметит, синяя — видит открытого (подпись: нужная Скрытность), серая — не видит. Обновляется само; убрать: <code>!ad5stealth fov off</code>.');
    }
    function fovChanged(t,prev){
        if(!prev||!Object.keys(fovStore()).length)return;
        var moved=['left','top','rotation','fliph','flipv','width','height','_pageid','layer'].some(function(k){return String(prev[k])!==String(t.get(k));});
        var lit=['emits_bright_light','bright_light_distance','emits_low_light','low_light_distance','light_radius','light_dimradius'].some(function(k){return String(prev[k])!==String(t.get(k));});
        if(!moved&&!lit)return;
        // Источник света сдвинулся или изменился — свет поменялся у всех показанных NPC.
        if(lit||(moved&&isLightSource(t))){scheduleFovRefresh();return;}
        if(fovStore()[t.id])drawFov(t);
        else if(isToken(t)&&side(t)==='players')scheduleFovRefresh();
    }
    function isLightSource(t){return t.get('emits_bright_light')===true||t.get('emits_low_light')===true||Number(t.get('light_radius'))>0;}
    var FOV_MACRO='Поле-зрения';
    function ensureFovMacro(){
        (findObjs({_type:'player'})||[]).filter(function(p){return playerIsGM(p.id);}).forEach(function(p){
            var action='!ad5stealth fov ?{Поле зрения|Выделенные (или все NPC),on|Все NPC на карте,all|Обновить,refresh|Убрать у выделенных,off|Убрать все,clear}';
            var m=(findObjs({_type:'macro',playerid:p.id,name:FOV_MACRO})||[])[0];
            if(!m)createObj('macro',{playerid:p.id,name:FOV_MACRO,action:action,visibleto:'',istokenaction:true});
            else if(m.get('action')!==action)m.set('action',action);
        });
    }

    function command(msg){
        var content=String(msg.content||'').trim();
        if(/^!снять-скрытность(?:\s|$)/i.test(content)){revealCommand(msg,/\sall\b|\sвсе\b/i.test(content));return;}
        var args=content.split(/\s+/),sub=String(args[1]||'status').toLowerCase();
        if(sub==='roll'){rollCommand(msg,args);return;}
        if(!playerIsGM(msg.playerid))throw new Error('Команда доступна мастеру.');
        if(sub==='reveal'||sub==='off')revealCommand(msg,String(args[2]||'').toLowerCase()==='all');
        else if(sub==='check'){var obs=currentObservers();if(!obs.length)gm('Сейчас не ход NPC.');else if(!turnCheck(obs,'проверка мастера, ход '+tokenName(obs[0])))gm('В поле зрения NPC текущего хода скрытых нет.');}
        else if(sub==='marker'){var name=args.slice(2).join(' ').trim();root().marker=resolveMarker(name);gm('Маркер скрытности: <b>'+esc(markerTag())+'</b>.');}
        else if(sub==='markers')gm(markerList(args.slice(2).join(' ')));
        else if(sub==='fov')fovCommand(msg,String(args[2]||'on').toLowerCase());
        else if(sub==='alert')alertCommand(msg,args);
        else if(sub==='bright'){
            var bp=Number(args[2]),bf=Number(args[3]);
            if(args.length>2){if(!(bp>=0&&bf>bp))throw new Error('Формат: !ad5stealth bright НА_ВИДУ ПОМЕХА_ДАЛЬШЕ, например 60 120.');root().bright={plain:bp,far:bf};}
            var brn=brightRules();gm('Яркий свет: замечает без броска до <b>'+brn.plain+' фт</b>, дальше — пассивная; настороже — бросок, дальше <b>'+brn.far+' фт</b> с помехой.');
        }
        else if(sub==='alarm')alarmCommand(msg,String(args[2]||'on').toLowerCase());
        else if(sub==='alertmarker'){var an=args.slice(2).join(' ').trim();root().alertMarker=an?resolveMarker(an):null;gm('Маркер настороженности: <b>'+esc(alertMarker())+'</b>.');}
        else if(sub==='alertbuttons')ensureAlertButtonsBatched(function(n){gm('Кнопка «'+ALERT_ABILITY+'» добавлена листам NPC: '+n+'.');});
        else if(sub==='mode'){var md=String(args[2]||'').toLowerCase();if(md!=='balanced'&&md!=='strict')throw new Error('Режим: balanced (сбалансированный) или strict (бросок каждого NPC каждый ход).');root().mode=md;gm('Режим скрытности: <b>'+(md==='balanced'?'сбалансированный':'строгий')+'</b>.');}
        else if(sub==='buttons')ensureButtonsBatched(function(n){gm('Кнопка «'+ABILITY_NAME+'» добавлена листам игроков: '+n+'.');});
        else status();
    }

    on('ready',function(){
        root();
        try{var o=JSON.parse(Campaign().get('turnorder')||'[]')||[];lastTop=o.length?String(o[0].id||'')+'|'+String(o[0].custom||''):'';}catch(ignore){}
        (function reconcile(attempt){
            var missing=Object.keys(root().hidden).filter(function(id){return !getObj('graphic',id);});
            if(!missing.length)return;
            if(attempt+1<READY_RETRY_DELAYS.length){setTimeout(function(){reconcile(attempt+1);},READY_RETRY_DELAYS[attempt+1]-(attempt>=0?READY_RETRY_DELAYS[attempt]:0));return;}
            missing.forEach(function(id){delete root().hidden[id];});
            log(SCRIPT+': сняты записи скрытности без токена: '+missing.length+'.');
        })(-1);
        on('chat:message',function(msg){
            try{
                if(msg.type==='api'){if(/^!(?:ad5stealth|снять-скрытность)(?:\s|$)/i.test(msg.content||''))command(msg);return;}
                if(!msg.playerid||msg.playerid==='API'||!msg.rolltemplate)return;
                if(sheetStealth(msg))return;
                attackReveal(msg);
            }catch(e){whisper(msg.playerid,esc(e.message||e));}
        });
        on('change:campaign:turnorder',function(){try{turnChanged();}catch(e){log(SCRIPT+': '+e.message);}});
        on('destroy:graphic',function(t){delete root().hidden[t.id];delete root().alert[t.id];clearGhost(t.id);if(fovStore()[t.id])clearFov(t.id);});
        on('add:character',function(c){setTimeout(function(){try{ensureAlertButton(c.id);}catch(ignore){}},3000);});
        try{ensureGmMacro(ALARM_MACRO,ALARM_ACTION);}catch(e){log(SCRIPT+': макрос тревоги — '+e.message);}
        setTimeout(function(){ensureAlertButtonsBatched(function(n){if(n)log(SCRIPT+': кнопки «'+ALERT_ABILITY+'» добавлены листам NPC: '+n+'.');});},4000);
        on('change:graphic',function(t,prev){try{fovChanged(t,prev);}catch(e){log(SCRIPT+': поле зрения — '+e.message);}});
        try{ensureFovMacro();}catch(e){log(SCRIPT+': макрос поля зрения — '+e.message);}
        on('add:character',function(c){var cid=c.id;setTimeout(function(){try{ensureButton(cid);}catch(ignore){}},3000);});
        ensureButtonsBatched(function(n){log(SCRIPT+' '+VERSION+' ready. Новых кнопок «'+ABILITY_NAME+'»: '+n+'.');});
        gm('<b>'+SCRIPT+' '+VERSION+'</b> запущен. Маркер скрытности: <b>'+esc(markerTag())+'</b> (список: <code>!ad5stealth markers</code>). Снять скрытность: <code>!снять-скрытность</code>.');
    });
    return {version:VERSION,refreshFov:function(){scheduleFovRefresh();},canSee:canSee,visionPercent:visionPercent,passivePerception:passivePerception,isHidden:function(t){return !!hiddenRec(typeof t==='string'?getObj('graphic',t):t);},reveal:function(t,reason){return reveal(typeof t==='string'?getObj('graphic',t):t,reason||'снято модулем');},check:function(){var o=currentObservers();return o.length?turnCheck(o,'проверка модуля'):0;}};
}());

