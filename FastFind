    }
    function fastCreate(){reset();return nativeCreate.apply(this,arguments);}
    function install(on){
        try{
            if(on){findObjs=fastFind;createObj=fastCreate;}
            else{findObjs=nativeFind;createObj=nativeCreate;}
            installed=on&&findObjs===fastFind;enabled=on;reset();
        }catch(e){installed=false;enabled=false;log('AD5 FastFind: не удалось заменить findObjs: '+e.message);}
        return installed;
    }
    install(true);
    // Objects created or deleted by players/sheets: drop the per-event index (O(1)).
    ['add:attribute','destroy:attribute','add:graphic','destroy:graphic','add:path','destroy:path'].forEach(function(ev){on(ev,reset);});
    on('ready',function(){
        log('AD5 FastFind '+VERSION+' '+(installed?'active':'INACTIVE (native findObjs)')+'.');
        on('chat:message',function(msg){
            if(msg.type!=='api'||!/^!ad5fast(?:\s|$)/i.test(msg.content||''))return;
            if(!playerIsGM(msg.playerid))return;
            var arg=String(msg.content).trim().split(/\s+/)[1]||'';
            if(/^off$/i.test(arg))install(false);else if(/^on$/i.test(arg))install(true);
            sendChat('AD5 FastFind','/w gm FastFind '+VERSION+': <b>'+(installed?'включён':'выключен')+'</b>. Индексных запросов: '+stats.indexed+', штатных: '+stats.native+', полных проходов: '+stats.buckets+'.',null,{noarchive:true});
        });
    });
    return {version:VERSION,invalidate:reset,stats:function(){return JSON.parse(JSON.stringify(stats));},enabled:function(){return installed;}};
}());

}
