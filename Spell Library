    function repairOutputs(pid,token){
        var c=validateTargetToken(token,pid),rows=AD5.spellbook.rows(c.id),jobs=[];
        rows.forEach(function(row){
            var id=attrValue(c.id,row.prefix+'ad5lib_id'),raw=id&&DB[id];
