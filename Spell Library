    function ensureAdminMacro(){
        var players=findObjs({_type:'player'})||[],gmIds=[],made=0,updated=0;
        players.forEach(function(p){
            var pid=String(p.id||p.get('_id')||'');
            if(pid&&playerIsGM(pid))gmIds.push(pid);
        });
        if(!gmIds.length){
            log(SCRIPT+' '+VERSION+': macro create skipped: no GM player object.');
            return {made:0,updated:0};
        }
        var owner=gmIds[0],macros=findObjs({_type:'macro',name:ADMIN_MACRO})||[];
        var own=macros.filter(function(m){
            return String(m.get('playerid')||m.get('_playerid')||'')===owner;
        });
        var m=own[0]||macros[0]||null;
        if(!m){
            try{
                var created=createObj('macro',{
                    name:ADMIN_MACRO,
                    action:'!ad5spell-json',
                    playerid:owner,
                    visibleto:gmIds.join(','),
                    istokenaction:false
                });
                if(created)made++;
            }catch(e){
                log(SCRIPT+' '+VERSION+' macro create failed: '+(e.message||e));
            }
        }else{
            var changes={};
            if(String(m.get('action')||'')!=='!ad5spell-json')changes.action='!ad5spell-json';
            var current=String(m.get('visibleto')||'').split(',').filter(Boolean),merged=current.slice();
            gmIds.forEach(function(id){if(merged.indexOf(id)<0)merged.push(id);});
            if(merged.join(',')!==current.join(','))changes.visibleto=merged.join(',');
            if(Object.keys(changes).length){m.set(changes);updated++;}
        }
        return {made:made,updated:updated};
    }

    function loadCustom(pid,silent){
