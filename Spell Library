    function clone(x){return x==null?x:JSON.parse(JSON.stringify(x));}
    function plainObject(x){return !!x&&typeof x==='object'&&!Array.isArray(x);}
    function mergePatch(base,patch){
        var out=plainObject(base)?clone(base):{};
        Object.keys(patch||{}).forEach(function(k){
            if(['mode','reset','delete','remove'].indexOf(k)>=0)return;
            var v=patch[k];
            if(plainObject(v)&&plainObject(out[k]))out[k]=mergePatch(out[k],v);
            else out[k]=clone(v);
        });
        return out;
    }
    function currentEffectiveMap(){
        var map=Object.create(null);
