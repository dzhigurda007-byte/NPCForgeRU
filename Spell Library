    function existingKeys(cid){
        var keys=Object.create(null),names=Object.create(null);
        (findObjs({_type:'attribute',_characterid:String(cid)})||[]).forEach(function(a){
            var n=String(a.get('name')||''),v=String(a.get('current')||'');
            if(/^repeating_spell-(?:cantrip|[0-9])_.+_ad5lib_key$/i.test(n)&&v)keys[norm(v)]=true;
            if(/^repeating_spell-(?:cantrip|[0-9])_.+_(?:spellname|spellname_base)$/i.test(n)&&v)names[norm(v)]=true;
        });
        return {keys:keys,names:names};
    }
    function writeBatched(cid,values,done){
        var keys=Object.keys(values),i=0;
        function step(){
            try{
                var end=Math.min(i+8,keys.length);
                for(;i<end;i++){
                    var name=keys[i],value=values[name],a=attr(cid,name);
                    if(a)a.set({current:value});
                    else createObj('attribute',{characterid:cid,name:name,current:value});
                }
                if(i<keys.length){setTimeout(step,0);return;}
                setTimeout(done,100);
            }catch(e){done(e);}
        }
        step();
    }
    function normalizeAttackId(v){
        return String(v||'').replace(/^repeating_attack_/i,'').replace(/_(?:atkname|rollbase(?:_[a-z]+)?)$/i,'').trim();
    }
    function linkedAttack(cid,prefix){
        var id=normalizeAttackId(attrValue(cid,prefix+'spellattackid'));
        if(!id)return null;
        var name=attr(cid,'repeating_attack_'+id+'_atkname');
        return name?{id:id,name:name}:null;
    }
    function waitLink(cid,prefix,tries,done){
        var l=linkedAttack(cid,prefix);
        if(l){done(null,l);return;}
        if(tries<=0){done(new Error('Roll20 не создал связанную строку Attacks & Spellcasting (spellattackid). Заклинание в книге сохранено.'));return;}
        setTimeout(function(){waitLink(cid,prefix,tries-1,done);},200);
    }
    function notifyImportedCharacter(cid){
        if(typeof AD5Reactions!=='undefined'&&AD5Reactions&&typeof AD5Reactions.invalidateCharacter==='function')AD5Reactions.invalidateCharacter(cid);
        if(typeof DBMAccessibility!=='undefined'&&DBMAccessibility&&typeof DBMAccessibility.syncCharacter==='function')DBMAccessibility.syncCharacter(cid);
    }
    function waitAd5Patch(cid,prefix,attackId,tries,done){
        // This call is reached only after an explicitly requested import.
        var r=attr(cid,'repeating_attack_'+attackId+'_rollbase');
        if(!r){if(tries<=0){done(false);return;}setTimeout(function(){waitAd5Patch(cid,prefix,attackId,tries-1,done);},200);return;}
        try{
            if(typeof AD5!=='undefined'&&AD5&&AD5.spellbook&&typeof AD5.spellbook.patchLinkedAttack==='function'){
                var result=AD5.spellbook.patchLinkedAttack(cid,attackId,prefix);
                notifyImportedCharacter(cid);done(!!(result&&result.ok));return;
            }
            notifyImportedCharacter(cid);done(false);
        }catch(e){log('AD5 Spell Library import finalize: '+String(e.stack||e));done(false);}
    }
    function afterOutputWorker(a,value,delay,done){
        var finished=false,timer=null;
        function finish(err){if(finished)return;finished=true;if(timer!==null)clearTimeout(timer);done(err);}
        try{
            var workerHook=typeof a.setWithWorker==='function'&&typeof onSheetWorkerCompleted==='function';
            if(workerHook)onSheetWorkerCompleted(function(){finish(null);});
            // Give actual workers time to finish; legacy hosts retain the short fallback.
            timer=setTimeout(function(){finish(null);},workerHook?Math.max(5000,delay):delay);
            if(typeof a.setWithWorker==='function')a.setWithWorker({current:value});
            else a.set({current:value});
        }catch(e){finish(e);}
    }
    function switchToAttack(cid,prefix,done){
        var a=attr(cid,prefix+'spelloutput');
        if(!a){done(new Error('Не найдено поле spelloutput после создания заклинания.'));return;}
        afterOutputWorker(a,'ATTACK',250,function(err){if(err){done(err);return;}waitLink(cid,prefix,30,done);});
    }
    function finalizeMultiSpellCard(cid,prefix,done){
        var a=attr(cid,prefix+'spelloutput');
        if(!a){done(new Error('Не найдено поле spelloutput после создания МУЛЬТИ-заклинания.'));return;}
        afterOutputWorker(a,'SPELLCARD',300,function(err){
            if(err){done(err);return;}
            try{
                if(typeof AD5!=='undefined'&&AD5&&AD5.spellbook&&typeof AD5.spellbook.prepareNativeMulti==='function')AD5.spellbook.prepareNativeMulti(cid);
                notifyImportedCharacter(cid);done(null);
            }catch(e){done(e);}
        });
    }
    function addSpell(pid,token,spellId){
        var c=validateTargetToken(token,pid),raw=DB[String(spellId||'')];
        if(!raw)throw new Error('Заклинание не найдено в библиотеке.');
        var key=String(c.id)+'|'+norm(raw.duplicateKey||raw.id);
        if(locks[key])throw new Error('Это заклинание уже добавляется. Подождите завершения текущей операции.');

        var existing=existingKeys(c.id);
        if(existing.keys[norm(raw.duplicateKey||raw.id)]||existing.names[norm(raw.name)])
            throw new Error('«'+raw.name+'» уже есть в книге заклинаний этого персонажа.');

        var s=compileForCharacter(c.id,raw),rowId=newRowId(),built=spellAttrs(c.id,s,rowId);
        locks[key]=true;
        setTimeout(function(){delete locks[key];},15000);

        whisper(pid,panel('Добавление заклинания',
            '<b>'+esc(s.name)+'</b> → <b>'+esc(c.get('name'))+'</b><br>'+
            'Раздел: '+esc(levelLabel(s.level))+'. Создаю штатную Spellbook-запись…'));

        writeBatched(c.id,built.values,function(writeErr){
            if(writeErr){delete locks[key];whisper(pid,panel('Ошибка',esc(writeErr.message||writeErr)));return;}
            if(isNativeCardSpell(s)){
                finalizeMultiSpellCard(c.id,built.prefix,function(cardErr){
                    delete locks[key];
                    if(cardErr){
                        whisper(pid,panel('Заклинание добавлено, SpellCard требует проверки',
                            '<b>'+esc(s.name)+'</b> сохранено в разделе '+esc(levelLabel(s.level))+'.<br>'+esc(cardErr.message||cardErr)+
                            '<br>Механика остаётся в строке «Заклинания»; repeating_attack не используется как источник данных.'));
                        return;
                    }
                    whisper(pid,panel('Заклинание готово',
                        '<b>'+esc(s.name)+'</b> добавлено персонажу <b>'+esc(c.get('name'))+'</b>.<br>'+
                        'Круг: <b>'+esc(levelLabel(s.level))+'</b> · <b>Native SpellCard</b><br>'+
                        '<span style="color:#167a39"><b>AD5:</b> Native AD5 SpellCard читает название, дистанцию, цель, урон, тип и описание из живой строки раздела «Заклинания». repeating_attack/rollbase для механики не используется.</span>'));
                });
                return;
            }
            switchToAttack(c.id,built.prefix,function(linkErr,link){
                delete locks[key];
                if(linkErr){
                    whisper(pid,panel('Заклинание добавлено, связь не создана',
                        '<b>'+esc(s.name)+'</b> находится в разделе '+esc(levelLabel(s.level))+'.<br>'+
                        esc(linkErr.message||linkErr)+
                        '<br>Откройте заклинание и переключите ВЫВОД: Карточка → Атака вручную.'));
                    return;
                }
                waitAd5Patch(c.id,built.prefix,link.id,20,function(patched){
                    whisper(pid,panel('Заклинание готово',
                        '<b>'+esc(s.name)+'</b> добавлено персонажу <b>'+esc(c.get('name'))+'</b>.<br>'+
                        'Круг: <b>'+esc(levelLabel(s.level))+'</b> · spellattackid: <code>'+esc(link.id)+'</code><br>'+
                        (patched
                            ?'<span style="color:#167a39"><b>AD5:</b> связанная атака автоматически подготовлена; определения заклинания всё равно читаются из Spellbook.</span>'
                            :'<span style="color:#a05a00"><b>AD5:</b> Roll20 создал связь; подготовка attack-row не подтверждена. Команда GM: <code>!ad5 buttons selected</code>.</span>')+
                        (s.automation==='partial'
                            ?'<br><small>У этого заклинания есть эффект, который текущий стек не может точно автоматизировать; он записан в описании как «Примечание».</small>'
                            :'')
                    ));
                });
            });
        });
    }
