    function decodeNotes(raw){
        return String(raw||'')
            .replace(/<br\s*\/?\s*>|<\/p>|<\/div>/gi,'\n')
            .replace(/<[^>]*>/g,'')
            .replace(/&quot;/gi,'"').replace(/&#39;|&apos;/gi,"'")
            .replace(/&lt;/gi,'<').replace(/&gt;/gi,'>').replace(/&nbsp;|&#160;/gi,' ')
            .replace(/&amp;/gi,'&')
            .replace(/&#(x[0-9a-f]+|\d+);/gi,function(_,n){
                var code=n.charAt(0).toLowerCase()==='x'?parseInt(n.slice(1),16):Number(n);
                return Number.isFinite(code)?String.fromCharCode(code):_;
            })
            .replace(/^\uFEFF/,'')
            .replace(/^```(?:json)?\s*/i,'')
            .replace(/\s*```$/,'')
            .trim();
    }
    function customId(name){
        var s=norm(name),h=0,i;
        for(i=0;i<s.length;i++)h=((h<<5)-h+s.charCodeAt(i))|0;
        return 'custom-'+Math.abs(h).toString(36);
    }
    function bool(v,def){
        if(v===undefined||v===null||v==='')return !!def;
        if(typeof v==='boolean')return v;
        return /^(?:1|true|yes|on|да)$/i.test(String(v).trim());
    }
    function normalizeCustomSpell(raw,index){
        if(!raw||typeof raw!=='object'||Array.isArray(raw))throw new Error('Запись '+(index+1)+': ожидается JSON-объект.');
        var s=JSON.parse(JSON.stringify(raw)),required=['name','level','school','castingTime','range','target','duration'];
        required.forEach(function(k){
            if(s[k]===undefined||s[k]===null||String(s[k]).trim()==='')
                throw new Error('Запись '+(index+1)+': обязательное поле '+k+'.');
        });
        s.name=String(s.name).trim();
        s.id=String(s.id||customId(s.name)).trim();
        if(!/^[A-Za-z0-9_.:-]{1,100}$/.test(s.id))
            throw new Error(s.name+': id может содержать только A-Z, a-z, 0-9, _, ., :, -.');
        s.level=Number(s.level);
        if(!Number.isSafeInteger(s.level)||s.level<0||s.level>9)throw new Error(s.name+': level должен быть 0–9.');
        s.aliases=Array.isArray(s.aliases)?s.aliases.map(String):[];
        if(s.aliases.indexOf(s.name)<0)s.aliases.push(s.name);
        s.school=String(s.school);
        s.castingTime=String(s.castingTime);
        s.range=String(s.range);
        s.target=String(s.target);
        s.duration=String(s.duration);
        s.components=s.components&&typeof s.components==='object'?s.components:{};
        s.components={
            v:bool(s.components.v,false),
            s:bool(s.components.s,false),
            m:bool(s.components.m,false),
            material:String(s.components.material||'')
        };
        s.concentration=bool(s.concentration,false);
        s.ritual=bool(s.ritual,false);
        s.addAbilityMod=bool(s.addAbilityMod,false);
        // 2.3.3: preserve explicit Native SpellCard intent from custom JSON.
        // 2.3.2 normalized unknown fields away, so {\"nativeCard\":true} was
        // silently lost and save-only declarative spells were switched to ATTACK.
        s.nativeCard=bool(s.nativeCard,false);
        s.attack=String(s.attack||'');
        s.save=String(s.save||'');
        s.saveSuccess=String(s.saveSuccess||'');
        s.damage=String(s.damage||'');
        s.damageType=String(s.damageType||'');
        s.damage2=String(s.damage2||'');
        s.damageType2=String(s.damageType2||'');
        s.healing=String(s.healing||'');
        s.progression=String(s.progression||'');
        s.higherDieCount=String(s.higherDieCount||'');
        s.higherDieType=String(s.higherDieType||'');
        s.higherBonus=String(s.higherBonus||'');
        s.higherText=String(s.higherText||'');
        s.classes=String(s.classes||'Арвенор');
        s.source=String(s.source||'Арвенор');
        s.spellAbility=String(s.spellAbility||'auto');
        if(s.selfApply!==undefined)s.selfApply=bool(s.selfApply,false);
        s.description=String(s.description||'').trim();
        if(!/(?:^|\s)ЗАКЛ(?:$|\s|[.,;:!?])/i.test(s.description))
            s.description='ЗАКЛ'+(s.description?'\n'+s.description:'');
        s.output='ATTACK';
        s.ad5Tag=true;
        s.ad5Mechanical=true;
        s.automation=String(s.automation||'full');
        s.duplicateKey=String(s.duplicateKey||s.id);
        return s;
    }
