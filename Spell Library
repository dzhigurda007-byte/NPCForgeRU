        put('spellsave',s.save||'');
        put('spellsavesuccess',s.saveSuccess||'');
        put('spellhldie',s.higherDieCount||'');
        put('spellhldietype',s.higherDieType||'');
        put('spellhlbonus',s.higherBonus||'');
        put('spelldescription',s.description||'ЗАКЛ');
        put('spellathigherlevels',s.higherText||'');
        // Import provenance only. These fields are NEVER consulted by AD5 during
        // execution; after creation the character sheet is fully detached from the template DB.
        put('ad5lib_id',s.id);
        put('ad5lib_key',s.duplicateKey||s.id);
        put('ad5lib_version',VERSION);
        put('ad5lib_detached','1');
        // First stage must be SPELLCARD. A later worker-driven switch creates
        // the native linked repeating_attack row and spellattackid.
        put('spelloutput','SPELLCARD');
