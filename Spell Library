        h.get('gmnotes',function(raw){
            try{
                var text=decodeNotes(raw),parsed=text?JSON.parse(text):[];
                if(!Array.isArray(parsed))parsed=[parsed];
                var next=parsed.map(normalizeCustomSpell),seen={};
                next.forEach(function(s){
                    if(seen[s.id])throw new Error('Повторяющийся custom id: '+s.id);
                    seen[s.id]=true;
