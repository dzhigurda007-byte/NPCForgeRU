    function ensureAdminMacro(){
        var players=findObjs({_type:'player'})||[],gmIds=[],made=0,updated=0;
        players.forEach(function(p){
            var pid=String(p.id||p.get('_id')||'');
            if(pid&&playerIsGM(pid))gmIds.push(pid);
        });
        if(!gmIds.length){
            log(SCRIPT+' '+VERSION+': macro create skipped: no GM player object.');
            return {made:0,updated:0};
        }
        var owner=gmIds[0],macros=findObjs({_type:'macro',name:ADMIN_MACRO})||[];
        var own=macros.filter(function(m){
            return String(m.get('playerid')||m.get('_playerid')||'')===owner;
        });
        var m=own[0]||macros[0]||null;
        if(!m){
            try{
                var created=createObj('macro',{
                    name:ADMIN_MACRO,
                    action:'!ad5spell-json',
                    playerid:owner,
                    visibleto:gmIds.join(','),
                    istokenaction:false
                });
                if(created)made++;
            }catch(e){
                log(SCRIPT+' '+VERSION+' macro create failed: '+(e.message||e));
            }
        }else{
            var changes={};
            if(String(m.get('action')||'')!=='!ad5spell-json')changes.action='!ad5spell-json';
            var current=String(m.get('visibleto')||'').split(',').filter(Boolean),merged=current.slice();
            gmIds.forEach(function(id){if(merged.indexOf(id)<0)merged.push(id);});
            if(merged.join(',')!==current.join(','))changes.visibleto=merged.join(',');
            if(Object.keys(changes).length){m.set(changes);updated++;}
        }
        return {made:made,updated:updated};
    }
    // 2.3.11: this listener helper must live at module scope. In 2.3.10 it was
    // accidentally declared inside loadCustom()'s "no Handout" branch, so the
    // ready callback could not see it and Roll20 threw ReferenceError.
    var deletedAttackRepair=Object.create(null);
    function deletedAttackRowInfo(a){
        if(!a)return null;
        var cid=String(a.get('_characterid')||''),name=String(a.get('name')||'');
        var m=/^repeating_attack_(.+)_rollbase(?:_[a-z]+)?$/i.exec(name);
        if(!m||!cid)return null;
        var rowId=normalizeAttackId(m[1]);
        return {cid:cid,rowId:rowId,key:cid+'|'+rowId};
    }
    function scheduleDeletedAttackRepair(a){
        var info=deletedAttackRowInfo(a);
        if(!info||nativeDeleteSuppressed(info.cid,info.rowId))return;
        if(deletedAttackRepair[info.key])clearTimeout(deletedAttackRepair[info.key]);
        deletedAttackRepair[info.key]=setTimeout(function(){
            delete deletedAttackRepair[info.key];
            try{
                // If Roll20/Sheet Worker has already recreated the row, do nothing.
                if(attr(info.cid,'repeating_attack_'+info.rowId+'_rollbase'))return;
                if(typeof AD5==='undefined'||!AD5||!AD5.spellbook||typeof AD5.spellbook.rows!=='function')return;
                var row=(AD5.spellbook.rows(info.cid)||[]).filter(function(r){
                    return normalizeAttackId(r.attackId)===info.rowId&&String(r.output||'').toUpperCase()==='ATTACK';
                })[0];
                if(!row)return;
                switchToAttack(info.cid,row.prefix,function(err,link){
                    if(err){log(SCRIPT+' deleted-link repair: '+String(err.message||err));return;}
                    if(link&&link.id)waitAd5Patch(info.cid,row.prefix,link.id,30,function(ok){
                        log(SCRIPT+' deleted-link repair '+row.name+': '+(ok?'ok':'patch failed'));
                    });
                });
            }catch(e){log(SCRIPT+' deleted-link repair error: '+String(e.stack||e));}
        },1200);
    }

