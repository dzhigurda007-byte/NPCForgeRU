    function refreshSheet(pid,token){
        var c=validateTargetToken(token,pid),rows=AD5.spellbook.rows(c.id),jobs=[];
        rows.forEach(function(row){
            var id=attrValue(c.id,row.prefix+'ad5lib_id'),raw=id&&DB[id];
            if(!raw)return;
            row.prefix=normalizeSpellRow(c.id,row.prefix);
            var s=compileForCharacter(c.id,raw);
            var rowId=row.prefix.replace(/^repeating_spell-(?:cantrip|[0-9])_/,'').replace(/_$/,'');
            var values=spellAttrs(c.id,s,rowId).values;
            if(Object.keys(values)[0].indexOf(row.prefix)!==0)throw Error('Круг записи изменён: '+row.name+'. Импортируйте её отдельно.');
            // Do not directly overwrite spelloutput while refreshing other fields.
            // The native Sheet Worker owns mode changes and linked attack creation.
            delete values[row.prefix+'spelloutput'];
            jobs.push({prefix:row.prefix,values:values,desired:desiredOutput(s),name:row.name||s.name});
        });
        var count=0,failed=[];
        function next(){
            if(!jobs.length){
                notifyImportedCharacter(c.id);
                whisper(pid,panel('Обновление завершено',
                    'Обновлено строк: '+count+'. Политика вывода применена автоматически.'+
                    (failed.length?'<br><b>Ошибки:</b><br>'+failed.map(esc).join('<br>'):'')+
                    '<br>Механические заклинания → <b>Атака</b>; только нарративные → <b>Карточка заклинания</b>.'));
                return;
            }
