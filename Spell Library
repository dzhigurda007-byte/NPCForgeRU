        h.get('gmnotes',function(raw){
            try{
                var text=decodeNotes(raw),parsed=text?JSON.parse(text):[],spellList=[],deletedList=[];
                if(Array.isArray(parsed))spellList=parsed;
                else if(plainObject(parsed)&&Array.isArray(parsed.spells)){spellList=parsed.spells;deletedList=Array.isArray(parsed.deleted)?parsed.deleted:[];}
                else if(plainObject(parsed)&&parsed.name)spellList=[parsed];
                else if(parsed&&typeof parsed==='object')throw new Error('Custom Library: ожидается массив либо объект {spells:[], deleted:[]}.');
                var next=spellList.map(normalizeCustomSpell),seen={};
                next.forEach(function(spell){
                    if(seen[spell.id])throw new Error('Повторяющийся custom id: '+spell.id);
                    seen[spell.id]=true;
                });
                DELETED_IDS=Object.create(null);
                deletedList.forEach(function(id){id=String(id||'').trim();if(id)DELETED_IDS[id]=true;});
                CUSTOM_DATA=next;
                buildIndex();
                log(SCRIPT+' '+VERSION+': custom spells loaded='+CUSTOM_DATA.length+'; deleted='+Object.keys(DELETED_IDS).length+'; effective='+Object.keys(DB).length+'.');
                if(!silent&&pid)whisper(pid,panel('Custom Library',
                    'Пользовательских/изменённых записей: <b>'+CUSTOM_DATA.length+'</b>.<br>'+
                    'Скрыто/удалено из библиотеки: <b>'+Object.keys(DELETED_IDS).length+'</b>.<br>'+
                    'Эффективных заклинаний в поиске: <b>'+Object.keys(DB).length+'</b>.'));
            }catch(e){
                log(SCRIPT+' '+VERSION+' custom load error: '+(e.stack||e.message||e));
                if(!silent&&pid)whisper(pid,panel('Ошибка Custom Library',esc(e.message||e)));
            }
        });
    }

    function clone(x){return x==null?x:JSON.parse(JSON.stringify(x));}
    function plainObject(x){return !!x&&typeof x==='object'&&!Array.isArray(x);}
    function mergePatch(base,patch){
        var out=plainObject(base)?clone(base):{};
        Object.keys(patch||{}).forEach(function(k){
            if(['mode','reset','delete','remove'].indexOf(k)>=0)return;
            var v=patch[k];
            if(plainObject(v)&&plainObject(out[k]))out[k]=mergePatch(out[k],v);
            else out[k]=clone(v);
        });
        return out;
    }
    function currentEffectiveMap(){
        var map=Object.create(null);
        Object.keys(DB).forEach(function(id){map[id]=clone(DB[id]);});
        return map;
    }
    function currentCustomMap(){
        var map=Object.create(null);
        (CUSTOM_DATA||[]).forEach(function(s){map[s.id]=clone(s);});
        return map;
    }
    function currentDeletedMap(){
        var map=Object.create(null);Object.keys(DELETED_IDS||{}).forEach(function(id){if(DELETED_IDS[id])map[id]=true;});return map;
    }
    function knownSpellMap(){
        var map=Object.create(null);BUILTIN_DATA.forEach(function(spell){map[spell.id]=clone(spell);});
        (CUSTOM_DATA||[]).forEach(function(spell){map[spell.id]=clone(spell);});return map;
    }
    function resolveExistingId(spec,effective,index){
        if(spec.id!==undefined&&String(spec.id).trim()){
            var explicit=String(spec.id).trim();
            return {id:explicit,exists:!!effective[explicit],by:'id'};
        }
        var name=String(spec.name||'').trim();
        if(!name)throw new Error('Запись '+(index+1)+': укажите id или name.');
        var wanted=norm(name),exact=[],alias=[];
        Object.keys(effective).forEach(function(id){
            var s=effective[id];
            if(norm(s.name)===wanted)exact.push(id);
            else if((s.aliases||[]).some(function(a){return norm(a)===wanted;}))alias.push(id);
        });
        var hits=exact.length?exact:alias;
        if(hits.length>1)
            throw new Error('Запись '+(index+1)+': имя «'+name+'» неоднозначно. Укажите id. Совпадения: '+hits.join(', ')+'.');
        if(hits.length===1)return {id:hits[0],exists:true,by:exact.length?'name':'alias'};
        return {id:customId(name),exists:false,by:'new'};
    }
    function importBatch(data){
        var list=Array.isArray(data)?data:[data];
        if(!list.length)throw new Error('Массив заклинаний пуст.');
        if(list.length>MAX_IMPORT)throw new Error('За один импорт разрешено не более '+MAX_IMPORT+' записей.');

        var effective=currentEffectiveMap(),known=knownSpellMap(),custom=currentCustomMap(),deleted=currentDeletedMap(),results=[];
        list.forEach(function(raw,index){
            if(!plainObject(raw))throw new Error('Запись '+(index+1)+': ожидается JSON-объект.');
            var spec=clone(raw),resolved=resolveExistingId(spec,known,index),id=resolved.id;
            var reset=bool(spec.reset,false),remove=bool(spec.delete,false)||bool(spec.remove,false);
            if(remove){
                if(custom[id])delete custom[id];deleted[id]=true;delete effective[id];
                results.push({id:id,name:String((known[id]&&known[id].name)||spec.name||id),status:'deleted'});
                return;
            }
            if(reset){
                if(custom[id])delete custom[id];delete deleted[id];
                var builtin=BUILTIN_DATA.filter(function(spell){return spell.id===id;})[0]||null;
                if(builtin){effective[id]=clone(builtin);known[id]=clone(builtin);}
                else{delete effective[id];delete known[id];}
                results.push({id:id,name:(builtin&&builtin.name)||String(spec.name||id),status:builtin?'reset':'deleted'});
                return;
            }

            var mode=String(spec.mode||'patch').toLowerCase();
            if(mode!=='patch'&&mode!=='replace')throw new Error('Запись '+(index+1)+': mode должен быть patch или replace.');
            var base=(mode==='replace')?{}:(known[id]||{});
            var merged=mergePatch(base,spec);merged.id=id;if(!merged.name&&spec.name)merged.name=spec.name;
            var normalized=normalizeCustomSpell(merged,index);
            custom[id]=normalized;effective[id]=clone(normalized);known[id]=clone(normalized);delete deleted[id];
            results.push({id:id,name:normalized.name,status:resolved.exists?'updated':'created',mode:mode});
        });

        var next=Object.keys(custom).map(function(id){return custom[id];}).sort(function(a,b){
            return Number(a.level)-Number(b.level)||String(a.name).localeCompare(String(b.name),'ru');
        });
        return {next:next,deleted:Object.keys(deleted).filter(function(id){return deleted[id];}).sort(),results:results};
    }
    function persistCustom(list,deleted,done){
        var h=ensureCustomHandout();
        try{
            deleted=Array.isArray(deleted)?deleted:[];
            h.set('gmnotes',JSON.stringify({version:2,spells:list,deleted:deleted},null,2));
            CUSTOM_DATA=list.map(function(spell){return clone(spell);});
            DELETED_IDS=Object.create(null);deleted.forEach(function(id){id=String(id||'').trim();if(id)DELETED_IDS[id]=true;});
            buildIndex();
            setTimeout(function(){done(null);},25);
        }catch(e){done(e);}
    }
    function parseImportBuffer(raw){
        var text=decodeNotes(raw);
        if(!text)throw new Error('JSON-буфер пуст.');
        if(text.length>350000)throw new Error('JSON слишком большой: максимум 350000 символов.');
        try{return JSON.parse(text);}
        catch(e){throw new Error('Некорректный JSON: '+e.message);}
    }
    function importFromBuffer(pid){
        var h=ensureImportHandout();
        h.get('gmnotes',function(raw){
            try{
                var data=parseImportBuffer(raw),prepared=importBatch(data);
                persistCustom(prepared.next,prepared.deleted,function(err){
                    if(err){whisper(pid,panel('Ошибка сохранения',esc(err.message||err)));return;}
                    var created=prepared.results.filter(function(x){return x.status==='created';}).length;
                    var updated=prepared.results.filter(function(x){return x.status==='updated';}).length;
                    var reset=prepared.results.filter(function(x){return x.status==='reset'||x.status==='deleted';}).length;
                    var lines=prepared.results.slice(0,30).map(function(x){
                        var label=x.status==='created'?'добавлено':x.status==='updated'?'обновлено':x.status==='reset'?'сброшено к встроенной версии':'удалено';
                        return '<code>'+esc(x.id)+'</code> — '+esc(x.name)+' — <b>'+label+'</b>';
                    });
                    if(prepared.results.length>30)lines.push('… ещё '+(prepared.results.length-30)+' записей.');
                    whisper(pid,panel('AD5 Spell Library — импорт завершён',
                        'Добавлено: <b>'+created+'</b> · обновлено: <b>'+updated+'</b> · сброшено/удалено: <b>'+reset+'</b><br>'+
                        'Эффективных заклинаний: <b>'+Object.keys(DB).length+'</b>.<br><br>'+
                        lines.join('<br>')));
                });
            }catch(e){
                whisper(pid,panel('Ошибка JSON-импорта',esc(e.message||e)));
            }
        });
    }
