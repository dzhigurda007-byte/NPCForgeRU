                        var out=attr(c.id,job.prefix+'spelloutput');
                        if(!out){failed.push(job.name+': не найден spelloutput.');finished();return;}
                        afterOutputWorker(out,'SPELLCARD',300,function(e){if(e)failed.push(job.name+': '+String(e.message||e));finished();});
