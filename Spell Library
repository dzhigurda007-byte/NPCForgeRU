                notifySpellRowWorker(c.id,job.prefix,function(flagErr){
                    if(flagErr){failed.push(job.name+': '+String(flagErr.message||flagErr));setTimeout(next,25);return;}
                    var current=String(attrValue(c.id,job.prefix+'spelloutput')||'SPELLCARD').toUpperCase();
                    function finished(){count++;setTimeout(next,25);}
                    if(job.desired==='ATTACK'){
                        switchToAttack(c.id,job.prefix,function(e,link){
                            if(e){failed.push(job.name+': '+String(e.message||e));finished();return;}
                            waitAd5Patch(c.id,job.prefix,link.id,30,function(ok){if(!ok)failed.push(job.name+': AD5 не подтвердил патч связанной строки.');finished();});
