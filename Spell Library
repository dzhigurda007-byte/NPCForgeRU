    function resolveExistingId(spec,effective,index){
        if(spec.id!==undefined&&String(spec.id).trim()){
            var explicit=String(spec.id).trim();
            return {id:explicit,exists:!!effective[explicit],by:'id'};
        }
        var name=String(spec.name||'').trim();
        if(!name)throw new Error('Запись '+(index+1)+': укажите id или name.');
        var wanted=norm(name),exact=[],alias=[];
        Object.keys(effective).forEach(function(id){
            var s=effective[id];
            if(norm(s.name)===wanted)exact.push(id);
            else if((s.aliases||[]).some(function(a){return norm(a)===wanted;}))alias.push(id);
        });
        var hits=exact.length?exact:alias;
        if(hits.length>1)
            throw new Error('Запись '+(index+1)+': имя «'+name+'» неоднозначно. Укажите id. Совпадения: '+hits.join(', ')+'.');
        if(hits.length===1)return {id:hits[0],exists:true,by:exact.length?'name':'alias'};
        return {id:customId(name),exists:false,by:'new'};
    }
    function importBatch(data){
        var list=Array.isArray(data)?data:[data];
        if(!list.length)throw new Error('Массив заклинаний пуст.');
        if(list.length>MAX_IMPORT)throw new Error('За один импорт разрешено не более '+MAX_IMPORT+' записей.');

        var effective=currentEffectiveMap(),custom=currentCustomMap(),results=[];
        list.forEach(function(raw,index){
            if(!plainObject(raw))throw new Error('Запись '+(index+1)+': ожидается JSON-объект.');
            var spec=clone(raw),resolved=resolveExistingId(spec,effective,index),id=resolved.id;
            var reset=bool(spec.reset,false)||bool(spec.delete,false)||bool(spec.remove,false);
            if(reset){
                if(custom[id])delete custom[id];
                var builtin=BUILTIN_DATA.filter(function(s){return s.id===id;})[0]||null;
                if(builtin)effective[id]=clone(builtin);else delete effective[id];
                results.push({id:id,name:(effective[id]&&effective[id].name)||String(spec.name||id),status:builtin?'reset':'deleted'});
                return;
            }

            var mode=String(spec.mode||'patch').toLowerCase();
            if(mode!=='patch'&&mode!=='replace')throw new Error('Запись '+(index+1)+': mode должен быть patch или replace.');
            var base=(mode==='replace')?{}:(effective[id]||{});
            var merged=mergePatch(base,spec);
            merged.id=id;
            if(!merged.name&&spec.name)merged.name=spec.name;
            var normalized=normalizeCustomSpell(merged,index);
            custom[id]=normalized;
            effective[id]=clone(normalized);
            results.push({
                id:id,
                name:normalized.name,
                status:resolved.exists?'updated':'created',
                mode:mode
            });
        });

        var next=Object.keys(custom).map(function(id){return custom[id];}).sort(function(a,b){
            return Number(a.level)-Number(b.level)||String(a.name).localeCompare(String(b.name),'ru');
        });
        return {next:next,results:results};
    }
    function persistCustom(list,done){
        var h=ensureCustomHandout();
        try{
            h.set('gmnotes',JSON.stringify(list,null,2));
            CUSTOM_DATA=list.map(function(s){return clone(s);});
            buildIndex();
            setTimeout(function(){done(null);},25);
        }catch(e){done(e);}
    }
    function parseImportBuffer(raw){
        var text=decodeNotes(raw);
        if(!text)throw new Error('JSON-буфер пуст.');
        if(text.length>350000)throw new Error('JSON слишком большой: максимум 350000 символов.');
        try{return JSON.parse(text);}
        catch(e){throw new Error('Некорректный JSON: '+e.message);}
    }
    function importFromBuffer(pid){
        var h=ensureImportHandout();
        h.get('gmnotes',function(raw){
            try{
                var data=parseImportBuffer(raw),prepared=importBatch(data);
                persistCustom(prepared.next,function(err){
                    if(err){whisper(pid,panel('Ошибка сохранения',esc(err.message||err)));return;}
                    var created=prepared.results.filter(function(x){return x.status==='created';}).length;
                    var updated=prepared.results.filter(function(x){return x.status==='updated';}).length;
                    var reset=prepared.results.filter(function(x){return x.status==='reset'||x.status==='deleted';}).length;
                    var lines=prepared.results.slice(0,30).map(function(x){
                        var label=x.status==='created'?'добавлено':x.status==='updated'?'обновлено':x.status==='reset'?'сброшено к встроенной версии':'удалено';
                        return '<code>'+esc(x.id)+'</code> — '+esc(x.name)+' — <b>'+label+'</b>';
                    });
                    if(prepared.results.length>30)lines.push('… ещё '+(prepared.results.length-30)+' записей.');
                    whisper(pid,panel('AD5 Spell Library — импорт завершён',
                        'Добавлено: <b>'+created+'</b> · обновлено: <b>'+updated+'</b> · сброшено/удалено: <b>'+reset+'</b><br>'+
                        'Эффективных заклинаний: <b>'+Object.keys(DB).length+'</b>.<br><br>'+
                        lines.join('<br>')));
                });
            }catch(e){
                whisper(pid,panel('Ошибка JSON-импорта',esc(e.message||e)));
            }
        });
    }
    function clearImportBuffer(pid){
        var h=ensureImportHandout();
        h.set('gmnotes','');
        whisper(pid,panel('JSON-буфер очищен','Handout <b>'+esc(IMPORT_HANDOUT)+'</b> готов к следующему импорту.'));
    }
    function resetImportTemplate(pid){
        var h=ensureImportHandout();
        h.set('gmnotes',JSON.stringify(customTemplate(),null,2));
        whisper(pid,panel('Шаблон восстановлен','В JSON-буфер записан пример нового заклинания.'));
    }
    function requestJsonWindow(pid){
        var ih=ensureImportHandout(),ch=ensureCustomHandout();
        var body=
            '<p><b>Добавление и изменение библиотеки</b></p>'+
            handoutLink(ih,'Открыть JSON-буфер')+
            button('Добавить / обновить','!ad5spell-json-import')+
            button('Очистить буфер','!ad5spell-json-clear')+
            button('Шаблон','!ad5spell-json-template')+
            '<hr>'+
            handoutLink(ch,'Открыть постоянную Custom Library')+
            button('Статус','!ad5spell-admin status')+
            '<p style="font-size:11px;color:#666">'+
            'Один объект или массив до '+MAX_IMPORT+' записей. Существующее заклинание можно менять только указанными полями — остальные сохраняются.'+
            '</p>';
        whisper(pid,panel(ADMIN_MACRO+' · библиотека заклинаний',body));
    }
    function setupAdmin(pid){
        var macro=ensureAdminMacro(),ih=ensureImportHandout(),ch=ensureCustomHandout();
        whisper(pid,panel('AD5 Spell Library '+VERSION,
            'Макрос <b>'+ADMIN_MACRO+'</b>: создано '+macro.made+', обновлено '+macro.updated+'.<br>'+
            handoutLink(ih,'JSON-буфер')+handoutLink(ch,'Custom Library')+
            '<br>Готово к массовому добавлению и patch-обновлению.'));
    }
    function customStatus(pid){
        whisper(pid,panel('AD5 Spell Library '+VERSION,
            'Встроено: <b>'+BUILTIN_DATA.length+'</b><br>'+
            'Пользовательских/изменённых: <b>'+CUSTOM_DATA.length+'</b><br>'+
            'Эффективных записей: <b>'+Object.keys(DB).length+'</b><br>'+
            button('JSON Manager','!ad5spell-json')+
            button('Перезагрузить Custom','!ad5spell-admin reload')+
            button('Восстановить макрос','!ad5spell-admin setup')));
    }
    function handleAdmin(msg){
        if(!playerIsGM(msg.playerid))throw new Error('Управление библиотекой доступно только GM.');
        var args=String(msg.content||'').trim().split(/\s+/),sub=String(args[1]||'status').toLowerCase();
        if(sub==='setup'||sub==='создать'||sub==='macro'||sub==='макрос'){setupAdmin(msg.playerid);return;}
        if(sub==='reload'||sub==='load'||sub==='загрузить'){loadCustom(msg.playerid,false);return;}
        if(sub==='status'||sub==='статус'){customStatus(msg.playerid);return;}
        throw new Error('Используйте !ad5spell-admin setup | reload | status.');
    }
    function handle(msg){
        if(!msg||msg.type!=='api')return;
        var content=String(msg.content||'').trim();
        if(!/^!ad5spell(?:\s|$)/i.test(content)&&
           !/^!ad5spell-(?:search|add)(?:\s|$)/i.test(content)&&
           !/^!ad5spell-admin(?:\s|$)/i.test(content)&&
           !/^!ad5spell-json(?:\s|$|-)/i.test(content))return;
        if(String(msg.playerid||'').toUpperCase()==='API')return;
        try{
            if(/^!ad5spell-json\s*$/i.test(content)){
                if(!playerIsGM(msg.playerid))throw new Error('JSON Manager доступен только GM.');
                requestJsonWindow(msg.playerid);return;
            }
            if(/^!ad5spell-json-import(?:\s|$)/i.test(content)){
                if(!playerIsGM(msg.playerid))throw new Error('JSON Manager доступен только GM.');
                importFromBuffer(msg.playerid);return;
            }
            if(/^!ad5spell-json-clear(?:\s|$)/i.test(content)){
                if(!playerIsGM(msg.playerid))throw new Error('JSON Manager доступен только GM.');
                clearImportBuffer(msg.playerid);return;
            }
            if(/^!ad5spell-json-template(?:\s|$)/i.test(content)){
                if(!playerIsGM(msg.playerid))throw new Error('JSON Manager доступен только GM.');
                resetImportTemplate(msg.playerid);return;
            }
            if(/^!ad5spell-admin(?:\s|$)/i.test(content)){handleAdmin(msg);return;}
            if(/^!ad5spell-add(?:\s|$)/i.test(content)){
                var am=/^!ad5spell-add\s+(\S+)\s+(\S+)\s*$/i.exec(content);
                if(!am)throw new Error('Повреждена команда добавления.');
                var at=getObj('graphic',am[1]);addSpell(msg.playerid,at,am[2]);return;
            }
            if(/^!ad5spell-search(?:\s|$)/i.test(content)){
                var sm=/^!ad5spell-search\s+(\S+)\s+([\s\S]+)$/i.exec(content);
                if(!sm)throw new Error('Введите название заклинания.');
                var st=getObj('graphic',sm[1]);showSearch(msg.playerid,st,sm[2]);return;
            }

            var token=selectedToken(msg),query=content.replace(/^!ad5spell\b/i,'').trim();
            if(!query){showMenu(msg.playerid,token);return;}
            if(/^find\s+/i.test(query))query=query.replace(/^find\s+/i,'').trim();
            showSearch(msg.playerid,token,query);
        }catch(e){
            whisper(msg.playerid,panel('AD5 Spell Library · ошибка',esc(e.message||e)));
        }
    }

    buildIndex();
    if(typeof on==='function'){
        on('ready',function(){
            log(SCRIPT+' '+VERSION+' ready; templates='+BUILTIN_DATA.length+'; IMPORT ONLY / SHEET FIRST; МУЛЬТИ -> Native SpellCard; no runtime DB binding, no attribute listeners.');
            on('chat:message',handle);
            loadCustom(null,true);
            try{ensureAdminMacro();ensureImportHandout();}
            catch(e){log(SCRIPT+' '+VERSION+' admin asset setup error: '+(e.stack||e.message||e));}
        });
    }

    // Public API deliberately exposes no template lookup/getter. The internal DB
    // exists only to power search/import chat commands. Runtime automation must read
    // repeating_spell / repeating_attack fields from the character sheet.
    return {
        version:VERSION,
        _test:{waitAd5Patch:waitAd5Patch,afterOutputWorker:afterOutputWorker},
        count:function(){return DATA.length;},
        search:search
    };
}());
}
