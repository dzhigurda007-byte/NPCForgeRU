            if(name==='npc_size')resizeCharacterTokens(a.get('_characterid'));
            if(/^(npc|npc_toggle|hp|npc_hpbase|npc_senses|npcforge_aura)$/.test(name))configureAllTokens(a.get('_characterid'));
