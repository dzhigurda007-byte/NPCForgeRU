    function importJsonHandout(who,args){
        var h=ensureJsonImportHandout();
        h.get('gmnotes',function(notes){
            try{
                var raw=unescapeNotes(notes);
                if(!raw){throw new Error('JSON-буфер пуст. Откройте Handout «'+JSON_HANDOUT_NAME+'» и вставьте JSON в GM Notes.');}
                var results=importPayload(raw,args), made=false;
                if(normalizeUserText(args.token)==='true'&&results[0]){createToken(results[0],args);made=true;}
                success(who,results,made);
            }catch(e){whisper(who,panel('Ошибка JSON-импорта',esc(e.message)));}
        });
    }
    function clearJsonHandout(who){
        var h=ensureJsonImportHandout();
        h.set('gmnotes','');
        whisper(who,panel('JSON-буфер очищен','Handout <b>'+esc(JSON_HANDOUT_NAME)+'</b> готов к следующему импорту.'));
    }
    function ensureJsonWindowMacros(){
        var players=findObjs({_type:'player'})||[], gmIds=[], made=0, updated=0;
        players.forEach(function(p){
            var pid=String(p.id||p.get('_id')||'');
            if(pid&&playerIsGM(pid))gmIds.push(pid);
        });
        if(!gmIds.length){
            log(SCRIPT+' macro create skipped: no GM player object found.');
            return {made:0,updated:0};
        }

        // Current Roll20 requires a valid playerid owner for every Macro object.
        // Keep one shared GM-visible macro, owned by the first GM.
        var ownerId=gmIds[0];
        var macros=findObjs({_type:'macro',name:'NPC-JSON'})||[];
        var owned=macros.filter(function(m){
            return String(m.get('playerid')||m.get('_playerid')||'')===ownerId;
        });
        var m=owned[0]||macros[0]||null;

        if(!m){
            try{
                var created=createObj('macro',{
                    name:'NPC-JSON',
                    action:'!npc-json',
                    playerid:ownerId,
                    visibleto:gmIds.join(','),
                    istokenaction:false
                });
                if(created)made++;
                else log(SCRIPT+' macro create returned null/undefined.');
            }catch(e){
                log(SCRIPT+' macro create failed: '+(e&&e.message?e.message:e));
            }
        }else{
            var changes={};
            if(m.get('action')!=='!npc-json')changes.action='!npc-json';
            var current=String(m.get('visibleto')||'').split(',').filter(Boolean), merged=current.slice();
            gmIds.forEach(function(id){if(merged.indexOf(id)<0)merged.push(id);});
            if(merged.join(',')!==current.join(','))changes.visibleto=merged.join(',');
            if(Object.keys(changes).length){m.set(changes);updated++;}
        }
        return {made:made,updated:updated};
    }
