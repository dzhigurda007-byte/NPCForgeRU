            if(a.get('name')==='rtype' && isNpcCharacter(a.get('_characterid'))){scheduleCharacterFix(a.get('_characterid'));}
            if(/^repeating_(?:npcaction(?:-l)?|npcreaction|npcbonusaction)_.+_(ad5_targets|ad5_contest|ad5_effect_count|ad5_damage\d+|ad5_damagetype\d+|ad5_crit\d+|ad5_is_spell|ad5_spell_level|ad5_spell_casting_time|ad5_reaction_trigger|ad5_reaction_effect|ad5_reaction_range|ad5_reaction_side|attack_flag|damage_flag|attack_damage2?|attack_damagetype2?|attack_crit2?|save_flag|save_attr|save_dc|save_effect|attack_range|description|desc|name)$/.test(a.get('name')) && isNpcCharacter(a.get('_characterid'))){
