    function success(who,results,tokenMade){
        var list=results.map(function(r){return '<li><b>'+esc(r.npc.name)+'</b> — CR '+esc(r.npc.cr)+', КД '+esc(r.npc.ac)+', '+esc(r.npc.hp)+' хитов '+button('Панель NPC','!npc-controls --id|'+r.id)+'</li>';}).join('');
        whisper(who,panel('NPC создан'+(results.length>1?'ы':''),'<ul>'+list+'</ul>'+(tokenMade?'<p>Токен размещён на текущей странице игроков.</p>':'')));
    }
    function directJson(msg,who) {
        var match=String(msg.content).match(/^!npc-json\s+(--token\s+)?--(json|encoded)\|([\s\S]+)$/);
        if(!match)throw new Error('Формат: !npc-json --token --json|{...} или макрос NPC-JSON.');
        var raw=match[3].trim();
        if(raw.length>250000)throw new Error('JSON слишком большой: максимум 250000 символов.');
        if(match[2]==='encoded'){
            try{raw=decodeURIComponent(raw);}catch(e){throw new Error('Повреждено кодирование JSON. Повторите отправку из окна.');}
        }
        raw=raw.replace(/^\uFEFF/,'').replace(/^```(?:json)?\s*/i,'').replace(/\s*```$/,'').trim();
        var data;
        try{data=JSON.parse(raw);}catch(e){throw new Error('Некорректный JSON: '+e.message);}
        // Use the shared importer, but do not pass literal HTML-like strings
        // through the Handout HTML decoder.
        var results=importData(data,{}), made=false;
        if(match[1]&&results[0]){createToken(results[0],{});made=true;}
        success(who,results,made);
    }
    function chunkJson(msg,who,args){
        var owner=String(msg.playerid||'gm'), cmd=args.command, id=String(args.id||'').trim();
        if(!id || !/^[A-Za-z0-9_.:-]{1,80}$/.test(id))throw new Error('Большой JSON: неверный id импорта.');
        if(cmd==='!npc-json-start'){
            var parts=asInt(args.parts,0);
            if(parts<1||parts>200)throw new Error('Большой JSON: parts должен быть от 1 до 200.');
            jsonChunkImports[owner]={id:id,parts:parts,token:normalizeUserText(args.token)==='true',data:new Array(parts),received:0,createdAt:Date.now()};
            return;
        }
        var job=jsonChunkImports[owner];
        if(!job||job.id!==id)throw new Error('Большой JSON: сессия импорта не найдена. Нажмите «Создать» ещё раз.');
        if(cmd==='!npc-json-part'){
            var index=asInt(args.index,-1);
            if(index<0||index>=job.parts)throw new Error('Большой JSON: неверный номер части.');
            var data=String(args.data||'');
            if(!data)throw new Error('Большой JSON: пустая часть '+(index+1)+'.');
            if(data.length>6000)throw new Error('Большой JSON: одна часть превышает 6000 символов.');
            if(job.data[index]===undefined){job.received++;}
            job.data[index]=data;
            return;
        }
        if(cmd==='!npc-json-end'){
            if(job.received!==job.parts){throw new Error('Большой JSON: получено '+job.received+' из '+job.parts+' частей. Повторите импорт.');}
            delete jsonChunkImports[owner];
            var encoded=job.data.join('');
            if(encoded.length>750000)throw new Error('Большой JSON: закодированный пакет слишком большой.');
            var raw;
            try{raw=decodeURIComponent(encoded);}catch(e){throw new Error('Большой JSON: повреждено кодирование. Повторите импорт.');}
            if(raw.length>250000)throw new Error('JSON слишком большой: максимум 250000 символов после декодирования.');
            raw=raw.replace(/^\uFEFF/,'').replace(/^```(?:json)?\s*/i,'').replace(/\s*```$/,'').trim();
            var parsed;
            try{parsed=JSON.parse(raw);}catch(e){throw new Error('Некорректный JSON после сборки: '+e.message);}
            var results=importData(parsed,{}), made=false;
            if(job.token&&results[0]){createToken(results[0],{});made=true;}
            success(who,results,made);
            return;
        }
        throw new Error('Неизвестная команда большого JSON импорта.');
    }
    function handle(msg){
        if(!msg || msg.type!=='api' || String(msg.content||'').indexOf('!npc')!==0){return;}
        // Never execute API commands emitted by this or another Mod script.
        // This is the primary chat:message loop breaker.
        if(String(msg.playerid||'').toUpperCase()==='API'){return;}
        if(handlingChat){log(SCRIPT+': повторный chat:message заблокирован: '+String(msg.content||'').slice(0,120));return;}
        var who=(msg.who||'GM').replace(/\s+\(GM\)$/,'');
        if(!playerIsGM(msg.playerid)){whisper(who,panel('Доступ запрещён','Команды создания NPC доступны только Мастеру.'));return;}
        var args;
        handlingChat=true;
        try{
            if(/^!npc-json\s*$/.test(String(msg.content||''))){requestJsonWindow(who);return;}
            if(/^!npc-json(?:\s|$)/.test(msg.content)){directJson(msg,who);return;}
            args=parseArgs(msg.content);
            if(args.command==='!npc-json-window'||args.command==='!npc-import-menu'){requestJsonWindow(who);return;}
            if(args.command==='!npc-ping'){log(SCRIPT+' v'+VERSION+': !npc-ping received from '+String(msg.playerid||''));whisperGM(panel('NPC Forge работает','Версия <b>'+esc(VERSION)+'</b>. Команды чата зарегистрированы.'));return;}
            if(args.command==='!npc-json-import-native'){importJsonHandout(who,args);return;}
            if(args.command==='!npc-json-clear'){clearJsonHandout(who);return;}
            if(args.command==='!npc-json-macro'){var mr=ensureJsonWindowMacros();ensureJsonImportHandout();whisper(who,panel('Макрос NPC-JSON','Создано: '+mr.made+', обновлено: '+mr.updated+'. Нативный JSON-Handout готов.'));return;}
            if(['!npc-json-start','!npc-json-part','!npc-json-end'].indexOf(args.command)>=0){chunkJson(msg,who,args);return;}
            if(args.command==='!npc'||args.command==='!npc-menu'){menu(who);return;}
            if(args.command==='!npc-help'){help(who);return;}
            if(['!npc-controls','!npc-mode','!npc-aura'].indexOf(args.command)>=0){
                var c=commandNPC(msg,args);
                if(args.command==='!npc-mode'){
                    var mode=normalizeUserText(args.mode||'toggle');
                    if(mode==='toggle')mode=/{{advantage=1}}/.test(attrValue(c.id,'rtype'))?'normal':'advantage';
                    upsert(c.id,'rtype',modeValue(mode));fixCharacter(c.id);
                }
                if(args.command==='!npc-aura'){
                    var slot=Number(args.slot||1);if(slot!==1&&slot!==2)throw new Error('Номер ауры: 1 или 2.');
                    var raw=attrValue(c.id,'npcforge_aura'), data=raw?JSON.parse(raw):[], auras=Array.isArray(data)?data:[data];
                    while(auras.length<slot)auras.push(null);
                    var a=auras[slot-1]||{radius:10,unit:'ft',color:'#FFFF99',visible:false};
                    a=JSON.parse(JSON.stringify(a));
                    if(args.radius!==undefined)a.radius=Number(args.radius);
                    if(args.unit!==undefined)a.unit=normalizeUserText(args.unit);
                    if(args.color!==undefined)a.color=args.color;
                    if(args.visible!==undefined)a.visible=args.visible==='true';
                    if(args.square!==undefined)a.square=args.square==='true';
                    a.enabled=args.enabled!=='false';auras[slot-1]=a;validateAuras(auras);
                    upsert(c.id,'npcforge_aura',JSON.stringify(auras));configureAllTokens(c.id);
                }
                controls(who,c,args.page);return;
            }
            if(args.command==='!npc-size'){
                var sizeTokens=args.all==='true'?findObjs({_type:'graphic',_subtype:'token'}):(msg.selected||[]).map(function(x){return getObj('graphic',x._id);});
                var sized=0;sizeTokens.forEach(function(t){if(resizeToken(t))sized++;});
                whisper(who,panel('Размеры NPC','Обновлено токенов: '+sized+'.'));return;
            }
            if(args.command==='!npc-token'){
                var n=0;
                if(args.all==='true'){n=configureAllTokens();}
                else{(msg.selected||[]).forEach(function(x){if(configureToken(getObj('graphic',x._id))){n++;}});}
                whisper(who,panel('Токены NPC настроены','Обновлено: '+n+'.'));return;
            }
            if(args.command==='!npc-fix'){
                if(args.all==='true' || !msg.selected || !msg.selected.length){fixAllCharacters(who);return;}
                var target=selectedCharacter(msg);
                if(!target){throw new Error('Выберите токен NPC или используйте !npc-fix --all.');}
                var repaired=fixCharacter(target.id||target.get('_id'));
                configureAllTokens(target.id||target.get('_id'));
                whisper(who,panel('Атака и урон включены',esc(target.get('name'))+': обновлено действий — '+repaired+'.'));return;
            }
            if(args.command==='!npc-create'){
                var npc=generate({name:args.name,cr:args.cr,role:args.role,type:args.type,size:args.size,alignment:args.alignment,languages:args.languages,speed:args.speed,ac:args.ac,hp:args.hp,legendary:args.legendary,rollMode:args.rollmode,auras:args['aura-radius']!==undefined?[{radius:Number(args['aura-radius']),unit:args['aura-unit']||'ft',color:args['aura-color']||'#9900FF',visible:normalizeUserText(args['aura-visible'])==='true'}]:undefined}), result=writeCharacter(npc,args), tokenMade=false;
