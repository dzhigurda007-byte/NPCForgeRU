            }
            if(args.command==='!npc-add'){var c=addSection(msg,args);whisper(who,panel('Добавлено','Раздел добавлен в лист <b>'+esc(c.get('name'))+'</b>.'));return;}
            if(args.command==='!npc-import'){
                if(!args.handout){throw new Error('Укажите --handout|Название.');}
                var hs=findObjs({_type:'handout',name:args.handout}); if(!hs.length){throw new Error('Раздаточный материал «'+args.handout+'» не найден.');} if(hs.length>1){throw new Error('Найдено несколько раздаточных материалов с таким именем.');}
                hs[0].get('notes',function(notes){try{var results=importPayload(notes,args), made=false;if(args.token==='true'&&results[0]){createToken(results[0],args);made=true;}success(who,results,made);}catch(e){whisper(who,panel('Ошибка импорта',esc(e.message)));}}); return;
            }
            help(who);
        } catch(e){ whisper(who,panel('Ошибка',esc(e.message))); }
        finally { handlingChat=false; }
    }
