            else if(/^rebuild$/i.test(arg)){invalidate();out='Кэш стен сброшен.';}
            else if(/^walls$/i.test(arg)||sel.length<2){var c=pageCache(page);out='Стен (отрезков) на странице: <b>'+c.segs.length+'</b>, ячеек индекса: '+Object.keys(c.grid).length+'.'+(sel.length===1?'<br>Свет у '+esc(sel[0].get('name')||'токена')+': <b>'+lightAt(sel[0])+'</b>.':'')+' Выделите два токена (наблюдатель, цель) для проверки видимости.';}
            else{
                var v=visibility(sel[0],sel[1]),cov=null;
                try{if(typeof AD5Environment!=='undefined'&&AD5Environment&&AD5Environment.coverBetween)cov=AD5Environment.coverBetween(sel[0],sel[1]);}catch(ignore){}
                out=esc(sel[0].get('name')||'1')+' → '+esc(sel[1].get('name')||'2')+': свободных лучей '+v.visible+'/'+v.total+' ('+(v.visible?'видит':'не видит')+'); свет у цели: <b>'+lightAt(sel[1])+'</b>, для наблюдателя: <b>'+illumination(sel[1],sel[0])+'</b>'+(cov?'; укрытие: '+esc(cov.label||cov.tier):'')+'.';
            }
            sendChat(SCRIPT,'/w gm '+out,null,{noarchive:true});
        });
        log(SCRIPT+' '+VERSION+' ready.');
    });
    return {version:VERSION,firstHit:firstHit,blocked:blocked,visibility:visibility,canSee:canSee,lightAt:lightAt,lightAtPoint:lightAtPoint,illuminationAt:illuminationAt,ambient:ambient,illumination:illumination,darkvisionFeet:darkvisionFeet,invalidate:invalidate,
        _test:{pathSegments:pathSegments,pathV2Segments:pathV2Segments,portalSegment:portalSegment,cache:function(p){return pageCache(p);}}};
}());

}
