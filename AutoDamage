            if ((isAtk && hasAttack) || (isDmg && hasSave) || automatic) {
                // Every new attack supersedes pending damage, even when invalid/unarmed.
                delete pending[pid];
                var a = armed[pid]; delete armed[pid];
                if (f.ad5target !== undefined) {
                    // An inline target always supersedes an old macro target.
                    // An invalid inline target must not fall back to another enemy.
                    var inlineTarget = target(f.ad5target, pid);
                    a = { target: inlineTarget.token.id, cid: inlineTarget.cid, mode: 'normal', factor: 1, time: Date.now() };
                }
                if (a && Date.now() - a.time > CONFIG.ttl) a = null;
                if (!a) throw new Error('Цель атаки не выбрана. GM: выполните !ad5 buttons и повторите Название атаки.'); 
