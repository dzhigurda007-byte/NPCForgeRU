// Versioned description envelope. Only the [AD5] body is executable; other
// prose, including PHB examples resembling directives, never reaches a parser.
var AD5Text=(function(){
    function text(v){return String(v==null?'':v).replace(/<br\s*\/?>|<\/(?:p|div)>/gi,'\n').replace(/&nbsp;|&#160;/gi,' ');}
    function split(v){
        var raw=text(v),start=/^\s*\[AD5\]\s*$/gim,end=/^\s*\[\/AD5\]\s*$/gim,a=[],b=[],m;
        while((m=start.exec(raw)))a.push({i:m.index,end:start.lastIndex});
        while((m=end.exec(raw)))b.push({i:m.index,end:end.lastIndex});
        if(!a.length&&!b.length)return {structured:false,mechanics:raw,narrative:''};
        if(a.length!==1||b.length!==1||b[0].i<a[0].end)throw Error('Описание: нужен ровно один закрытый блок [AD5] ... [/AD5].');
        var tail=raw.slice(b[0].end),binding=/^\s*AD5-СВЯЗЬ:\s*(\S+)\s+(repeating_spell-(?:cantrip|[0-9])_\S+_)\s*$/im.exec(tail);
        return {structured:true,mechanics:raw.slice(a[0].end,b[0].i).trim(),narrative:raw.slice(0,a[0].i).trim(),actor:binding?binding[1]:'',prefix:binding?binding[2]:''};
    }
    function mechanics(v){return split(v).mechanics;}
    function compose(narrative,handler,cid,prefix){
        if(/\[\/?AD5\]/i.test(String(narrative||'')))throw Error('Нарративное описание не должно содержать границы [AD5].');
        if(/\[\/?AD5\]/i.test(String(handler||'')))throw Error('Обработчик не должен содержать вложенные границы [AD5].');
        return String(narrative||'').trim()+'\n\n[AD5]\n'+String(handler||'').trim()+'\n[/AD5]'+(cid&&prefix?'\nAD5-СВЯЗЬ: '+cid+' '+prefix:'');
    }
    return {split:split,mechanics:mechanics,compose:compose,structured:function(v){return /\[\/?AD5\]/i.test(String(v||''));}};
}());

// Bounded, coalescing background work. Never scans objects in startup add events.
var AD5Background = (function(){
    var jobs=Object.create(null),keys=[],head=0,timer=null,ready=false,running=false;
    function pump(){
        timer=null;running=true;
        var count=0,start=Date.now();
        while(head<keys.length&&count<5&&Date.now()-start<15){
            var key=keys[head++],fn=jobs[key];delete jobs[key];
            if(fn){try{fn();}catch(e){log('AD5 background '+key+': '+e.message);}count++;}
        }
        running=false;
        if(head<keys.length)timer=setTimeout(pump,25);
        else{keys=[];head=0;}
    }
    function put(key,fn){
        if(!Object.prototype.hasOwnProperty.call(jobs,key))keys.push(key);
        jobs[key]=fn;
        if(timer===null&&!running)timer=setTimeout(pump,25);
    }
    on('ready',function(){ready=true;});
    return {put:put,isReady:function(){return ready;}};
}());
