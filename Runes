    function norm(s){return String(s==null?'':s).toLowerCase().replace(/ё/g,'е').replace(/[’'`]/g,'').replace(/\s+/g,' ').trim();}
    var INDEX={};RUNES.forEach(function(r){INDEX[norm(r.name)]=r;});
    function find(name){return INDEX[norm(name)]||null;}
    function byLang(lang){var l=norm(lang);return RUNES.filter(function(r){return norm(r.lang).indexOf(l)===0;});}
    function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
    function card(r){
        return '<b>'+esc(r.name)+'</b> <i>'+esc(r.lang)+' ('+esc(r.tr)+')</i>'+(r.req?'<br><b>Требования:</b> '+esc(r.req):'')+(r.item?'<br><b>Предмет:</b> '+esc(r.item):'')+
            (r.passive?'<br>'+esc(r.passive).replace(/\n/g,'<br>'):'')+'<br><b>Пробуждение:</b> '+esc(r.time||'—')+'; <b>длительность:</b> '+esc(r.dur||'—')+(r.awaken?'<br>'+esc(r.awaken).replace(/\n/g,'<br>'):'');
    }
    // Текст для умения/кнопки листа (без HTML).
    function text(r){
        return (r.lang+' ('+r.tr+')')+(r.req?'\nТребования: '+r.req:'')+(r.item?'\nПредмет: '+r.item:'')+(r.passive?'\n'+r.passive:'')+
            '\nПробуждение: '+(r.time||'—')+'; длительность: '+(r.dur||'—')+(r.awaken?'\n'+r.awaken:'');
    }
    on('ready',function(){
        on('chat:message',function(msg){
            if(msg.type!=='api'||!/^!ad5-rune(?:\s|$)/i.test(msg.content||''))return;
            var p=getObj('player',msg.playerid),to=playerIsGM(msg.playerid)?'gm':'"'+String(p&&p.get('_displayname')||'gm').replace(/["\r\n]/g,'')+'"';
            var arg=String(msg.content).replace(/^!ad5-rune\s*/i,'').trim(),html;
            var m=/^язык\s+(.+)$/i.exec(arg);
            if(m){var list=byLang(m[1]);html=list.length?'<b>Руны: '+esc(m[1])+'</b> ('+list.length+')<br>'+list.map(function(r){return esc(r.name)+' — '+esc(r.tr);}).join('<br>'):'Язык не найден.';}
            else if(arg){var r=find(arg);html=r?card(r):'Руна «'+esc(arg)+'» не найдена. Список языка: !ad5-rune язык Дварфийский';}
            else html='<b>AD5 Runes '+VERSION+'</b>: '+RUNES.length+' рун. Языки: Дварфийский, Драконий, Великаний, Небесный, Инфернальный, Язык Бездны, Гоблинский.';
            sendChat('Руны','/w '+to+' '+html,null,{noarchive:true});
        });
    });
    return {version:VERSION,list:function(){return RUNES.slice();},find:find,byLang:byLang,text:text,card:card};
