/* Installation guard: disable old unguarded versions before installing. */
if(typeof AD5Diagnostics!=='undefined'&&AD5Diagnostics) {
    log('AD5Diagnostics: duplicate module skipped; keep one installed copy.');
} else {
/* AD5 Diagnostics 1.0.1. Read-only dependency report: !ad5doctor. No repairs. */
var AD5Diagnostics=AD5Diagnostics||(function(){
    'use strict';
    function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
    function inventory(){
        return [
            ['NPC Forge',typeof NPCForge!=='undefined'?NPCForge:null],
            ['Initiative',typeof NPCGroupInitiative!=='undefined'?NPCGroupInitiative:null],
            ['AD5',typeof AD5!=='undefined'?AD5:null],
            ['Spell Library',typeof AD5SpellLibrary!=='undefined'?AD5SpellLibrary:null],
            ['Effect Turns',typeof AD5EffectTurns!=='undefined'?AD5EffectTurns:null],
            ['Movement',typeof AD5Movement!=='undefined'?AD5Movement:null],
            ['Concentration',typeof AD5Concentration!=='undefined'?AD5Concentration:null],
            ['Phases',typeof AD5Phases!=='undefined'?AD5Phases:null],
            ['Transform',typeof AD5Transform!=='undefined'?AD5Transform:null],
            ['Sides',typeof AD5Sides!=='undefined'?AD5Sides:null],
            ['Reactions',typeof AD5Reactions!=='undefined'?AD5Reactions:null],
            ['Height',typeof AD5Height!=='undefined'?AD5Height:null],
            ['Environment',typeof AD5Environment!=='undefined'?AD5Environment:null],
            ['Floors',typeof AD5Floors!=='undefined'?AD5Floors:null],
            ['Conditions',typeof AD5ConditionEngine!=='undefined'?AD5ConditionEngine:null],
            ['Events',typeof AD5События!=='undefined'?AD5События:null],
            ['DBM',typeof DBMAccessibility!=='undefined'?DBMAccessibility:null],
            ['Areas',typeof AD5Areas!=='undefined'?AD5Areas:null],
            ['Visibility',typeof AD5Visibility!=='undefined'?AD5Visibility:null]
        ];
    }
    function report(msg){
        if(!msg||msg.type!=='api'||!/^!ad5doctor\s*$/i.test(msg.content||'')||!playerIsGM(msg.playerid))return;
        var rows=inventory(),missing=rows.filter(function(x){return !x[1];}).map(function(x){return x[0];});
        var html='<b>AD5 · диагностика комплекта</b><br>'+rows.map(function(x){return esc(x[0])+': <b>'+(x[1]?esc(x[1].version||x[1].версия||'подключён'):x[0]==='Visibility'?'отключён по выбору мастера':'НЕ НАЙДЕН')+'</b>';}).join('<br>');
        html+='<br>Sandbox: '+esc(Campaign().sandboxVersion||Campaign().get('sandboxversion')||'не указан')+' · Sheet Worker completion: '+(typeof onSheetWorkerCompleted==='function'?'есть':'нет');
        if(missing.indexOf('Areas')>=0)html+='<br><b>Нет AD5 Areas:</b> шаблоны и постоянные области требуют отдельного модуля.';
        if(missing.indexOf('Visibility')>=0)html+='<br>AD5 Visibility отключён по выбору мастера; автоматическая проверка видимости реакций не выполняется.';
        var ts=(msg.selected||[]).map(function(x){return getObj('graphic',x._id);}).filter(Boolean);
        ts.forEach(function(t){var b4;try{b4=t.get('bar4_value');}catch(ignore){}html+='<br>'+esc(t.get('name')||t.id)+': bar4 '+(b4===undefined?'не предоставлен API (используется резерв Environment)':esc(b4));});
        html+='<br>Это проверка наличия модулей, не доказательство исправности боя. Старые обработчики других версий этим отчётом не обнаруживаются.';
        sendChat('AD5 Diagnostics','/w gm '+html,null,{noarchive:true});
    }
    on('chat:message',report);
    return {version:'1.0.1',inventory:inventory};
}());

}
