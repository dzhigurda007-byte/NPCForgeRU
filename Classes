                setAttr(cid,p+'atkflag',x.atk?'{{attack=1}}':'0');setAttr(cid,p+'atkattr_base',x.atk||'0');if(x.atk)setAttr(cid,p+'atkprofflag','(@{pb})');
                setAttr(cid,p+'atkrange',x.range);setAttr(cid,p+'atkcritrange','20');setAttr(cid,p+'dmg2flag','0');setAttr(cid,p+'dmgattr',x.dmgAttr||'0');setAttr(cid,p+'options-flag','0');setAttr(cid,p+'ad5class_key',x.key);
                if(x.save){setAttr(cid,p+'saveflag','{{save=1}} {{saveattr=@{saveattr}}} {{savedesc=@{saveeffect}}} {{savedc=[[[[@{savedc}]][SAVE]]]}}');setAttr(cid,p+'saveattr',x.save.ab);setAttr(cid,p+'savedc',x.save.dc);setAttr(cid,p+'saveeffect','');}
