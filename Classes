            if(/стил/.test(k))k='style';else if(/при[её]м|манев|манёв/.test(k))k='maneuvers';else if(/метамаг/.test(k))k='metamagic';else if(/воззван/.test(k))k='invocations';else if(/предок|дракон/.test(k))k='ancestor';else if(/добыч/.test(k))k='prey';
