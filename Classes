            if(!userDesc&&curDesc!==x.desc){setAttr(cid,p+'atk_desc',x.desc);changed=true;}
            if(!userDmg){
                if(x.dmg){if(curDmg!==x.dmg){setAttr(cid,p+'dmgbase',x.dmg);changed=true;}if(val(cid,p+'dmgflag')!=='{{damage=1}} {{dmg1flag=1}}')setAttr(cid,p+'dmgflag','{{damage=1}} {{dmg1flag=1}}');if(val(cid,p+'dmgtype')!==x.dmgType)setAttr(cid,p+'dmgtype',x.dmgType);}
                else if(fresh)setAttr(cid,p+'dmgflag','0');
            }
            var na=attr(cid,p+'atkname');
            if(changed||!na||String(na.get('current'))!==x.name){if(!na)na=createObj('attribute',{characterid:cid,name:p+'atkname',current:''});if(typeof na.setWithWorker==='function')na.setWithWorker({current:x.name});else na.set('current',x.name);}
            keep[x.key]={row:id,desc:userDesc?m.desc:x.desc,dmg:userDmg?m.dmg:(x.dmg||curDmg)};
        });
        Object.keys(map).forEach(function(k){if(!keep[k]&&map[k].row)removeRow(cid,'repeating_attack_'+map[k].row+'_');});
