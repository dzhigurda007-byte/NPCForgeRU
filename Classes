    }
    // ===== 1.4.0: пассивные бонусы в штатных полях листа =====
    function setW(cid,name,v){var a=attr(cid,name);if(!a)a=createObj('attribute',{characterid:cid,name:name,current:''});if(String(a.get('current'))===String(v))return;if(typeof a.setWithWorker==='function')a.setWithWorker({current:String(v)});else a.set('current',String(v));}
    function modRows(cid,section,prefix,list,stKey,st){
        // section: acmod/savemod/tohitmod/damagemod; поля global_<prefix>_name / _val|_roll|_damage / _active_flag
        var map=(st.mods||{})[stKey]||{},keep={},F={acmod:['global_ac_name','global_ac_val','global_ac_active_flag'],savemod:['global_save_name','global_save_roll','global_save_active_flag'],tohitmod:['global_attack_name','global_attack_roll','global_attack_active_flag'],damagemod:['global_damage_name','global_damage_damage','global_damage_active_flag']}[section];
        list.forEach(function(x){
            var m=map[x.key]||{},id=m.row,fresh=false;if(!id||!attr(cid,'repeating_'+section+'_'+id+'_'+F[0])){id=rowId();fresh=true;}
            var p='repeating_'+section+'_'+id+'_',cur=val(cid,p+F[1]),user=!fresh&&m.val!==undefined&&cur!==m.val;
            if(fresh){setAttr(cid,p+F[0],x.name);setAttr(cid,p+'options-flag','0');setW(cid,p+F[2],'1');if(section==='damagemod')setAttr(cid,p+'global_damage_type',x.name);}
            if(!user&&cur!==x.val)setW(cid,p+F[1],x.val);
            keep[x.key]={row:id,val:user?m.val:x.val};
        });
        Object.keys(map).forEach(function(k){if(!keep[k]&&map[k].row){removeRow(cid,'repeating_'+section+'_'+map[k].row+'_');var t=attr(cid,section==='acmod'?'custom_ac_flag':'pb');if(t&&typeof t.setWithWorker==='function')t.setWithWorker({current:t.get('current')});}});
        st.mods=st.mods||{};st.mods[stKey]=keep;
    }
    function listField(cid,name,mine,prevMine){
        // Поле-список через запятую: наши элементы добавляются/убираются, остальное (вписанное вручную) не трогаем.
        var items=String(val(cid,name)||'').split(/[,;]/).map(function(x){return x.trim();}).filter(Boolean),pn=(prevMine||[]).map(norm);
        items=items.filter(function(x){return pn.indexOf(norm(x))<0;});
        mine.forEach(function(x){if(!items.some(function(y){return norm(y)===norm(x);}))items.push(x);});
        var next=items.join(', ');if(next!==val(cid,name))setAttr(cid,name,next);
    }
    function writePassive(cid,pas,st){
        var ps=st.passive||{},out={},notes=[];
        // Особый КД (Custom AC листа): ставим, только если игрок не настроил его сам.
        var flag=val(cid,'custom_ac_flag'),ours=ps.ac&&flag==='1'&&val(cid,'custom_ac_base')===String(ps.ac.base)&&val(cid,'custom_ac_part1')===ps.ac.p1&&val(cid,'custom_ac_part2')===ps.ac.p2;
        if(pas.ac&&(flag===''||flag==='0'||ours)){setAttr(cid,'custom_ac_base',String(pas.ac.base));setAttr(cid,'custom_ac_part1',pas.ac.p1);setAttr(cid,'custom_ac_part2',pas.ac.p2);setW(cid,'custom_ac_flag','1');out.ac=pas.ac;}
        else if(!pas.ac&&ours){setW(cid,'custom_ac_flag','0');}
        else if(pas.ac){out.ac=null;notes.push(pas.ac.why+': особый КД листа уже настроен вручную — не меняю.');}
        // Скорость: прибавка от классов поверх значения листа.
        var sp=parseInt(val(cid,'speed'),10),was=Number(ps.speed)||0;
        if(Number.isFinite(sp)){if(was!==pas.speed)setAttr(cid,'speed',String(sp-was+pas.speed));out.speed=pas.speed;}else out.speed=was;
        // Владение спасбросками.
        var savesOut={};['strength','dexterity','constitution','intelligence','wisdom','charisma'].forEach(function(ab){var nm=ab+'_save_prof',cur=val(cid,nm);
            if(pas.saves[ab]){if(cur===''||cur==='0'){setW(cid,nm,'(@{pb})');savesOut[ab]=1;}else if(ps.saves&&ps.saves[ab])savesOut[ab]=1;}
            else if(ps.saves&&ps.saves[ab]&&cur==='(@{pb})')setW(cid,nm,'0');});
        out.saves=savesOut;
        if(pas.jack&&val(cid,'jack_of_all_trades')!=='@{jack}'&&!ps.jack){setW(cid,'jack_of_all_trades','@{jack}');}
        if(!pas.jack&&ps.jack&&val(cid,'jack_of_all_trades')==='@{jack}')setW(cid,'jack_of_all_trades','0');out.jack=pas.jack;
        modRows(cid,'acmod','ac',pas.acmods,'ac',st);modRows(cid,'savemod','save',pas.savemods,'save',st);modRows(cid,'tohitmod','attack',pas.tohit,'attack',st);modRows(cid,'damagemod','damage',pas.dmgmods,'damage',st);
        // Сопротивления/иммунитеты — поля, которые AutoDamage читает и у персонажей.
        listField(cid,'npc_resistances',pas.resist,ps.resist);listField(cid,'npc_immunities',pas.immune,ps.immune);listField(cid,'npc_condition_immunities',pas.condImmune,ps.condImmune);
        out.resist=pas.resist;out.immune=pas.immune;out.condImmune=pas.condImmune;
        // Максимум хитов (Драконья устойчивость): прибавка поверх значения листа.
        var hpA=attr(cid,'hp'),hw=Number(ps.hpMax)||0;if(hpA&&hw!==pas.hpMax){var mx=Number(hpA.get('max'))||0,cu=Number(hpA.get('current'))||0;hpA.set({max:String(mx-hw+pas.hpMax),current:String(Math.max(0,cu-hw+pas.hpMax))});}
        out.hpMax=hpA?pas.hpMax:hw;
        st.passive=out;return notes;
    }

    // ===== Синхронизация =====
    function who(cid){var c=getObj('character',cid);return c?String(c.get('name')||''):cid;}
    function whisperTo(cid,html){
        var c=getObj('character',cid),ctl=c?String(c.get('controlledby')||'').split(',').filter(function(x){return x&&x!=='all';}):[];
        ctl.forEach(function(pid){var p=getObj('player',pid);if(p&&!playerIsGM(pid))sendChat(SCRIPT,'/w "'+String(p.get('displayname')||'').replace(/"/g,'')+'" '+html,null,{noarchive:true});});
        gm(html);
    }
    function sync(cid,reason){
        var c=getObj('character',cid);if(!c)return null;
        var r=compute(cid),st=loadState(cid),before={},beforeLv=st.levels||{},firstSync=!st.levels;(Object.keys(st.traits||{})).forEach(function(k){before[k]=1;});
        writeFeatures(cid,r.lines,st);writeTraits(cid,r.traits,st);writeResources(cid,r.resources,st);writeActions(cid,r.actions,st);var pasNotes=writePassive(cid,r.passive,st);r.warnings=r.warnings.concat(pasNotes);
        var levels={};r.classes.forEach(function(x){levels[x.key]=x.level;});st.levels=levels;st.version=VERSION;saveState(cid,st);
        var added=r.traits.filter(function(t){return !before[t.key];}).map(function(t){return t.name;});
        var removed=Object.keys(before).filter(function(k){return !st.traits[k];}).length;
        var cls=r.classes.map(function(x){var sx=x.sub&&SUBS[x.key][x.sub];return CLASSES[x.key].ru+(sx?' ('+sx.ru+(sx.src?', '+sx.src:'')+')':'')+' '+x.level;}).join(' / ')||'класс не распознан';
        var html='<b>'+esc(who(cid))+'</b>: '+esc(cls)+'.'+(added.length?' Новые умения: '+esc(added.join(', '))+'.':'')+(removed?' Убрано умений: '+removed+'.':'')+
            (r.resources.length?' Ресурсы: '+esc(r.resources.map(function(x){return x.name+' '+(x.max>=99?'∞':x.max);}).join(', '))+'.':'')+
            (r.warnings.length?'<br>⚠ '+r.warnings.join('<br>⚠ '):'');
        // Хиты за новые уровни — кнопкой, чтобы игрок выбрал среднее или бросок.
        var hpButtons=[];r.classes.forEach(function(x){var gain=x.level-(Number(beforeLv[x.key])||0);if(!firstSync&&gain>0){
            var id='hp'+(++hpSeq).toString(36)+Date.now().toString(36);pendingHp[id]={cid:cid,die:CLASSES[x.key].hd,count:gain,cls:CLASSES[x.key].ru};
            hpButtons.push(CLASSES[x.key].ru+' +'+gain+': [Среднее](!ad5-class hp '+id+' avg) [Бросок к'+CLASSES[x.key].hd+'](!ad5-class hp '+id+' roll)');}});
        if(hpButtons.length)html+='<br>Хиты за новые уровни: '+hpButtons.join(' · ');
        if(reason!=='silent'&&(added.length||removed||hpButtons.length||r.warnings.length||reason==='manual'))whisperTo(cid,html);
        return r;
    }
    function addHp(id,how,pid){
        var q=pendingHp[id];if(!q){sendChat(SCRIPT,'/w gm Кнопка хитов уже использована.',null,{noarchive:true});return;}
        var c=getObj('character',q.cid);if(!c)return;var ctl=String(c.get('controlledby')||'');
        if(!playerIsGM(pid)&&ctl.split(',').indexOf(pid)<0&&ctl.indexOf('all')<0)return;
        delete pendingHp[id];var con=mod(q.cid,'constitution'),total=0,parts=[];
        for(var i=0;i<q.count;i++){var d=how==='roll'?randomInteger(q.die):Math.floor(q.die/2)+1;var g=Math.max(1,d+con);total+=g;parts.push(g);}
        var a=attr(q.cid,'hp');var mx=(a?Number(a.get('max')):0)||0,cur=(a?Number(a.get('current')):0)||0;setAttr(q.cid,'hp',cur+total,mx+total);
        whisperTo(q.cid,'<b>'+esc(who(q.cid))+'</b>: +'+total+' к максимуму хитов ('+q.cls+', '+(how==='roll'?'бросок':'среднее')+': '+parts.join(' + ')+'). Хиты '+(mx)+' → '+(mx+total)+'.');
    }
    function rest(cid,kind){
        var st=loadState(cid),out=[];Object.keys(st.res||{}).forEach(function(n){var r=st.res[n];if(kind==='short'&&r.rest!=='short')return;var a=attr(cid,r.base);if(!a)return;var mx=a.get('max');if(String(a.get('current'))!==String(mx)){a.set('current',String(mx));out.push(n+' '+mx);}});
        whisperTo(cid,'<b>'+esc(who(cid))+'</b>: '+(kind==='short'?'короткий':'продолжительный')+' отдых — '+(out.length?'восстановлено: '+esc(out.join(', ')):'ресурсы класса уже полные')+'.');
    }
    function targets(msg,arg){
        if(arg&&getObj('character',arg))return [arg];
        return (msg.selected||[]).map(function(s){var g=getObj('graphic',s._id);return g?String(g.get('represents')||''):'';}).filter(Boolean);
    }
    function canEdit(pid,cid){var c=getObj('character',cid);if(!c)return false;if(playerIsGM(pid))return true;var ctl=String(c.get('controlledby')||'').split(',');return ctl.indexOf(pid)>=0||ctl.indexOf('all')>=0;}

    on('chat:message',function(msg){
        if(msg.type!=='api'||!/^!ad5-class\b/i.test(msg.content||''))return;
        try{
            var a=String(msg.content).trim().split(/\s+/),cmd=(a[1]||'').toLowerCase();
            if(cmd==='auto'){if(!playerIsGM(msg.playerid))return;root().auto=(a[2]||'').toLowerCase()!=='off';gm('Автопрокачка: '+(root().auto?'включена':'выключена')+'.');return;}
            if(cmd==='hp'){addHp(a[2],a[3]==='roll'?'roll':'avg',msg.playerid);return;}
            if(cmd==='rest'){var kind=(a[2]||'long').toLowerCase()==='short'?'short':'long';targets(msg,a[3]).forEach(function(cid){if(canEdit(msg.playerid,cid))rest(cid,kind);});return;}
            if(cmd==='sync'||cmd==='show'||!cmd){
                var ids=targets(msg,a[2]);if(!ids.length){sendChat(SCRIPT,'/w "'+String(msg.who||'').replace(/"/g,'').replace(/ \(GM\)$/,'')+'" Выделите токен персонажа или укажите character_id.',null,{noarchive:true});return;}
                ids.forEach(function(cid){if(!canEdit(msg.playerid,cid))return;if(cmd==='show'){var st=loadState(cid);whisperTo(cid,'<b>'+esc(who(cid))+'</b>: умений '+Object.keys(st.traits||{}).length+', ресурсы: '+esc(Object.keys(st.res||{}).join(', ')||'нет')+'.');}else sync(cid,'manual');});
            }
        }catch(e){log(SCRIPT+' '+VERSION+': '+(e.stack||e.message));gm(SCRIPT+': '+esc(e.message));}
    });
    function onAttr(a){
        try{
            if(!root().auto||!a||!WATCH.test(String(a.get('name')||'')))return;
            var cid=String(a.get('characterid')||'');if(!cid)return;
            if(timers[cid])clearTimeout(timers[cid]);
            timers[cid]=setTimeout(function(){delete timers[cid];try{sync(cid,'auto');}catch(e){log(SCRIPT+' '+VERSION+': '+(e.stack||e.message));}},800);
        }catch(e){log(SCRIPT+' '+VERSION+': '+(e.stack||e.message));}
    }
    on('ready',function(){
        root();
        on('change:attribute',onAttr);on('add:attribute',onAttr);
        log(SCRIPT+' '+VERSION+' ready; автопрокачка '+(root().auto?'ВКЛ':'ВЫКЛ')+' (без записей при запуске).');
