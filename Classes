    // ===== Запись в лист =====
    function loadState(cid){try{return JSON.parse(val(cid,'ad5_class_state')||'{}')||{};}catch(e){return {};}}
    function saveState(cid,st){setAttr(cid,'ad5_class_state',JSON.stringify(st));}
    function writeFeatures(cid,lines){
        var cur=val(cid,'ad5_features').replace(/<br\s*\/?>/gi,'\n'),bi=cur.indexOf(BEGIN),ei=cur.indexOf(END);
        var manual=bi>=0?(cur.slice(0,bi)+(ei>bi?cur.slice(ei+END.length):'')):cur;manual=manual.replace(/\n{3,}/g,'\n\n').replace(/^\s+|\s+$/g,'');
        var block=lines.length?BEGIN+'\n'+lines.join('\n')+'\n'+END:'',next=(manual?manual+(block?'\n':''):'')+block;
        if(next!==cur)setAttr(cid,'ad5_features',next);
    }
    function removeRow(cid,prefix){(findObjs({_type:'attribute',_characterid:cid})||[]).forEach(function(a){if(String(a.get('name')||'').indexOf(prefix)===0)a.remove();});}
    function writeTraits(cid,traits,st){
        var map=st.traits||{},keep={};
        traits.forEach(function(t){
            var id=map[t.key];if(!id||!attr(cid,'repeating_traits_'+id+'_name'))id=rowId();
            var p='repeating_traits_'+id+'_';keep[t.key]=id;
            if(val(cid,p+'name')!==t.name)setAttr(cid,p+'name',t.name);
            if(val(cid,p+'description')!==t.desc)setAttr(cid,p+'description',t.desc);
            if(val(cid,p+'source')!=='Class')setAttr(cid,p+'source','Class');
            if(val(cid,p+'source_type')!==t.source)setAttr(cid,p+'source_type',t.source);
            if(!attr(cid,p+'options-flag'))setAttr(cid,p+'options-flag','0');
        });
        Object.keys(map).forEach(function(k){if(!keep[k])removeRow(cid,'repeating_traits_'+map[k]+'_');});
        st.traits=keep;
    }
    function resourceSlots(cid){
        var out={};(findObjs({_type:'attribute',_characterid:cid})||[]).forEach(function(a){var m=/^(class_resource|other_resource|repeating_resource_.+_resource_(?:left|right))_name$/i.exec(String(a.get('name')||''));if(m)out[m[1]]=norm(a.get('current'));});
        return out;
    }
    function writeResources(cid,list,st){
        var managed=st.res||{},slots=resourceSlots(cid),keep={},newRow=null;
        list.forEach(function(r){
            var base=null,want=norm(r.name),fresh=false;
            Object.keys(slots).some(function(s){if(slots[s]===want){base=s;return true;}return false;});
            if(!base){
                fresh=true;
                if(!slots.class_resource)base='class_resource';else if(!slots.other_resource)base='other_resource';
                else{if(!newRow){newRow=rowId();base='repeating_resource_'+newRow+'_resource_left';}else{base='repeating_resource_'+newRow+'_resource_right';newRow=null;}}
                slots[base]=want;setAttr(cid,base+'_name',r.name);
            }
            var a=attr(cid,base),oldMax=a?Number(a.get('max')):NaN,cur=a?Number(a.get('current')):NaN;
            var next=(fresh||!a||String(a.get('current'))===''||!Number.isFinite(cur)||(Number.isFinite(oldMax)&&cur>=oldMax))?r.max:Math.min(cur,r.max);
            if(!a||String(a.get('max'))!==String(r.max)||String(a.get('current'))!==String(next))setAttr(cid,base,next,r.max);
            keep[r.name]={base:base,rest:r.rest};
        });
        Object.keys(managed).forEach(function(n){if(keep[n])return;var b=managed[n].base;if(norm(val(cid,b+'_name'))===norm(n)){setAttr(cid,b+'_name','');setAttr(cid,b,'','');}});
        st.res=keep;
    }

    // ===== Синхронизация =====
    function who(cid){var c=getObj('character',cid);return c?String(c.get('name')||''):cid;}
    function whisperTo(cid,html){
        var c=getObj('character',cid),ctl=c?String(c.get('controlledby')||'').split(',').filter(function(x){return x&&x!=='all';}):[];
        ctl.forEach(function(pid){var p=getObj('player',pid);if(p&&!playerIsGM(pid))sendChat(SCRIPT,'/w "'+String(p.get('displayname')||'').replace(/"/g,'')+'" '+html,null,{noarchive:true});});
        gm(html);
    }
    function sync(cid,reason){
        var c=getObj('character',cid);if(!c)return null;
        var r=compute(cid),st=loadState(cid),before={},beforeLv=st.levels||{},firstSync=!st.levels;(Object.keys(st.traits||{})).forEach(function(k){before[k]=1;});
        writeFeatures(cid,r.lines);writeTraits(cid,r.traits,st);writeResources(cid,r.resources,st);
        var levels={};r.classes.forEach(function(x){levels[x.key]=x.level;});st.levels=levels;st.version=VERSION;saveState(cid,st);
        var added=r.traits.filter(function(t){return !before[t.key];}).map(function(t){return t.name;});
        var removed=Object.keys(before).filter(function(k){return !st.traits[k];}).length;
        var cls=r.classes.map(function(x){return CLASSES[x.key].ru+(x.sub?' ('+SUBS[x.key][x.sub].ru+')':'')+' '+x.level;}).join(' / ')||'класс не распознан';
        var html='<b>'+esc(who(cid))+'</b>: '+esc(cls)+'.'+(added.length?' Новые умения: '+esc(added.join(', '))+'.':'')+(removed?' Убрано умений: '+removed+'.':'')+
            (r.resources.length?' Ресурсы: '+esc(r.resources.map(function(x){return x.name+' '+(x.max>=99?'∞':x.max);}).join(', '))+'.':'')+
            (r.warnings.length?'<br>⚠ '+r.warnings.join('<br>⚠ '):'');
        // Хиты за новые уровни — кнопкой, чтобы игрок выбрал среднее или бросок.
        var hpButtons=[];r.classes.forEach(function(x){var gain=x.level-(Number(beforeLv[x.key])||0);if(!firstSync&&gain>0){
            var id='hp'+(++hpSeq).toString(36)+Date.now().toString(36);pendingHp[id]={cid:cid,die:CLASSES[x.key].hd,count:gain,cls:CLASSES[x.key].ru};
            hpButtons.push(CLASSES[x.key].ru+' +'+gain+': [Среднее](!ad5-class hp '+id+' avg) [Бросок к'+CLASSES[x.key].hd+'](!ad5-class hp '+id+' roll)');}});
        if(hpButtons.length)html+='<br>Хиты за новые уровни: '+hpButtons.join(' · ');
        if(reason!=='silent'&&(added.length||removed||hpButtons.length||r.warnings.length||reason==='manual'))whisperTo(cid,html);
        return r;
    }
    function addHp(id,how,pid){
        var q=pendingHp[id];if(!q){sendChat(SCRIPT,'/w gm Кнопка хитов уже использована.',null,{noarchive:true});return;}
        var c=getObj('character',q.cid);if(!c)return;var ctl=String(c.get('controlledby')||'');
        if(!playerIsGM(pid)&&ctl.split(',').indexOf(pid)<0&&ctl.indexOf('all')<0)return;
        delete pendingHp[id];var con=mod(q.cid,'constitution'),total=0,parts=[];
        for(var i=0;i<q.count;i++){var d=how==='roll'?randomInteger(q.die):Math.floor(q.die/2)+1;var g=Math.max(1,d+con);total+=g;parts.push(g);}
        var a=attr(q.cid,'hp');var mx=(a?Number(a.get('max')):0)||0,cur=(a?Number(a.get('current')):0)||0;setAttr(q.cid,'hp',cur+total,mx+total);
        whisperTo(q.cid,'<b>'+esc(who(q.cid))+'</b>: +'+total+' к максимуму хитов ('+q.cls+', '+(how==='roll'?'бросок':'среднее')+': '+parts.join(' + ')+'). Хиты '+(mx)+' → '+(mx+total)+'.');
    }
    function rest(cid,kind){
        var st=loadState(cid),out=[];Object.keys(st.res||{}).forEach(function(n){var r=st.res[n];if(kind==='short'&&r.rest!=='short')return;var a=attr(cid,r.base);if(!a)return;var mx=a.get('max');if(String(a.get('current'))!==String(mx)){a.set('current',String(mx));out.push(n+' '+mx);}});
        whisperTo(cid,'<b>'+esc(who(cid))+'</b>: '+(kind==='short'?'короткий':'продолжительный')+' отдых — '+(out.length?'восстановлено: '+esc(out.join(', ')):'ресурсы класса уже полные')+'.');
    }
    function targets(msg,arg){
        if(arg&&getObj('character',arg))return [arg];
        return (msg.selected||[]).map(function(s){var g=getObj('graphic',s._id);return g?String(g.get('represents')||''):'';}).filter(Boolean);
    }
    function canEdit(pid,cid){var c=getObj('character',cid);if(!c)return false;if(playerIsGM(pid))return true;var ctl=String(c.get('controlledby')||'').split(',');return ctl.indexOf(pid)>=0||ctl.indexOf('all')>=0;}

    on('chat:message',function(msg){
        if(msg.type!=='api'||!/^!ad5-class\b/i.test(msg.content||''))return;
        try{
            var a=String(msg.content).trim().split(/\s+/),cmd=(a[1]||'').toLowerCase();
            if(cmd==='auto'){if(!playerIsGM(msg.playerid))return;root().auto=(a[2]||'').toLowerCase()!=='off';gm('Автопрокачка: '+(root().auto?'включена':'выключена')+'.');return;}
            if(cmd==='hp'){addHp(a[2],a[3]==='roll'?'roll':'avg',msg.playerid);return;}
            if(cmd==='rest'){var kind=(a[2]||'long').toLowerCase()==='short'?'short':'long';targets(msg,a[3]).forEach(function(cid){if(canEdit(msg.playerid,cid))rest(cid,kind);});return;}
            if(cmd==='sync'||cmd==='show'||!cmd){
                var ids=targets(msg,a[2]);if(!ids.length){sendChat(SCRIPT,'/w "'+String(msg.who||'').replace(/"/g,'').replace(/ \(GM\)$/,'')+'" Выделите токен персонажа или укажите character_id.',null,{noarchive:true});return;}
                ids.forEach(function(cid){if(!canEdit(msg.playerid,cid))return;if(cmd==='show'){var st=loadState(cid);whisperTo(cid,'<b>'+esc(who(cid))+'</b>: умений '+Object.keys(st.traits||{}).length+', ресурсы: '+esc(Object.keys(st.res||{}).join(', ')||'нет')+'.');}else sync(cid,'manual');});
            }
        }catch(e){log(SCRIPT+' '+VERSION+': '+(e.stack||e.message));gm(SCRIPT+': '+esc(e.message));}
    });
    function onAttr(a){
        try{
            if(!root().auto||!a||!WATCH.test(String(a.get('name')||'')))return;
            var cid=String(a.get('characterid')||'');if(!cid)return;
            if(timers[cid])clearTimeout(timers[cid]);
            timers[cid]=setTimeout(function(){delete timers[cid];try{sync(cid,'auto');}catch(e){log(SCRIPT+' '+VERSION+': '+(e.stack||e.message));}},800);
        }catch(e){log(SCRIPT+' '+VERSION+': '+(e.stack||e.message));}
    }
    on('ready',function(){
        root();
        on('change:attribute',onAttr);on('add:attribute',onAttr);
        log(SCRIPT+' '+VERSION+' ready; автопрокачка '+(root().auto?'ВКЛ':'ВЫКЛ')+' (без записей при запуске).');
    });
    return {VERSION:VERSION,sync:sync,compute:compute,rest:rest};
})();
}
